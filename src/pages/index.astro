---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import Footer from '../components/Footer.astro';
import AdUnit from '../components/AdUnit.astro';

const tools = [
  {
    href: '/tools/verschnitt-optimierung',
    title: 'Verschnitt-Optimierung',
    icon: '/images/verschnitt.png',
    description: 'Optimale Aufteilung der Trapezbleche aus Lieferrohlingen – weniger Abfall, weniger Kosten.',
    features: ['Visuelle Darstellung', 'Bestellliste', 'Kostenersparnis'],
  },
  {
    href: '/tools/u-wert',
    title: 'U-Wert Rechner',
    icon: '🌡️',
    description: 'Wärmeschutz-Nachweis nach DIN EN ISO 6946 mit Taupunktanalyse nach Glaser-Verfahren.',
    features: ['DIN EN ISO 6946', 'Glaser-Verfahren', '100+ Baustoffe', 'Druckbarer Nachweis'],
  },
];
---

<BaseLayout
  title="Dachplattenrechner.de – Professionelle Dachplatten-Berechnung"
  description="Trapezblech Rechner kostenlos: Dachfläche berechnen, Schneelastzone nachschlagen, U-Wert berechnen. Für Dachdecker, Architekten & Heimwerker – ohne Registrierung, direkt im Browser."
  keywords="Trapezblech Rechner, Dachplattenrechner, Dachfläche berechnen, Schneelastzone, U-Wert, Trapezbleche, Wellblech, Lichtplatte, Dachdeckerwerkzeug, Anrissplan, Lattenrechner, Verschnitt"
>
  <!-- Hintergrundbild -->
  <div class="hero-bg"></div>

  <!-- Header -->
  <header class="site-header no-print">
    <div class="container">
      <div class="header-inner">
        <h1>Dachplattenrechner<span>.de</span></h1>
        <p class="header-sub">Trapezblech berechnen – kostenlos &amp; direkt im Browser</p>
        <p class="header-desc">
          Dachfläche berechnen, Schnittliste erstellen, Anrissplan drucken.<br />
          Für Dachdecker, Architekten &amp; Heimwerker – ohne Registrierung.
        </p>
      </div>
    </div>
  </header>

  <!-- Werbeanzeige oben -->
  <div class="container">
    <AdUnit position="top" adSlot="9678418506" />
  </div>

  <main class="container main-content">

    <!-- SEO-Content: Intro -->
    <section class="content-intro" style="margin-bottom: 3rem;">
      <div class="intro-text">
        <p>
          Der Dachplattenrechner ist dein digitales Werkzeug für präzise Dachflächenberechnungen.
          Egal ob du als Dachdecker, Architekt oder Heimwerker tätig bist: Mit wenigen Klicks
          ermittelst du den exakten Materialbedarf für dein Dachprojekt — Trapezbleche,
          Sandwichpaneele, Lichtplatten oder Wellblech.
        </p>
        <p>
          Starte mit der Dachflächenberechnung, gib deine Dachform ein (Rechteck, Dreieck, Trapez,
          Kombinationen), und der Rechner erstellt automatisch eine druckbare Schnittliste und
          einen maßstäblichen Anrissplan. Danach brauchst du dich nicht mehr manuell durch
          Formeln zu rechnen — der Lattenrechner, die Verschnitt-Optimierung und der PV-Rechner
          unterstützen dich bei der weiteren Planung.
        </p>
        <p>
          Alle Tools sind kostenlos, browserbasiert, ohne Registrierung. Nutze sie vom Smartphone,
          Tablet oder PC aus. Deine Eingaben werden nicht gespeichert.
        </p>
      </div>
    </section>

    <!-- FAQ-Sektion -->
    <section class="faq-section-intro" style="margin-bottom: 3rem; background: var(--gradient-secondary); padding: 2rem; border-radius: var(--radius-lg);">
      <h2 style="text-align: center; margin-bottom: 2rem;">Häufig gestellte Fragen</h2>

      <details style="margin-bottom: 1.5rem;">
        <summary style="cursor: pointer; font-weight: 600;">Brauche ich einen Dachplattenrechner?</summary>
        <p style="margin-top: 1rem;">Ja, wenn du ein Dachprojekt mit Trapezblechen, Wellblech oder Sandwichpaneelen planst. Er spart dir Zeit bei der Materialkalkulation und reduziert Fehlerquellen. Profis sparen damit Abfallkosten, Heimwerker erhalten Sicherheit bei der Planung.</p>
      </details>

      <details style="margin-bottom: 1.5rem;">
        <summary style="cursor: pointer; font-weight: 600;">Welche Dachform habe ich?</summary>
        <p style="margin-top: 1rem;">Das wichtigste ist zunächst: Ist dein Dach ein Rechteck (Sattel-, Pultdach), ein Dreieck oder eine Mischform (Trapez)? Der Dachflächenrechner unterscheidet diese Formen visuell. Miss dann die Grundkanten (Breite, Länge) und die Höhe (First zum Trauf) oder den Neigungswinkel.</p>
      </details>

      <details style="margin-bottom: 1.5rem;">
        <summary style="cursor: pointer; font-weight: 600;">Wie genau sind die Berechnungen?</summary>
        <p style="margin-top: 1rem;">Der Rechner nutzt klassische geometrische Formeln. Für Rechteck z.B. Breite × Länge, für Dreiecke (Breite × Höhe) / 2. Die Genauigkeit hängt von deinen Eingaben ab — je genauer du misst, desto genauer das Ergebnis.</p>
      </details>

      <details style="margin-bottom: 1.5rem;">
        <summary style="cursor: pointer; font-weight: 600;">Was ist Schneelastzone und warum ist sie wichtig?</summary>
        <p style="margin-top: 1rem;">Die Schneelastzone bestimmt die Tragfähigkeit deiner Dachkonstruktion. Deutschland ist in Zonen 1–3 eingeteilt (DIN EN 1991-1-3). Je höher die Zone, desto mehr Schnee kann dein Dach tragen. Bergregionen haben höhere Zonen als flaches Land. Mit dem Schneelastzone-Tool findest du deine Zone per Postleitzahl oder Bundesland.</p>
      </details>

      <details style="margin-bottom: 1.5rem;">
        <summary style="cursor: pointer; font-weight: 600;">Kostet das etwas?</summary>
        <p style="margin-top: 1rem;">Nein, alle Tools sind kostenlos. Die Seite finanziert sich durch dezente Werbung (Google AdSense).</p>
      </details>

      <details style="margin-bottom: 1.5rem;">
        <summary style="cursor: pointer; font-weight: 600;">Kann ich die Ergebnisse drucken?</summary>
        <p style="margin-top: 1rem;">Ja. Der Dachflächenrechner erstellt einen druckbaren Anrissplan mit Maßstab. Andere Tools wie der Lattenrechner und U-Wert-Rechner haben ebenfalls Druck-Funktionen.</p>
      </details>

      <details style="margin-bottom: 1.5rem;">
        <summary style="cursor: pointer; font-weight: 600;">Was ist ein Anrissplan?</summary>
        <p style="margin-top: 1rem;">Ein maßstäblicher Plan, auf dem die Dachflächen mit ihren Abmessungen eingezeichnet sind. Er hilft dir (und Handwerkern) zu visualisieren, wie die Bleche angeordnet werden.</p>
      </details>

      <details style="margin-bottom: 1.5rem;">
        <summary style="cursor: pointer; font-weight: 600;">Brauche ich meine Dachmaße für alle Tools?</summary>
        <p style="margin-top: 1rem;">Nein. Einige Tools wie der Schneelastzone-Rechner, U-Wert-Rechner und Farbkatalog benötigen keine Dachmaße. Andere wie Lattenrechner und PV-Rechner setzen auf deine Eingaben aus der Dachflächenberechnung auf — aber du kannst sie auch nutzen, wenn du die Werte manuell eingibst.</p>
      </details>
    </section>

    <!-- Kachel-Grid -->
    <section aria-label="Alle Rechner">
      <h2 class="section-title" style="text-align:center; margin-bottom:2rem">
        Alle <span>Rechner</span>
      </h2>

      <!-- Hero: Dachflächenberechnung -->
      <a href="/tools/dachformen" class="dach-hero">
        <div class="dach-hero-left">
          <div class="dach-hero-tag">Einstieg</div>
          <img src="/images/gleichschenkliges-dreieck.png" alt="Dachflächenberechnung" class="dach-hero-img" loading="eager" />
          <h2 class="dach-hero-title">Dachflächen&shy;berechnung</h2>
          <p class="dach-hero-desc">
            Präzise Dachflächen für alle Dachformen berechnen – Grundlage für Materialbedarf,
            Lattenplan und Solarplanung. Schnittliste und maßstäblicher Anrissplan auf Knopfdruck.
          </p>
          <ul class="dach-hero-features">
            <li>Rechteck &amp; Quadrat</li>
            <li>Gleichsch. &amp; ungleichsch. Dreieck</li>
            <li>Trapez &amp; Trapez auf Rechteck</li>
            <li>Schnittliste &amp; Anrissplan druckbereit</li>
          </ul>
          <span class="dach-hero-cta">Dachfläche berechnen →</span>
        </div>

        <div class="dach-hero-right">
          <div class="dach-next-label">Danach direkt weiter mit:</div>

          <div class="dach-next-item">
            <span class="dach-next-icon">🔨</span>
            <div class="dach-next-body">
              <strong>Lattenrechner</strong>
              <span>Latten- &amp; Konterlattung mit kompletter Schnittliste und druckbarem Verlegeplan</span>
            </div>
          </div>

          <div class="dach-next-item">
            <span class="dach-next-icon">✂️</span>
            <div class="dach-next-body">
              <strong>Verschnitt-Optimierung</strong>
              <span>Trapezbleche optimal aus Lieferrohlingen aufteilen – Abfall und Bestellmenge minimieren</span>
            </div>
          </div>

          <div class="dach-next-item">
            <span class="dach-next-icon">☀️</span>
            <div class="dach-next-body">
              <strong>PV-Rechner</strong>
              <span>Solarmodule planen, kWp &amp; Jahresertrag berechnen – mit Batteriespeicher-Option</span>
            </div>
          </div>
        </div>
      </a>

      <!-- Weitere Rechner -->
      <div class="tools-grid" style="margin-top:20px;">
        {tools.map(t => <CalculatorCard {...t} />)}
      </div>
    </section>

    <!-- Weitere Tools -->
    <section aria-label="Weitere Tools" style="margin-bottom: 48px;">
      <h2 class="section-title" style="text-align:center; margin-bottom:2rem">
        Weitere <span>Tools</span>
      </h2>
      <div class="extra-tools-grid">
        <a href="/tools/farben/" class="guide-card">
          <img src="/images/farben.png" alt="Farbkatalog" class="guide-img" />
          <div class="guide-body">
            <h3>Farbkatalog</h3>
            <p>RAL-Farbtöne für Trapezbleche und Sandwichpaneele mit visueller Farbvorschau und Bestellangaben.</p>
            <ul>
              <li>RAL-Farbtöne</li>
              <li>Visuelle Vorschau</li>
              <li>Bestellangaben</li>
            </ul>
            <span class="guide-cta">Farben ansehen →</span>
          </div>
        </a>
        <a href="/tools/karte/" class="guide-card">
          <img src="/images/Schneelast.png" alt="Schnee- und Windlastzonen" class="guide-img" />
          <div class="guide-body">
            <h3>Schnee- &amp; Windlastzonen</h3>
            <p>Schneelastzone und Windzone für Ihren Landkreis nachschlagen – nach DIN EN 1991-1-3 und DIN EN 1991-1-4.</p>
            <ul>
              <li>Alle Bundesländer</li>
              <li>Schneelastzonen 1–3</li>
              <li>Windzonen 1–4</li>
            </ul>
            <span class="guide-cta">Zone nachschlagen →</span>
          </div>
        </a>
        <a href="/tools/kantteil/" class="guide-card">
          <img src="/images/klemmbrett.png" alt="Kantteil-Zeichner" class="guide-img" />
          <div class="guide-body">
            <h3>Kantteil-Zeichner</h3>
            <p>Blechkantteile planen und zeichnen – Firstbleche, Ortgangbleche, Wandanschlüsse und individuelle Kantprofile.</p>
            <ul>
              <li>Firstbleche &amp; Ortgangbleche</li>
              <li>Individuelle Kantprofile</li>
              <li>Blechstärke &amp; Farbe wählbar</li>
            </ul>
            <span class="guide-cta">Kantteil zeichnen →</span>
          </div>
        </a>
      </div>
    </section>

    <!-- Ratgeber -->
    <section aria-label="Ratgeber" style="margin-bottom: 48px;">
      <h2 class="section-title" style="text-align:center; margin-bottom:2rem">
        <span>Ratgeber</span>
      </h2>
      <a href="/projekt-dach/" class="guide-card">
        <img src="/images/plan-2.jpg" alt="Projekt Dach" class="guide-img" />
        <div class="guide-body">
          <h3>Projekt Dach</h3>
          <p>An alles gedacht? Statik, Materialwahl, Unterkonstruktion, Blechverlegung und Winkelprofile – der komplette Guide in 5 Kapiteln.</p>
          <ul>
            <li>Statik &amp; Schneelast</li>
            <li>Materialwahl &amp; Unterbau</li>
            <li>Blechverlegung</li>
            <li>Winkelprofile &amp; Abschlüsse</li>
          </ul>
          <span class="guide-cta">Guide lesen →</span>
        </div>
      </a>
    </section>

    <AdUnit position="middle" adSlot="8291579285" adSlot2="5573713344" adSlot3="4283946313" />

    <!-- Wie funktioniert es? -->
    <section class="info-section" aria-label="Anleitung">
      <h2 class="section-title"><span>Wie</span> funktioniert es?</h2>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>Rechner wählen</h3>
          <p>Wählen Sie den passenden Rechner für Ihre Dachform – Dreieck, Trapez, Walm oder Rechteck.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h3>Maße eingeben</h3>
          <p>Geben Sie Länge, Breite, Höhe und die Deckbreite Ihrer Trapezbleche ein.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h3>Schnittliste erhalten</h3>
          <p>Sofort erhalten Sie eine vollständige Schnittliste mit allen benötigten Längen und Stückzahlen.</p>
        </div>
        <div class="step-card">
          <div class="step-num">4</div>
          <h3>Anrissplan drucken</h3>
          <p>Drucken Sie den maßstäblichen Anrissplan – fertig für die Baustelle oder den Kunden.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section" aria-label="Häufige Fragen">
      <h2 class="section-title"><span>Häufige</span> Fragen</h2>
      <div class="faq-grid">
        <details class="faq-item">
          <summary>Was ist der Unterschied zwischen Deckbreite und Lieferbreite?</summary>
          <div class="faq-body">
            <p>Die <strong>Deckbreite</strong> ist die nutzbare Breite des Trapezbleches nach dem Verlegen (meist 1,00&thinsp;m). Die <strong>Lieferbreite</strong> ist die tatsächliche Gesamtbreite des Bleches (meist 1,06&thinsp;m). Die Differenz ergibt die Überlappung.</p>
            <p>Im Rechner immer die <strong>Deckbreite</strong> eingeben – die Überlappung wird automatisch berücksichtigt.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Sind die Berechnungen für gewerbliche Nutzung erlaubt?</summary>
          <div class="faq-body">
            <p>Ja. Dachdecker, Architekten und Handwerker dürfen die Ergebnisse und Anrisspläne kostenfrei an Kunden weitergeben, solange Wasserzeichen und Quellenangaben erhalten bleiben.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Wie genau sind die Berechnungen?</summary>
          <div class="faq-body">
            <p>Die Berechnungen basieren auf geometrisch-mathematischen Grundlagen und sind sehr präzise. Dennoch sollten alle Ergebnisse vor der Ausführung von einer Fachkraft geprüft und auf der Baustelle nachgemessen werden.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Funktioniert der Rechner auf dem Smartphone?</summary>
          <div class="faq-body">
            <p>Ja, alle Rechner sind vollständig responsiv und für mobile Geräte optimiert. Die Anrisspläne sind für DIN A4 optimiert und lassen sich direkt aus dem Browser drucken.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Werden meine Daten gespeichert?</summary>
          <div class="faq-body">
            <p>Nein. Alle Berechnungen laufen lokal in Ihrem Browser. Es werden keine Projektdaten an einen Server gesendet. Nur anonyme Nutzungsstatistiken werden erfasst, sofern Sie dem zugestimmt haben.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Was ist der U-Wert Rechner?</summary>
          <div class="faq-body">
            <p>Der U-Wert Rechner berechnet den Wärmedurchgangskoeffizienten nach DIN EN ISO 6946 und analysiert Taupunkt und Kondensatrisiko nach dem Glaser-Verfahren (DIN 4108-3). Er eignet sich für Wände, Dächer und Böden.</p>
          </div>
        </details>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .hero-bg {
    position: fixed;
    inset: 0;
    background: #0f172a url('/images/index.png') center top / cover no-repeat;
    z-index: -1;
    opacity: 0.62;
  }

  /* ── Header ── */
  .site-header {
    padding: 64px 0 44px;
    text-align: center;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.92) 0%, transparent 100%);
  }
  .header-inner { max-width: 680px; margin: 0 auto; }
  .site-header h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    color: #f8fafc;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 12px;
    line-height: 1.1;
  }
  .site-header h1 span { color: #0ea5e9; }
  .header-sub {
    font-size: 1rem;
    color: #93c5fd;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 10px;
  }
  .header-desc { font-size: 0.88rem; color: #94a3b8; max-width: 480px; margin: 0 auto; line-height: 1.6; }

  /* ── Main ── */
  .main-content { padding-bottom: 80px; }

  /* ── Kachel-Grid ── */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 48px;
  }

  /* ── Dachflächen-Hero-Kachel ── */
  .dach-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: linear-gradient(135deg, rgba(14, 30, 60, 0.97) 0%, rgba(6, 15, 35, 0.99) 100%);
    border: 1px solid rgba(14, 165, 233, 0.30);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
    position: relative;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  }
  .dach-hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, #0ea5e9, #06b6d4, #10b981);
  }
  .dach-hero:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    border-color: rgba(14, 165, 233, 0.55);
  }

  .dach-hero-left {
    padding: 36px 32px 36px 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-right: 1px solid rgba(148, 163, 184, 0.12);
  }
  .dach-hero-tag {
    display: inline-block;
    background: linear-gradient(135deg, #0ea5e9, #06b6d4);
    color: white;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    width: fit-content;
  }
  .dach-hero-img {
    height: 80px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(14, 165, 233, 0.4));
  }
  .dach-hero-title {
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    font-weight: 800;
    color: #f8fafc;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.15;
    margin: 0;
  }
  .dach-hero-desc {
    color: #94a3b8;
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0;
  }
  .dach-hero-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .dach-hero-features li {
    font-size: 0.82rem;
    color: #64748b;
    padding-left: 20px;
    position: relative;
    line-height: 1.4;
  }
  .dach-hero-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #10b981;
    font-weight: 700;
  }
  .dach-hero-cta {
    display: inline-block;
    background: linear-gradient(135deg, #0ea5e9, #06b6d4);
    color: white;
    padding: 13px 28px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: auto;
    transition: filter 0.2s;
    width: fit-content;
  }
  .dach-hero:hover .dach-hero-cta { filter: brightness(1.15); }

  .dach-hero-right {
    padding: 36px 36px 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 0;
    justify-content: center;
  }
  .dach-next-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #475569;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 20px;
  }
  .dach-next-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 16px 0;
    border-bottom: 1px solid rgba(148, 163, 184, 0.10);
  }
  .dach-next-item:last-child { border-bottom: none; }
  .dach-next-icon {
    font-size: 1.6rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .dach-next-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .dach-next-body strong {
    color: #e2e8f0;
    font-size: 0.95rem;
    font-weight: 700;
  }
  .dach-next-body span {
    color: #64748b;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  @media (max-width: 740px) {
    .dach-hero { grid-template-columns: 1fr; }
    .dach-hero-left { border-right: none; border-bottom: 1px solid rgba(148,163,184,0.12); padding: 28px 24px; }
    .dach-hero-right { padding: 24px; }
  }

  /* ── Schritte ── */
  .info-section { margin: 64px 0; }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }
  .step-card {
