---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import Footer from '../components/Footer.astro';
import AdUnit from '../components/AdUnit.astro';

const tools = [
  {
    href: '/tools/verschnitt-optimierung',
    title: 'Verschnitt-Optimierung',
    icon: '/images/verschnitt.png',
    description: 'Optimale Aufteilung der Trapezbleche aus Lieferrohlingen – weniger Abfall, weniger Kosten.',
    features: ['Visuelle Darstellung', 'Bestellliste', 'Kostenersparnis'],
  },
  {
    href: '/tools/u-wert',
    title: 'U-Wert Rechner',
    icon: '🌡️',
    description: 'Wärmeschutz-Nachweis nach DIN EN ISO 6946 mit Taupunktanalyse nach Glaser-Verfahren.',
    features: ['DIN EN ISO 6946', 'Glaser-Verfahren', '100+ Baustoffe', 'Druckbarer Nachweis'],
  },
];
---

<BaseLayout
  title="Dachplattenrechner.de – Professionelle Dachplatten-Berechnung"
  description="Trapezblech Rechner kostenlos: Dachfläche berechnen, Schneelastzone nachschlagen, U-Wert berechnen. Für Dachdecker, Architekten & Heimwerker – ohne Registrierung, direkt im Browser."
  keywords="Trapezblech Rechner, Dachplattenrechner, Dachfläche berechnen, Schneelastzone, U-Wert, Trapezbleche, Wellblech, Lichtplatte, Dachdeckerwerkzeug, Anrissplan, Lattenrechner, Verschnitt"
>
  <!-- Hero -->
  <section class="hero no-print">
    <div class="container">
      <div style="animation: fadeIn 0.6s ease-out;">
        <div style="display: inline-block; padding: 8px 16px; background: rgba(14, 165, 233, 0.1); border: 1px solid rgba(14, 165, 233, 0.3); border-radius: 24px; margin-bottom: 24px;">
          <p style="font-size: 0.875rem; font-weight: 500; color: #38bdf8; margin: 0;">🏗️ Für Handwerk & Planung</p>
        </div>

        <h1>
          Dachplatten<span style="color: #0ea5e9;">rechner</span>
        </h1>

        <p style="font-size: 1.125rem; color: #cbd5e1; margin: 24px 0; max-width: 600px; margin-left: auto; margin-right: auto;">
          Präzise Berechnungen für dein Dachprojekt
        </p>

        <p style="font-size: 0.95rem; color: #94a3b8; max-width: 700px; margin: 0 auto 40px; line-height: 1.7;">
          Kostenlos & browserbasiert: Dachflächen berechnen, Schnittlisten erstellen,
          Materialkosten optimieren – ohne Registrierung, lokal in deinem Browser.
        </p>

        <div style="display: flex; flex-wrap: wrap; gap: 16px; justify-content: center;">
          <a href="/tools/dachformen" class="btn btn-primary">
            Dachfläche berechnen →
          </a>
          <a href="#wie-funktioniert" class="btn btn-secondary">
            Anleitung anschauen
          </a>
        </div>
      </div>
    </div>
  </section>

  <main>
    <!-- Ad -->
    <div class="container">
      <AdUnit position="top" adSlot="9678418506" />
    </div>

    <!-- Intro -->
    <section>
      <div class="container" style="max-width: 800px; background: linear-gradient(135deg, rgba(30, 41, 59, 0.5), rgba(15, 23, 42, 0.6)); border: 1px solid rgba(14, 165, 233, 0.2); border-radius: 16px; padding: 40px; margin-top: -40px;">
        <div style="color: #cbd5e1; line-height: 1.8; font-size: 0.95rem;">
          <p style="margin-bottom: 16px;">
            Der Dachplattenrechner ist dein digitales Werkzeug für präzise Dachflächenberechnungen.
            Egal ob Dachdecker, Architekt, Handwerker oder Heimwerker: Mit wenigen Klicks ermittelst du
            den exakten Materialbedarf für dein Dachprojekt — Trapezbleche, Sandwichpaneele, Lichtplatten oder Wellblech.
          </p>
          <p style="margin-bottom: 16px;">
            Profis sparen damit durchschnittlich 1–2 Stunden Rechenzeit pro Projekt, vermeiden Kalkulationsfehler
            und können Kunden präzise Materialbudgets vorrechnen. Heimwerker profitieren von sicheren, fehlerfreien
            Kalkulationen, die teure Materialverschwendung durch Planungsfehler verhindern.
          </p>
        </div>
      </div>
    </section>

    <!-- Dachflächen Hero -->
    <section>
      <div class="container">
        <a href="/tools/dachformen" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0; background: linear-gradient(to right, rgba(30, 41, 59, 0.97), rgba(15, 23, 42, 0.99)); border: 1px solid rgba(14, 165, 233, 0.3); border-radius: 20px; overflow: hidden; text-decoration: none; color: inherit; transition: all 0.3s ease; position: relative;" class="no-underline">
          <div style="display: flex; flex-direction: column; gap: 16px; padding: 40px; border-right: 1px solid rgba(148, 163, 184, 0.12);">
            <div style="display: inline-block; padding: 6px 12px; background: linear-gradient(135deg, #0ea5e9, #06b6d4); color: white; font-size: 0.65rem; font-weight: 700; border-radius: 20px; text-transform: uppercase; width: fit-content;">
              Einstieg
            </div>
            <img src="/images/gleichschenkliges-dreieck.png" alt="Dachflächenberechnung" style="height: 80px; width: auto; max-width: 120px; object-fit: contain; align-self: flex-start;" />
            <div>
              <h2 style="font-size: 1.5rem; margin-bottom: 12px;">Dachflächen<br/>berechnung</h2>
              <p style="color: #94a3b8;">Präzise Dachflächen für alle Dachformen – Schnittliste und Anrissplan auf Knopfdruck.</p>
            </div>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; color: #cbd5e1; font-size: 0.85rem;">
              <li style="padding-left: 20px; position: relative;"><span style="position: absolute; left: 0; color: #0ea5e9; font-weight: bold;">✓</span> Rechteck & Quadrat</li>
              <li style="padding-left: 20px; position: relative;"><span style="position: absolute; left: 0; color: #0ea5e9; font-weight: bold;">✓</span> Dreieck (symmetrisch & asymmetrisch)</li>
              <li style="padding-left: 20px; position: relative;"><span style="position: absolute; left: 0; color: #0ea5e9; font-weight: bold;">✓</span> Trapez & Kombinationen</li>
              <li style="padding-left: 20px; position: relative;"><span style="position: absolute; left: 0; color: #0ea5e9; font-weight: bold;">✓</span> Schnittliste & Anrissplan</li>
            </ul>
          </div>
          <div style="padding: 40px; display: flex; flex-direction: column; justify-content: center;">
            <p style="font-size: 0.75rem; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 24px;">Danach direkt weiter mit:</p>
            <div style="display: flex; flex-direction: column; gap: 16px;">
              <a href="/tools/lattenrechner" style="display: flex; gap: 12px; padding: 12px; border-radius: 8px; text-decoration: none; color: inherit; transition: background 0.2s; hover:" onmouseover="this.style.background = 'rgba(14, 165, 233, 0.05)'" onmouseout="this.style.background = 'transparent'">
                <span style="font-size: 1.5rem;">🔨</span>
                <div>
                  <div style="font-weight: bold; color: white;">Lattenrechner</div>
                  <div style="font-size: 0.8rem; color: #94a3b8;">Latten- & Konterlattung mit Schnittliste</div>
                </div>
              </a>
              <a href="/tools/verschnitt-optimierung" style="display: flex; gap: 12px; padding: 12px; border-radius: 8px; text-decoration: none; color: inherit; transition: background 0.2s;" onmouseover="this.style.background = 'rgba(14, 165, 233, 0.05)'" onmouseout="this.style.background = 'transparent'">
                <span style="font-size: 1.5rem;">✂️</span>
                <div>
                  <div style="font-weight: bold; color: white;">Verschnitt-Optimierung</div>
                  <div style="font-size: 0.8rem; color: #94a3b8;">Trapezbleche optimal aufteilen</div>
                </div>
              </a>
              <a href="/tools/pv-rechner" style="display: flex; gap: 12px; padding: 12px; border-radius: 8px; text-decoration: none; color: inherit; transition: background 0.2s;" onmouseover="this.style.background = 'rgba(14, 165, 233, 0.05)'" onmouseout="this.style.background = 'transparent'">
                <span style="font-size: 1.5rem;">☀️</span>
                <div>
                  <div style="font-weight: bold; color: white;">PV-Rechner</div>
                  <div style="font-size: 0.8rem; color: #94a3b8;">Solarmodule planen & Jahresertrag berechnen</div>
                </div>
              </a>
            </div>
          </div>
        </a>
      </div>
    </section>

    <!-- Tools Grid -->
    <section>
      <div class="container">
        <h2>Alle <span class="accent">Rechner</span></h2>
        <div class="tools-grid">
          {tools.map(t => <CalculatorCard {...t} />)}
        </div>
      </div>
    </section>

    <!-- Extra Tools -->
    <section>
      <div class="container">
        <h2>Weitere <span class="accent">Tools</span></h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
          <a href="/tools/farben/" class="card" style="text-decoration: none;">
            <img src="/images/farben.png" alt="Farbkatalog" style="width: 100%; height: 160px; object-fit: cover; margin: -32px -24px 16px; border-radius: 0;" />
            <h3 style="font-size: 1.2rem;">Farbkatalog</h3>
            <p>RAL-Farbtöne für Trapezbleche mit visueller Vorschau.</p>
            <div class="card-cta">Farben ansehen →</div>
          </a>
          <a href="/tools/karte/" class="card" style="text-decoration: none;">
            <img src="/images/Schneelast.png" alt="Schnee- und Windlastzonen" style="width: 100%; height: 160px; object-fit: cover; margin: -32px -24px 16px; border-radius: 0;" />
            <h3 style="font-size: 1.2rem;">Schnee- & Windlastzonen</h3>
            <p>Schneelastzone und Windzone für Ihren Landkreis nachschlagen.</p>
            <div class="card-cta">Zone nachschlagen →</div>
          </a>
          <a href="/tools/kantteil/" class="card" style="text-decoration: none;">
            <img src="/images/klemmbrett.png" alt="Kantteil-Zeichner" style="width: 100%; height: 160px; object-fit: cover; margin: -32px -24px 16px; border-radius: 0;" />
            <h3 style="font-size: 1.2rem;">Kantteil-Zeichner</h3>
            <p>Blechkantteile planen und zeichnen – Firstbleche, Ortgangbleche.</p>
            <div class="card-cta">Kantteil zeichnen →</div>
          </a>
        </div>
      </div>
    </section>

    <!-- How it Works -->
    <section id="wie-funktioniert">
      <div class="container">
        <h2><span class="accent">Wie</span> funktioniert es?</h2>
        <div class="steps-grid">
          <div class="step-card">
            <div class="step-num">1</div>
            <h3>Rechner wählen</h3>
            <p>Wählen Sie den passenden Rechner für Ihre Dachform.</p>
          </div>
          <div class="step-card">
            <div class="step-num">2</div>
            <h3>Maße eingeben</h3>
            <p>Geben Sie Länge, Breite, Höhe und Deckbreite ein.</p>
          </div>
          <div class="step-card">
            <div class="step-num">3</div>
            <h3>Schnittliste erhalten</h3>
            <p>Sofort erhalten Sie eine vollständige Schnittliste.</p>
          </div>
          <div class="step-card">
            <div class="step-num">4</div>
            <h3>Anrissplan drucken</h3>
            <p>Drucken Sie den maßstäblichen Anrissplan.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Ad -->
    <div class="container">
      <AdUnit position="middle" adSlot="8291579285" adSlot2="5573713344" adSlot3="4283946313" />
    </div>

    <!-- FAQ -->
    <section>
      <div class="container" style="max-width: 800px;">
        <h2><span class="accent">Häufig</span> gestellte Fragen</h2>
        <div class="faq-grid">
          <details>
            <summary>Was ist der Unterschied zwischen Deckbreite und Lieferbreite?</summary>
            <p>Die Deckbreite ist die nutzbare Breite des Trapezbleches nach dem Verlegen (meist 1,00 m). Die Lieferbreite ist die tatsächliche Gesamtbreite (meist 1,06 m). Im Rechner immer die Deckbreite eingeben.</p>
          </details>
          <details>
            <summary>Sind die Berechnungen für gewerbliche Nutzung erlaubt?</summary>
            <p>Ja. Dachdecker, Architekten und Handwerker dürfen die Ergebnisse und Anrisspläne kostenfrei an Kunden weitergeben, solange Wasserzeichen und Quellenangaben erhalten bleiben.</p>
          </details>
          <details>
            <summary>Wie genau sind die Berechnungen?</summary>
            <p>Die Berechnungen basieren auf geometrisch-mathematischen Grundlagen und sind sehr präzise. Dennoch sollten alle Ergebnisse vor der Ausführung von einer Fachkraft geprüft werden.</p>
          </details>
          <details>
            <summary>Funktioniert der Rechner auf dem Smartphone?</summary>
            <p>Ja, alle Rechner sind vollständig responsiv und für mobile Geräte optimiert. Die Anrisspläne sind für DIN A4 optimiert und lassen sich direkt aus dem Browser drucken.</p>
          </details>
          <details>
            <summary>Werden meine Daten gespeichert?</summary>
            <p>Nein. Alle Berechnungen laufen lokal in Ihrem Browser. Es werden keine Projektdaten an einen Server gesendet. Nur anonyme Nutzungsstatistiken werden erfasst.</p>
          </details>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>