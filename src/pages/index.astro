---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorCard from '../components/CalculatorCard.astro';
import Footer from '../components/Footer.astro';
import AdUnit from '../components/AdUnit.astro';

const tools = [
  {
    href: '/tools/dachformen',
    title: 'Dachflächenberechnung',
    icon: '/images/gleichschenkliges-dreieck.png',
    description: 'Berechnen Sie präzise Ihre Dachflächen für verschiedene geometrische Formen.',
    features: ['Rechteck / Quadrat', 'Gleichschenkliges Dreieck', 'Ungleichschenkliges Dreieck', 'Trapez', 'Trapez auf Rechteck'],
  },
  {
    href: '/tools/verschnitt-optimierung',
    title: 'Verschnitt-Optimierung',
    icon: '/images/verschnitt.png',
    description: 'Optimale Aufteilung der Trapezbleche aus Lieferrohlingen – weniger Abfall, weniger Kosten.',
    features: ['Visuelle Darstellung', 'Bestellliste', 'Kostenersparnis'],
  },
  {
    href: '/tools/u-wert',
    title: 'U-Wert Rechner',
    icon: '🌡️',
    description: 'Wärmeschutz-Nachweis nach DIN EN ISO 6946 mit Taupunktanalyse nach Glaser-Verfahren.',
    features: ['DIN EN ISO 6946', 'Glaser-Verfahren', '100+ Baustoffe', 'Druckbarer Nachweis'],
    badge: 'NEU',
  },
  {
    href: '/tools/farben',
    title: 'Farbkatalog',
    icon: '/images/farben.png',
    description: 'RAL-Farbtöne für Trapezbleche und Sandwichpaneele mit visueller Farbvorschau.',
    features: ['RAL-Farbtöne', 'Visuelle Vorschau', 'Bestellangaben'],
  },
  {
    href: '/tools/kantteil',
    title: 'Kantteil-Zeichner',
    icon: '/images/klemmbrett.png',
    description: 'Blechkantteile planen und zeichnen – Firstbleche, Ortgangbleche, Wandanschlüsse und individuelle Kantprofile.',
    features: ['Firstbleche & Ortgangbleche', 'Individuelle Kantprofile', 'Blechstärke & Farbe wählbar'],
  },
];
---

<BaseLayout
  title="Dachplattenrechner.de"
  description="Kostenlose Berechnungstools für Trapezbleche, Dachplatten und Wärmeschutz. Anrisspläne, Schnittlisten und U-Wert-Nachweis – direkt im Browser."
>
  <!-- Hintergrundbild -->
  <div class="hero-bg"></div>

  <!-- Header -->
  <header class="site-header no-print">
    <div class="container">
      <div class="header-inner">
        <h1>Dachplattenrechner<span>.de</span></h1>
        <p class="header-sub">Professionelle Berechnungstools für Trapezbleche &amp; Dachplatten</p>
        <p class="header-desc">
          Kostenlos &amp; ohne Registrierung – für Dachdecker, Architekten und Heimwerker.
          Alle Berechnungen laufen lokal in Ihrem Browser.
        </p>
      </div>
    </div>
  </header>

  <!-- Werbeanzeige oben -->
  <div class="container">
    <AdUnit position="top" adSlot="9678418506" />
  </div>

  <main class="container main-content">

    <!-- Kachel-Grid -->
    <section aria-label="Alle Rechner">
      <h2 class="section-title" style="text-align:center; margin-bottom:2rem">
        Alle <span>Rechner</span>
      </h2>
      <div class="tools-grid">
        {tools.map(t => <CalculatorCard {...t} />)}
      </div>
    </section>

    <!-- Ratgeber -->
    <section aria-label="Ratgeber" style="margin-bottom: 48px;">
      <h2 class="section-title" style="text-align:center; margin-bottom:2rem">
        <span>Ratgeber</span>
      </h2>
      <a href="/projekt-dach/" class="guide-card">
        <img src="/images/plan-2.jpg" alt="Projekt Dach" class="guide-img" />
        <div class="guide-body">
          <h3>Projekt Dach</h3>
          <p>An alles gedacht? Statik, Materialwahl, Unterkonstruktion, Blechverlegung und Winkelprofile – der komplette Guide in 5 Kapiteln.</p>
          <ul>
            <li>Statik &amp; Schneelast</li>
            <li>Materialwahl &amp; Unterbau</li>
            <li>Blechverlegung</li>
            <li>Winkelprofile &amp; Abschlüsse</li>
          </ul>
          <span class="guide-cta">Guide lesen →</span>
        </div>
      </a>
    </section>

    <AdUnit position="middle" />

    <!-- Wie funktioniert es? -->
    <section class="info-section" aria-label="Anleitung">
      <h2 class="section-title"><span>Wie</span> funktioniert es?</h2>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>Rechner wählen</h3>
          <p>Wählen Sie den passenden Rechner für Ihre Dachform – Dreieck, Trapez, Walm oder Rechteck.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h3>Maße eingeben</h3>
          <p>Geben Sie Länge, Breite, Höhe und die Deckbreite Ihrer Trapezbleche ein.</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h3>Schnittliste erhalten</h3>
          <p>Sofort erhalten Sie eine vollständige Schnittliste mit allen benötigten Längen und Stückzahlen.</p>
        </div>
        <div class="step-card">
          <div class="step-num">4</div>
          <h3>Anrissplan drucken</h3>
          <p>Drucken Sie den maßstäblichen Anrissplan – fertig für die Baustelle oder den Kunden.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section" aria-label="Häufige Fragen">
      <h2 class="section-title"><span>Häufige</span> Fragen</h2>
      <div class="faq-grid">
        <details class="faq-item">
          <summary>Was ist der Unterschied zwischen Deckbreite und Lieferbreite?</summary>
          <div class="faq-body">
            <p>Die <strong>Deckbreite</strong> ist die nutzbare Breite des Trapezbleches nach dem Verlegen (meist 1,00&thinsp;m). Die <strong>Lieferbreite</strong> ist die tatsächliche Gesamtbreite des Bleches (meist 1,06&thinsp;m). Die Differenz ergibt die Überlappung.</p>
            <p>Im Rechner immer die <strong>Deckbreite</strong> eingeben – die Überlappung wird automatisch berücksichtigt.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Sind die Berechnungen für gewerbliche Nutzung erlaubt?</summary>
          <div class="faq-body">
            <p>Ja. Dachdecker, Architekten und Handwerker dürfen die Ergebnisse und Anrisspläne kostenfrei an Kunden weitergeben, solange Wasserzeichen und Quellenangaben erhalten bleiben.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Wie genau sind die Berechnungen?</summary>
          <div class="faq-body">
            <p>Die Berechnungen basieren auf geometrisch-mathematischen Grundlagen und sind sehr präzise. Dennoch sollten alle Ergebnisse vor der Ausführung von einer Fachkraft geprüft und auf der Baustelle nachgemessen werden.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Funktioniert der Rechner auf dem Smartphone?</summary>
          <div class="faq-body">
            <p>Ja, alle Rechner sind vollständig responsiv und für mobile Geräte optimiert. Die Anrisspläne sind für DIN A4 optimiert und lassen sich direkt aus dem Browser drucken.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Werden meine Daten gespeichert?</summary>
          <div class="faq-body">
            <p>Nein. Alle Berechnungen laufen lokal in Ihrem Browser. Es werden keine Projektdaten an einen Server gesendet. Nur anonyme Nutzungsstatistiken werden erfasst, sofern Sie dem zugestimmt haben.</p>
          </div>
        </details>
        <details class="faq-item">
          <summary>Was ist der U-Wert Rechner?</summary>
          <div class="faq-body">
            <p>Der U-Wert Rechner berechnet den Wärmedurchgangskoeffizienten nach DIN EN ISO 6946 und analysiert Taupunkt und Kondensatrisiko nach dem Glaser-Verfahren (DIN 4108-3). Er eignet sich für Wände, Dächer und Böden.</p>
          </div>
        </details>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .hero-bg {
    position: fixed;
    inset: 0;
    background: #0f172a url('/images/index.png') center top / cover no-repeat;
    z-index: -1;
    opacity: 0.18;
  }

  /* ── Header ── */
  .site-header {
    padding: 64px 0 44px;
    text-align: center;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.92) 0%, transparent 100%);
  }
  .header-inner { max-width: 680px; margin: 0 auto; }
  .site-header h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    color: #f8fafc;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 12px;
    line-height: 1.1;
  }
  .site-header h1 span { color: #0ea5e9; }
  .header-sub {
    font-size: 1rem;
    color: #93c5fd;
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-bottom: 10px;
  }
  .header-desc { font-size: 0.88rem; color: #64748b; max-width: 480px; margin: 0 auto; }

  /* ── Main ── */
  .main-content { padding-bottom: 80px; }

  /* ── Kachel-Grid ── */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 48px;
  }

  /* ── Schritte ── */
  .info-section { margin: 64px 0; }
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
  }
  .step-card {
    background: linear-gradient(135deg, rgba(30, 45, 74, 0.8), rgba(15, 23, 42, 0.9));
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 14px;
    padding: 28px 20px;
    text-align: center;
  }
  .step-num {
    width: 44px; height: 44px;
    background: linear-gradient(135deg, #0ea5e9, #06b6d4);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; font-weight: 700; color: white;
    margin: 0 auto 16px;
  }
  .step-card h3 { color: #f8fafc; font-size: 1rem; font-weight: 600; margin-bottom: 10px; }
  .step-card p { color: #94a3b8; font-size: 0.84rem; line-height: 1.55; }

  /* ── FAQ ── */
  .faq-section { margin: 64px 0; }
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 14px;
  }
  .faq-item {
    background: linear-gradient(135deg, rgba(30, 45, 74, 0.7), rgba(15, 23, 42, 0.8));
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 10px;
    overflow: hidden;
  }
  .faq-item summary {
    font-weight: 600;
    color: #f8fafc;
    cursor: pointer;
    list-style: none;
    font-size: 0.92rem;
    padding: 16px 20px;
    transition: background 0.2s;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: '▶  '; color: #0ea5e9; font-size: 0.75rem; }
  .faq-item[open] summary::before { content: '▼  '; }
  .faq-item summary:hover { background: rgba(14, 165, 233, 0.06); }
  .faq-body { padding: 0 20px 16px; color: #94a3b8; font-size: 0.85rem; line-height: 1.65; }
  .faq-body p { margin-bottom: 8px; }
  .faq-body p:last-child { margin-bottom: 0; }

  /* ── Guide-Card ── */
  .guide-card {
    display: flex;
    gap: 24px;
    background: linear-gradient(135deg, rgba(30, 45, 74, 0.8), rgba(15, 23, 42, 0.9));
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.2s, border-color 0.2s;
  }
  .guide-card:hover {
    transform: translateY(-3px);
    border-color: rgba(14, 165, 233, 0.4);
  }
  .guide-img {
    width: 220px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .guide-body {
    padding: 24px 24px 24px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .guide-body h3 {
    font-size: 1.3rem;
    font-weight: 700;
    color: #f8fafc;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .guide-body p { color: #94a3b8; font-size: 0.9rem; line-height: 1.6; }
  .guide-body ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
  }
  .guide-body ul li { color: #64748b; font-size: 0.83rem; }
  .guide-body ul li::before { content: '✓ '; color: #0ea5e9; }
  .guide-cta {
    margin-top: auto;
    color: #0ea5e9;
    font-weight: 600;
    font-size: 0.9rem;
  }

  @media (max-width: 640px) {
    .guide-card { flex-direction: column; }
    .guide-img { width: 100%; height: 160px; }
    .guide-body { padding: 16px; }
  }

  @media (max-width: 480px) {
    .faq-grid { grid-template-columns: 1fr; }
    .tools-grid { grid-template-columns: 1fr; }
  }
</style>
