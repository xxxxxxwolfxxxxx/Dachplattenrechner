    if (typ === 'ungleichschenkliges-dreieck' || ((typ === 'dreieck' || typ === 'dreieck-auf-rechteck') && dreieckTyp === 'ungleichschenkliges')) {
      let spitzenPosValue = breite / 2; // Default: Mitte
