---
import ToolLayout from '../../layouts/ToolLayout.astro';
import InfoBox from '../../components/InfoBox.astro';
import AdUnit from '../../components/AdUnit.astro';
import * as lattenrechner from '../../utils/lattenrechner';
---

<ToolLayout
  title="Lattenrechner – Dachlatten und Konterlatten berechnen"
  description="Berechne Dachlatten und Konterlatten für deine Dachkonstruktion. Mit Materialbedarf und Verschnitt-Optimierung."
  keywords="Lattenrechner, Dachlatten berechnen, Konterlatten, Dachkonstruktion, Lattung"
  navTitle="Lattenrechner"
  backHref="/tools/dachformen/"
  backLabel="← Dachformen"
  background="url('/images/lattung.png')"
>
  <InfoBox title="Was sind Dachlatten und Konterlatten?" icon="🔨">
    <p>Die Lattung ist ein kritischer Teil der Dachkonstruktion. Sie trägt die Dacheindeckung (Trapezbleche, Ziegel, Wellblech) und sorgt zusammen mit der Hinterlüftung für Langlebigkeit.</p>
    <ul style="margin-top: 10px;">
      <li><strong>Konterlatten:</strong> Laufen parallel zu den Sparren (meist 30×50mm oder 40×60mm), schaffen Hinterlüftungsraum</li>
      <li><strong>Dachlatten:</strong> Laufen senkrecht zu den Sparren (meist 30×40mm), halten die Blech- oder Ziegelplatten</li>
    </ul>
  </InfoBox>

  <!-- Trapez: Obere Breite -->
  <div id="trapez-fields" style="display: none;" class="section">
    <h3>Trapez-Parameter</h3>
    <div class="input-row">
      <div class="input-group">
        <label for="obere-breite">Obere Breite (m)</label>
        <input type="number" id="obere-breite" step="0.01" min="0" placeholder="z.B. 6.00" value="8">
      </div>
    </div>
  </div>

  <!-- Dreieck: Dreieck-Typ und Spitzenposition -->
  <div id="dreieck-fields" style="display: none;" class="section">
    <h3>Dreieck-Parameter</h3>
    <!-- Dreieck-Typ Auswahl - wird versteckt wenn URL-Parameter vorhanden -->
    <div id="dreieck-typ-selection" class="input-row">
      <div class="input-group">
        <label style="font-size: 14px; color: #333; margin-bottom: 8px; font-weight: 600;">Dreieck-Typ</label>
        <div style="display: flex; gap: 10px;">
          <label style="flex: 1;">
            <input type="radio" name="dreieck-typ-select" value="gleichschenkliges" checked>
            <span>Gleichschenklig (symmetrisch)</span>
          </label>
          <label style="flex: 1;">
            <input type="radio" name="dreieck-typ-select" value="ungleichschenkliges">
            <span>Ungleichschenklig (asymmetrisch)</span>
          </label>
        </div>
      </div>
    </div>
    <div class="input-row" id="spitzen-pos-row" style="display: none;">
      <div class="input-group">
        <label for="spitzen-pos">Spitzenposition von links (m)</label>
        <input type="number" id="spitzen-pos" step="0.1" min="0" placeholder="z.B. 3.00">
      </div>
    </div>
  </div>

  <!-- Dreieck-auf-Rechteck: Höhen -->
  <div id="dreieck-auf-rechteck-fields" style="display: none;" class="section">
    <h3>Dreieck auf Rechteck - Parameter</h3>
    <div class="input-row">
      <div class="input-group">
        <label for="rechteck-hoehe">Rechteck-Höhe (m)</label>
        <input type="number" id="rechteck-hoehe" step="0.01" min="0" placeholder="z.B. 3.00" value="3">
      </div>
      <div class="input-group">
        <label for="dreieck-hoehe">Dreieck-Höhe (m)</label>
        <input type="number" id="dreieck-hoehe" step="0.01" min="0" placeholder="z.B. 2.00" value="2">
      </div>
    </div>
    <div id="dreieck-auf-rechteck-typ-selection" class="input-row">
      <div class="input-group">
        <label style="font-size: 14px; color: #333; margin-bottom: 8px; font-weight: 600;">Dreieck-Typ</label>
        <div style="display: flex; gap: 10px;">
          <label style="flex: 1;">
            <input type="radio" name="dreieck-auf-rechteck-typ" value="gleichschenkliges" checked>
            <span>Gleichschenklig</span>
          </label>
          <label style="flex: 1;">
            <input type="radio" name="dreieck-auf-rechteck-typ" value="ungleichschenkliges">
            <span>Ungleichschenklig</span>
          </label>
        </div>
      </div>
    </div>
    <div class="input-row" id="spitzen-pos-dar-row" style="display: none;">
      <div class="input-group">
        <label for="spitzen-pos-dar">Spitzenposition von links (m)</label>
        <input type="number" id="spitzen-pos-dar" step="0.1" min="0" placeholder="z.B. 3.00">
      </div>
    </div>
  </div>

  <!-- Trapez-auf-Rechteck: Höhen -->
  <div id="trapez-auf-rechteck-fields" style="display: none;" class="section">
    <h3>Trapez auf Rechteck - Parameter</h3>
    <div class="input-row">
      <div class="input-group">
        <label for="obere-breite-tar">Obere Breite (m)</label>
        <input type="number" id="obere-breite-tar" step="0.01" min="0" placeholder="z.B. 6.00" value="8">
      </div>
      <div class="input-group">
        <label for="rechteck-hoehe-tar">Rechteck-Höhe (m)</label>
        <input type="number" id="rechteck-hoehe-tar" step="0.01" min="0" placeholder="z.B. 3.00" value="3">
      </div>
      <div class="input-group">
        <label for="trapez-hoehe-tar">Trapez-Höhe (m)</label>
        <input type="number" id="trapez-hoehe-tar" step="0.01" min="0" placeholder="z.B. 2.00" value="2">
      </div>
    </div>
  </div>

  <!-- Dachform-Eingaben (normalerweise von Folgerechner übergeben) -->
  <div class="section" id="dachform-section" style="display: none;">
    <h2>0. Dachform (von Folgerechner übernommen)</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="breite">Dachbreite (m)</label>
        <input type="number" id="breite" step="0.01" min="0" placeholder="z.B. 10.00">
      </div>
      <div class="input-group">
        <label for="hoehe">Dachhöhe (m)</label>
        <input type="number" id="hoehe" step="0.01" min="0" placeholder="z.B. 8.00">
      </div>
      <div class="input-group">
        <label for="typ-select">Dachform</label>
        <select id="typ-select" style="width: 100%; padding: 12px 15px; border: 2px solid #e1e8ed; border-radius: 8px; font-size: 16px;">
          <option value="rechteck">Rechteck</option>
          <option value="trapez">Trapez</option>
          <option value="dreieck">Dreieck</option>
          <option value="ungleichschenkliges-dreieck">Ungleichschenkliges Dreieck</option>
          <option value="dreieck-auf-rechteck">Dreieck auf Rechteck</option>
          <option value="trapez-auf-rechteck">Trapez auf Rechteck</option>
        </select>
      </div>
    </div>
  </div>

  <div class="section">
    <h2>1. Sparren & Konterlatten</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="sparren-anzahl">Anzahl Sparren</label>
        <input type="number" id="sparren-anzahl" step="1" min="2" value="8" placeholder="z.B. 8">
      </div>
      <div class="input-group">
        <label for="sparren-abstand">Sparren-Abstand (cm)</label>
        <input type="number" id="sparren-abstand" step="10" min="50" value="80" placeholder="z.B. 80">
      </div>
      <div class="input-group">
        <label for="dachueberstand">Dachüberstand (cm)</label>
        <input type="number" id="dachueberstand" step="5" min="0" value="30" placeholder="z.B. 30">
      </div>
    </div>
  </div>

  <AdUnit position="middle" />

  <div class="section">
    <h2>2. Verfügbare Längenlisten</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="konterlatten-laengen">Konterlatten-Längen (m, komma-getrennt)</label>
        <input type="text" id="konterlatten-laengen" value="3, 4, 5, 6" placeholder="z.B. 3, 4, 5, 6">
      </div>
      <div class="input-group">
        <label for="dachlatten-laengen">Dachlatten-Längen (m, komma-getrennt)</label>
        <input type="text" id="dachlatten-laengen" value="3, 4, 5, 6" placeholder="z.B. 3, 4, 5, 6">
      </div>
    </div>
  </div>

  <div class="section">
    <h2>3. Lattenabstand</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="lattenabstand">Lattenabstand (mm, Mitte zu Mitte)</label>
        <input type="number" id="lattenabstand" step="10" min="100" value="600" placeholder="z.B. 600">
      </div>
    </div>
  </div>

  <button class="calculate-btn" id="lattenrechner-button">Berechnen</button>

  <div id="results" class="results" style="display: none;">
    <h3 style="text-align: center; margin-bottom: 20px; color: #ffd700;">Verlegungsplan & Materialberechnung</h3>

    <!-- SVG Visualization -->
    <div id="vorschau-svg" style="margin-bottom: 30px; text-align: center;"></div>

    <!-- Optimierungs-Breakdown -->
    <div id="optimization-breakdown" style="background: rgba(255, 255, 255, 0.1); border-left: 4px solid #ffd700; padding: 15px; margin: 20px 0; border-radius: 4px; display: none;">
      <h4 style="color: #ffd700; margin-top: 0; margin-bottom: 15px; font-size: 1.1em;">🚀 Optimierungs-Zusammenfassung</h4>
      <div id="optimization-details" style="font-size: 0.95em; line-height: 1.6;"></div>
    </div>

    <!-- Materialtabelle -->
    <div style="margin-bottom: 30px;">
      <h4 style="color: #1e3c72; margin-bottom: 15px;">Materialbedarf pro Länge</h4>
      <table id="material-table" style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
        <thead>
          <tr style="background-color: #1e3c72; color: white;">
            <th style="padding: 12px; text-align: left; font-weight: bold;">Material-Typ</th>
            <th style="padding: 12px; text-align: left; font-weight: bold;">Länge (m)</th>
            <th style="padding: 12px; text-align: center; font-weight: bold;">Anzahl</th>
            <th style="padding: 12px; text-align: right; font-weight: bold;">Gesamt (m)</th>
          </tr>
        </thead>
        <tbody id="material-details" style=""></tbody>
      </table>
    </div>

    <!-- Konterlatten Zusammenfassung -->
    <div style="background: #e3f2fd; border-left: 4px solid #1e3c72; padding: 15px; margin: 15px 0; border-radius: 4px; display: inline-block; width: 48%; margin-right: 2%;">
      <h4 style="color: #1e3c72; margin-top: 0; margin-bottom: 12px; border-bottom: 2px solid #1e3c72; padding-bottom: 8px;">Konterlatten</h4>
      <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #b3e5fc;">
        <span style="color: #1e3c72;">Gesamtlänge:</span>
        <span id="konterlatte-gesamtlaenge" style="font-weight: bold; color: #1e3c72;">-</span>
      </div>
      <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #b3e5fc;">
        <span style="color: #1e3c72;">Anzahl (Stück):</span>
        <span id="konterlatte-anzahl" style="font-weight: bold; color: #1e3c72;">-</span>
      </div>
      <div style="display: flex; justify-content: space-between; padding: 8px 0;">
        <span style="color: #1e3c72;">Verschnitt:</span>
        <span id="konterlatte-verschnitt" style="font-weight: bold; color: #1e3c72;">-</span>
      </div>
    </div>

    <!-- Dachlatten Zusammenfassung -->
    <div style="background: #e0f2f1; border-left: 4px solid #2a5298; padding: 15px; margin: 15px 0; border-radius: 4px; display: inline-block; width: 48%;">
      <h4 style="color: #2a5298; margin-top: 0; margin-bottom: 12px; border-bottom: 2px solid #2a5298; padding-bottom: 8px;">Dachlatten</h4>
      <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #80deea;">
        <span style="color: #2a5298;">Gesamtlänge:</span>
        <span id="dachlatte-gesamtlaenge" style="font-weight: bold; color: #2a5298;">-</span>
      </div>
      <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #80deea;">
        <span style="color: #2a5298;">Anzahl (Stück):</span>
        <span id="dachlatte-anzahl" style="font-weight: bold; color: #2a5298;">-</span>
      </div>
      <div style="display: flex; justify-content: space-between; padding: 8px 0;">
        <span style="color: #2a5298;">Verschnitt:</span>
        <span id="dachlatte-verschnitt" style="font-weight: bold; color: #2a5298;">-</span>
      </div>
    </div>

  </div>
  </div>


  <!-- Print und Navigation Buttons -->
  <div style="margin-top: 30px; text-align: center; display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
    <button id="print-button" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; border: none; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(40, 167, 69, 0.3)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
      🖨️ Drucken
    </button>
    <a id="to-anrissplan" href="#" style="display: none; color: white; text-decoration: none; background: linear-gradient(135deg, #007bff 0%, #0056b3 100%); border: none; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(0, 123, 255, 0.3)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
      📋 Zum Anrissplan
    </a>
    <a id="to-pv-rechner" href="#" style="display: none; color: white; text-decoration: none; background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%); border: none; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(255, 152, 0, 0.3)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
      ⚡ Zum PV-Rechner
    </a>

  <InfoBox title="💡 Tipp: Lattenabstand" variant="tip">
    <p><strong>Trapezbleche:</strong> 600-900mm je nach Profiltiefe<br/>
    <strong>Ziegel:</strong> 350-600mm je nach Ziegeltyp<br/>
    <strong>Wellblech:</strong> 500-750mm je nach Wellenprofil</p>
  </InfoBox>

</ToolLayout>

<script src="/tools-js/lattenrechner.js" defer></script>

<style>
  .section { background: rgba(255, 255, 255, 0.95); border-radius: 15px; padding: 25px; margin-bottom: 25px; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1); }
  .section h2 { color: #1e3c72; margin-bottom: 20px; font-size: 1.5em; border-bottom: 2px solid #e3f2fd; padding-bottom: 10px; }
  .input-row { display: flex; gap: 20px; margin-bottom: 20px; flex-wrap: wrap; }
  .input-group { flex: 1; min-width: 250px; }
  .input-group label { display: block; margin-bottom: 8px; font-weight: 600; color: #2c3e50; }
  .input-group input { width: 100%; padding: 12px 15px; border: 2px solid #e1e8ed; border-radius: 8px; font-size: 16px; transition: all 0.3s ease; }
  .input-group input:focus { outline: none; border-color: #1e3c72; box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.1); }
  .calculate-btn { background: linear-gradient(135deg, #007bff 0%, #0056b3 100%); color: white; border: none; padding: 15px 30px; border-radius: 12px; font-size: 16px; font-weight: 600; cursor: pointer; margin: 20px auto; display: block; box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3); transition: all 0.3s ease; min-width: 200px; }
  .calculate-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0, 123, 255, 0.4); background: linear-gradient(135deg, #0056b3 0%, #004085 100%); }
  .results { background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); border-radius: 15px; padding: 25px; margin-top: 25px; color: white; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15); }
  .result-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.2); }
  .result-item:last-child { border-bottom: none; }
  .result-item span:last-child { font-weight: bold; font-size: 1.1em; color: #ffd700; }
  #vorschau-svg { background: white; border-radius: 8px; padding: 15px; margin: 20px 0; }
  #vorschau-svg svg { max-width: 100%; height: auto; }
  @media (max-width: 768px) {
    .input-row { flex-direction: column; gap: 12px; }
    .input-group { min-width: auto; }
    #vorschau-svg { padding: 10px; }
  }
</style>

<script>
  // Placeholder für Utility - wird dynamisch geladen
  window.lattenrechner = null;

  // ========== Dynamische Dachform-Felder ==========
  // Diese Funktion wird NICHT mehr verwendet, da wir URL-Parameter verwenden
  // Dachform-Felder werden über displayDachformFelderFuerTyp() angezeigt (in lattenrechner.js)
  function updateDachformFelder(typ) {
    // Verstecke alle Felder zunächst
    document.getElementById('trapez-fields').style.display = 'none';
    document.getElementById('dreieck-fields').style.display = 'none';
    document.getElementById('dreieck-auf-rechteck-fields').style.display = 'none';
    document.getElementById('trapez-auf-rechteck-fields').style.display = 'none';

    // Zeige nur die relevanten Felder
    switch(typ) {
      case 'trapez':
        document.getElementById('trapez-fields').style.display = 'block';
        break;
      case 'dreieck':
      case 'gleichschenkliges-dreieck':
      case 'ungleichschenkliges-dreieck':
        document.getElementById('dreieck-fields').style.display = 'block';
        break;
      case 'dreieck-auf-rechteck':
        document.getElementById('dreieck-auf-rechteck-fields').style.display = 'block';
        break;
      case 'trapez-auf-rechteck':
        document.getElementById('trapez-auf-rechteck-fields').style.display = 'block';
        break;
    }
  }

  // Zeige/verstecke Spitzenposition basierend auf Dreieck-Typ
  function updateDreieckSpitzeFelder() {
    const typ = document.getElementById('typ-select').value;
    const dreieckTypRadio = document.querySelector('input[name="dreieck-typ-select"]:checked');
    const dreieckTyp = dreieckTypRadio ? dreieckTypRadio.value : null;
    const spitzenPosRow = document.getElementById('spitzen-pos-row');
    // Zeige spitzen-pos wenn: typ='ungleichschenkliges-dreieck' ODER wenn dreieckTyp='ungleichschenkliges'
    spitzenPosRow.style.display = (typ === 'ungleichschenkliges-dreieck' || dreieckTyp === 'ungleichschenkliges') ? 'grid' : 'none';
  }

  function updateDreieckAufRechteckSpitzeFelder() {
    const dreieckTyp = document.querySelector('input[name="dreieck-auf-rechteck-typ"]:checked').value;
    const spitzenPosRow = document.getElementById('spitzen-pos-dar-row');
    spitzenPosRow.style.display = dreieckTyp === 'ungleichschenkliges' ? 'grid' : 'none';
  }

  // Event-Listener für Dachform-Typ-Änderung
  const typSelect = document.getElementById('typ-select');
  if (typSelect) {
    typSelect.addEventListener('change', (e) => {
      console.log('🔄 Dachform-Typ geändert:', e.target.value);
      updateDachformFelder(e.target.value);
      updateDreieckSpitzeFelder(); // Aktualisiere auch die Spitzenposition-Anzeige
    });
  }

  // Event-Listener für Dreieck-Typ-Änderung (nur wenn diese Radios existieren)
  const dreieckTypRadios = document.querySelectorAll('input[name="dreieck-typ-select"]');
  if (dreieckTypRadios.length > 0) {
    dreieckTypRadios.forEach(radio => {
      radio.addEventListener('change', updateDreieckSpitzeFelder);
    });
  }

  const dreieckAufRechteckRadios = document.querySelectorAll('input[name="dreieck-auf-rechteck-typ"]');
  if (dreieckAufRechteckRadios.length > 0) {
    dreieckAufRechteckRadios.forEach(radio => {
      radio.addEventListener('change', updateDreieckAufRechteckSpitzeFelder);
    });
  }

  // Dach-Parameter aus URL laden (FOLGERECHNER - benötigt URL-Parameter!)
  function ladParameterAusURL() {
    const params = new URLSearchParams(window.location.search);
    console.log(`📍 Lattenrechner - URL Params:`, Array.from(params.entries()));

    // Überprüfe ob Dachform-Parameter aus URL vorhanden sind
    const hatDachformParameter = params.has('breite') && params.has('hoehe') && params.has('typ');

    if (!hatDachformParameter) {
      // FOLGERECHNER: Ohne Parameter muss zurück zur Dachflächenberechnung
      console.warn('❌ FEHLER: Lattenrechner benötigt URL-Parameter (breite, hoehe, typ) von der Dachflächenberechnung!');
      const infoMsg = document.createElement('div');
      infoMsg.style.cssText = 'background: #fff3cd; border: 2px solid #ffc107; border-radius: 8px; padding: 20px; margin: 20px 0; text-align: center;';
      infoMsg.innerHTML = `
        <h3 style="color: #856404; margin-top: 0;">⚠️ Folgerechner</h3>
        <p style="color: #856404; margin: 10px 0;">Der Lattenrechner ist ein Folgerechner der Dachflächenberechnung.</p>
        <p style="color: #856404; margin: 10px 0;">Bitte führe zuerst die Dachflächenberechnung durch.</p>
        <a href="/tools/dachflaechenberechnung/" style="background: #ffc107; color: #333; padding: 12px 30px; border-radius: 8px; text-decoration: none; font-weight: bold; display: inline-block; margin-top: 10px;">→ Zur Dachflächenberechnung</a>
      `;
      document.body.insertBefore(infoMsg, document.body.firstChild);
      return;
    }

    console.log('✅ Dachform-Parameter von URL vorhanden, zeige Dachform-Sektion und starte Auto-Berechnung');

    // Zeige die Dachform-Sektion (normalerweise versteckt)
    const dachformSection = document.getElementById('dachform-section');
    if (dachformSection) {
      dachformSection.style.display = 'block';
      console.log('✅ Dachform-Sektion angezeigt');
    }

    // Lade Basis-Parameter (falls Element vorhanden - diese können optional sein)
    if (params.has('breite')) {
      const breiteEl = document.getElementById('breite');
      if (breiteEl) {
        breiteEl.value = parseFloat(params.get('breite')).toFixed(2);
        console.log('✅ Breite gefüllt:', breiteEl.value);
      }
    }

    if (params.has('hoehe')) {
