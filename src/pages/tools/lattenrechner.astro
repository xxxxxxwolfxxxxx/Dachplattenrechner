      breiteValid: !!breite,
      hoeheValid: !!hoehe,
      lattenabstandValid: !!lattenabstand
    });

    if (!breite || !hoehe || !lattenabstand) {
      console.error('❌ VALIDATION FAILED: Missing required fields');
      alert('Bitte füllen Sie alle erforderlichen Felder aus!');
      return;
    }

    if (konterlattenLaengen.length === 0) {
      console.error('❌ VALIDATION FAILED: No Konterlatten lengths');
      alert('Bitte geben Sie verfügbare Konterlatten-Längen an (komma-getrennt)!');
      return;
    }

    if (dachlatteLaengen.length === 0) {
      console.error('❌ VALIDATION FAILED: No Dachlatte lengths');
      alert('Bitte geben Sie verfügbare Dachlatten-Längen an (komma-getrennt)!');
      return;
    }

    console.log('✅ All validations passed, proceeding with calculation...');

    try {
      // Berechne mit neuem Algorithmus
      const roofDims = {
        width: breite,
        height: hoehe,
        type: typ,
        upperWidth: typ === 'trapez' || typ === 'trapez-auf-rechteck' ? obereBreite : undefined,
        trapezHeight: typ === 'trapez-auf-rechteck' ? trapezHoehe : undefined,
        rectHeight: typ === 'trapez-auf-rechteck' ? rechteckHoehe : undefined,
        dreieckHeight: typ === 'dreieck-auf-rechteck' ? dreieckHoehe : undefined,
        dreieckRectHeight: typ === 'dreieck-auf-rechteck' ? rechteckHoehe : undefined,
        spitzenPosition: typ === 'ungleichschenkliges-dreieck' || ((typ === 'dreieck' || typ === 'dreieck-auf-rechteck') && dreieckTyp === 'ungleichschenkliges') ? (spitzenPosition / breite) : undefined,
        dreieckType: (typ === 'dreieck' || typ === 'dreieck-auf-rechteck' || typ === 'ungleichschenkliges-dreieck') ? dreieckTyp : undefined
      };

      const calcParams = {
        roofDims,
        rafterCount: sparrenAnzahl,
        rafterSpacing: sparrenAbstand, // cm
        overhang: dachueberstand, // cm
        rowSpacing: lattenabstand, // mm
        availableCounters: konterlattenLaengen,
        availableRafters: dachlatteLaengen
      };

      // Lade Utility von Server (wird ca 400-600ms dauern beim ersten Load)
      if (!window.lattenrechner) {
        console.log('⏳ Lade Utility von Server...');
        const response = await fetch('/js-utils/lattenrechner.js');
        if (!response.ok) throw new Error('Utility konnte nicht geladen werden');
        const jsCode = await response.text();
        eval(jsCode);
      }

      if (!window.lattenrechner) {
        throw new Error('Utility konnte nicht initialisiert werden');
      }

      // KRITISCH: Setze globale Variablen BEVOR generiereVorschau aufgerufen wird!
      // Diese Variablen werden von generiereVorschau() und berechneSpitzdachSparren() verwendet
      window.dachBreite = breite;
      window.dachHoehe = hoehe;
      window.dachTyp = typ;
      window.obereBreite = typ === 'trapez' || typ === 'trapez-auf-rechteck' ? obereBreite : breite;
      window.trapezHoehe = typ === 'trapez-auf-rechteck' ? trapezHoehe : (typ === 'trapez' ? hoehe : 0);
      window.rechteckHoehe = typ === 'trapez-auf-rechteck' || typ === 'dreieck-auf-rechteck' ? rechteckHoehe : 0;
      window.dreieckHoehe = typ === 'dreieck-auf-rechteck' ? dreieckHoehe : 0;
      // Setze spitzenPosition und dreieckTyp für ALLE Dreieck-Formen (dreieck, dreieck-auf-rechteck, ungleichschenkliges-dreieck)
      window.spitzenPosition = (typ === 'dreieck' || typ === 'dreieck-auf-rechteck' || typ === 'ungleichschenkliges-dreieck') ? spitzenPosition : 0.5;
      window.dreieckTyp = (typ === 'dreieck' || typ === 'dreieck-auf-rechteck' || typ === 'ungleichschenkliges-dreieck') ? dreieckTyp : 'gleichschenkliges';
      window.sparrenPositionen = [];
      window.sparrenLaengen = [];

      console.log('✅ Globale Variablen gesetzt:', {
        dachBreite: window.dachBreite,
        dachHoehe: window.dachHoehe,
        dachTyp: window.dachTyp,
        obereBreite: window.obereBreite,
        trapezHoehe: window.trapezHoehe,
        rechteckHoehe: window.rechteckHoehe,
        dreieckHoehe: window.dreieckHoehe,
        spitzenPosition: window.spitzenPosition,
        dreieckTyp: window.dreieckTyp
      });

      const result = window.lattenrechner.berechne(calcParams);

      // Zeige Ergebnisse
      const flaeche = (breite * hoehe).toFixed(2);
      const flaeche_result = document.getElementById('flaeche-result');
      if (flaeche_result) flaeche_result.textContent = flaeche + ' m²';

      const anzahl_latten = document.getElementById('anzahl-latten');
      if (anzahl_latten) anzahl_latten.textContent = result.roofRafters.count + ' Stück';

      const gesamt_laenge = document.getElementById('gesamt-laenge');
      if (gesamt_laenge) gesamt_laenge.textContent = result.roofRafters.totalLength.toFixed(2) + ' m';

      // Generiere SVG Verlegungsplan
      const svg = window.lattenrechner.generiereVorschau(result, roofDims, calcParams.rafterCount, calcParams.rowSpacing);

      const svgContainer = document.getElementById('vorschau-svg');
      if (svgContainer) {
        if (svg) {
          svgContainer.innerHTML = svg;
          console.log('✅ SVG wurde ins DOM eingefügt');
        } else {
          console.warn('⚠️ SVG-String war leer oder undefined');
        }
      } else {
        console.error('❌ SVG-Container nicht gefunden!');
      }

      // Zeige Ergebnisse
      const resultsDiv = document.getElementById('results');
      if (resultsDiv) resultsDiv.style.display = 'block';

      // Zeige Material-Ergebnisse
      zeigeErgebnisse(result);

      // Speichere Daten für Druckfunktion
      window.currentRoofDims = {
        breite: breite,
        hoehe: hoehe,
        typ: typ
      };
      window.currentResult = result;

      // Google Analytics
      if (typeof gtag !== 'undefined') {
        gtag('event', 'calculation', {
          'event_category': 'lattenrechner',
          'event_label': 'form_submitted'
        });
      }
    } catch (error) {
      console.error('Berechnung fehlgeschlagen:', error);
      alert('Ein Fehler bei der Berechnung ist aufgetreten: ' + error.message);
    }
  }

  // Expose berechnen to window for button onclick
  window.berechnen = berechnen;
  window.ladParameterAusURL = ladParameterAusURL;

  // Event-Listener für Auto-Berechnung der Sparren-Parameter
  const sparrenAnzahlEl = document.getElementById('sparren-anzahl');
  const sparrenAbstandEl = document.getElementById('sparren-abstand');
  const dachueberstandEl = document.getElementById('dachueberstand');
  const breiteEl = document.getElementById('breite');

  [sparrenAnzahlEl, sparrenAbstandEl, dachueberstandEl, breiteEl].forEach(input => {
    if (input) {
      input.addEventListener('input', berechneSparrenParameter);
      input.addEventListener('change', berechneSparrenParameter);
    }
  });

  // Verknüpfe Button
  const button = document.getElementById('lattenrechner-button');
  if (button) {
    button.addEventListener('click', berechnen);
  }

  // Print-Button Event-Listener
  const printButton = document.getElementById('print-button');
  if (printButton) {
    printButton.addEventListener('click', () => {
      if (window.currentRoofDims && window.currentResult) {
        druckeLattenplan(window.currentRoofDims, window.currentResult);
      } else {
        alert('Bitte führen Sie zuerst eine Berechnung durch!');
      }
    });
  }

  // Mehrfache Trigger-Punkte für maximale Kompatibilität
  console.log('🚀 Script initialisiert. DOMContentLoaded state:', document.readyState);

  // Sofort versuchen (mit Retries falls Elemente fehlen)
  ladParameterAusURL();

  // Load event
  window.addEventListener('load', () => {
    console.log('📌 window.load event fired');
    ladParameterAusURL();
  });

  // DOMContentLoaded
  document.addEventListener('DOMContentLoaded', () => {
    console.log('📌 DOMContentLoaded event fired');
    // Initialisiere Dachform-Felder
    updateDachformFelder();
    updateDreieckSpitzeFelder();
    updateDreieckAufRechteckSpitzeFelder();
    // Lade Parameter aus URL
    ladParameterAusURL();
  });

  // Falls DOM bereits geladen ist (bei schnellen Seiten-Übergängen)
  if (document.readyState === 'loading') {
    console.log('📌 DOM wird noch geladen...');
  } else {
    console.log('📌 DOM bereits geladen (readyState:', document.readyState + ')');
    // Verhindere doppelten Aufruf: nur initialisieren wenn das Event nicht existiert
    setTimeout(() => {
      if (typeof updateDachformFelder === 'function') {
        updateDachformFelder();
        updateDreieckSpitzeFelder();
        updateDreieckAufRechteckSpitzeFelder();
      }
    }, 100);
  }

  // Visibility Change (für Astro View Transitions)
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) {
      console.log('📌 Seite wurde sichtbar (visibilitychange)');
      updateDachformFelder();
      updateDreieckSpitzeFelder();
      updateDreieckAufRechteckSpitzeFelder();
      ladParameterAusURL();
    }
  });

  // ========== Navigation-Links zu anderen Rechnern ==========
  function updateNavigationLinksLattenrechner() {
    const params = new URLSearchParams(window.location.search);
    const breite = params.get('breite');
    const hoehe = params.get('hoehe');
    const typ = params.get('typ');

    if (!breite || !hoehe || !typ) return;

    // Build base URLs with simple parameters
    let anrissUrl = `/tools/anrissplan.html?breite=${breite}&hoehe=${hoehe}&typ=${typ}`;
    let pvUrl = `/tools/pv-rechner/?breite=${breite}&hoehe=${hoehe}&typ=${typ}`;

    // Build full URLs with shape-specific params
    if (typ === 'trapez' || typ === 'dreieck' || typ === 'ungleichschenkliges-dreieck') {
      const brOben = params.get('breite-oben') || params.get('breiteOben');
      const spitzenPos = params.get('spitzenPosition');
      if (brOben) {
        anrissUrl += `&breiteOben=${brOben}`;
        pvUrl += `&breiteOben=${brOben}`;
      }
      if (spitzenPos) {
        anrissUrl += `&spitzenPosition=${spitzenPos}`;
        pvUrl += `&spitzenPosition=${spitzenPos}`;
      }
    } else if (typ === 'dreieck-auf-rechteck') {
      const dreieckH = params.get('dreieckHoehe');
      const rechteckH = params.get('rechteckHoehe');
      const dreieckTyp = params.get('dreieckTyp');
      const spitzenPos = params.get('spitzenPosition');
      if (dreieckH) {
        anrissUrl += `&dreieckHoehe=${dreieckH}`;
        pvUrl += `&dreieckHoehe=${dreieckH}`;
      }
      if (rechteckH) {
        anrissUrl += `&rechteckHoehe=${rechteckH}`;
        pvUrl += `&rechteckHoehe=${rechteckH}`;
      }
      if (dreieckTyp) {
        anrissUrl += `&dreieckTyp=${dreieckTyp}`;
        pvUrl += `&dreieckTyp=${dreieckTyp}`;
      }
      if (spitzenPos) {
        anrissUrl += `&spitzenPosition=${spitzenPos}`;
        pvUrl += `&spitzenPosition=${spitzenPos}`;
      }
    } else if (typ === 'trapez-auf-rechteck') {
      const brOben = params.get('breite-oben') || params.get('breiteOben');
      const dreieckH = params.get('dreieckHoehe') || params.get('trapez-hoehe');
      const rechteckH = params.get('rechteckHoehe') || params.get('rechteck-hoehe');
      if (brOben) {
        anrissUrl += `&breiteOben=${brOben}`;
        pvUrl += `&breiteOben=${brOben}`;
      }
      if (dreieckH) {
        anrissUrl += `&dreieckHoehe=${dreieckH}`;
        pvUrl += `&dreieckHoehe=${dreieckH}`;
      }
      if (rechteckH) {
        anrissUrl += `&rechteckHoehe=${rechteckH}`;
        pvUrl += `&rechteckHoehe=${rechteckH}`;
      }
    }

    // Show Anrissplan link
    const anrissLink = document.getElementById('to-anrissplan');
    if (anrissLink) {
      anrissLink.href = anrissUrl;
      anrissLink.style.display = 'inline-block';
      console.log('✅ Anrissplan-Link angezeigt:', anrissUrl);
    }

    // Show PV-Rechner link
    const pvLink = document.getElementById('to-pv-rechner');
    if (pvLink) {
      pvLink.href = pvUrl;
      pvLink.style.display = 'inline-block';
      console.log('✅ PV-Rechner-Link angezeigt:', pvUrl);
    }
  }

  // Rufe Navigation-Update auf wenn Seite geladen ist
  document.addEventListener('DOMContentLoaded', () => {
    updateNavigationLinksLattenrechner();
  });

  // Fallback: Rufe sofort auf, falls DOMContentLoaded bereits feuert
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateNavigationLinksLattenrechner);
  } else {
    updateNavigationLinksLattenrechner();
  }
</script>
