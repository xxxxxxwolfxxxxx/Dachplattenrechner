---
import ToolLayout from '../../layouts/ToolLayout.astro';
import InfoBox from '../../components/InfoBox.astro';
import AdUnit from '../../components/AdUnit.astro';
import * as lattenrechner from '../../utils/lattenrechner';
---

<ToolLayout
  title="Lattenrechner – Dachlatten und Konterlatten berechnen"
  description="Berechne Dachlatten und Konterlatten für deine Dachkonstruktion. Mit Materialbedarf und Verschnitt-Optimierung."
  keywords="Lattenrechner, Dachlatten berechnen, Konterlatten, Dachkonstruktion, Lattung"
  navTitle="Lattenrechner"
  backHref="/tools/dachformen/"
  backLabel="← Dachformen"
  background="url('/images/lattung.png')"
>
  <InfoBox title="Was sind Dachlatten und Konterlatten?" icon="🔨">
    <p>Die Lattung ist ein kritischer Teil der Dachkonstruktion. Sie trägt die Dacheindeckung (Trapezbleche, Ziegel, Wellblech) und sorgt zusammen mit der Hinterlüftung für Langlebigkeit.</p>
    <ul style="margin-top: 10px;">
      <li><strong>Konterlatten:</strong> Laufen parallel zu den Sparren (meist 30×50mm oder 40×60mm), schaffen Hinterlüftungsraum</li>
      <li><strong>Dachlatten:</strong> Laufen senkrecht zu den Sparren (meist 30×40mm), halten die Blech- oder Ziegelplatten</li>
    </ul>
  </InfoBox>

  <div class="section">
    <h2>1. Dachflächenabmessungen</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="breite">Breite (m)</label>
        <input type="number" id="breite" step="0.01" min="0" placeholder="z.B. 10.00">
      </div>
      <div class="input-group">
        <label for="hoehe">Höhe / Länge (m)</label>
        <input type="number" id="hoehe" step="0.01" min="0" placeholder="z.B. 8.00">
      </div>
    </div>
  </div>

  <div class="section">
    <h2>2. Sparren & Konterlatten</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="sparren-anzahl">Anzahl Sparren</label>
        <input type="number" id="sparren-anzahl" step="1" min="2" value="8" placeholder="z.B. 8">
      </div>
      <div class="input-group">
        <label for="sparren-abstand">Sparren-Abstand (cm)</label>
        <input type="number" id="sparren-abstand" step="10" min="50" value="80" placeholder="z.B. 80">
      </div>
      <div class="input-group">
        <label for="dachueberstand">Dachüberstand (cm)</label>
        <input type="number" id="dachueberstand" step="5" min="0" value="30" placeholder="z.B. 30">
      </div>
    </div>
  </div>

  <AdUnit position="middle" />

  <div class="section">
    <h2>3. Verfügbare Längenlisten</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="konterlatten-laengen">Konterlatten-Längen (m, komma-getrennt)</label>
        <input type="text" id="konterlatten-laengen" value="3, 4, 5, 6" placeholder="z.B. 3, 4, 5, 6">
      </div>
      <div class="input-group">
        <label for="dachlatten-laengen">Dachlatten-Längen (m, komma-getrennt)</label>
        <input type="text" id="dachlatten-laengen" value="3, 4, 5, 6" placeholder="z.B. 3, 4, 5, 6">
      </div>
    </div>
  </div>

  <div class="section">
    <h2>4. Lattenabstand</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="lattenabstand">Lattenabstand (mm, Mitte zu Mitte)</label>
        <input type="number" id="lattenabstand" step="10" min="100" value="600" placeholder="z.B. 600">
      </div>
    </div>
  </div>

  <button class="calculate-btn" id="lattenrechner-button">Berechnen</button>

  <div id="results" class="results" style="display: none;">
    <h3 style="text-align: center; margin-bottom: 20px; color: #ffd700;">Verlegungsplan & Materialberechnung</h3>

    <!-- SVG Visualization -->
    <div id="vorschau-svg" style="margin-bottom: 30px; text-align: center;"></div>

    <!-- Optimierungs-Breakdown -->
    <div id="optimization-breakdown" style="background: rgba(255, 255, 255, 0.1); border-left: 4px solid #ffd700; padding: 15px; margin: 20px 0; border-radius: 4px; display: none;">
      <h4 style="color: #ffd700; margin-top: 0; margin-bottom: 15px; font-size: 1.1em;">🚀 Optimierungs-Zusammenfassung</h4>
      <div id="optimization-details" style="font-size: 0.95em; line-height: 1.6;"></div>
    </div>

    <!-- Materialtabelle -->
    <div style="margin-bottom: 30px;">
      <h4 style="color: #1e3c72; margin-bottom: 15px;">Materialbedarf pro Länge</h4>
      <table id="material-table" style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
        <thead>
          <tr style="background-color: #1e3c72; color: white;">
            <th style="padding: 12px; text-align: left; font-weight: bold;">Material-Typ</th>
            <th style="padding: 12px; text-align: left; font-weight: bold;">Länge (m)</th>
            <th style="padding: 12px; text-align: center; font-weight: bold;">Anzahl</th>
            <th style="padding: 12px; text-align: right; font-weight: bold;">Gesamt (m)</th>
          </tr>
        </thead>
        <tbody id="material-details" style=""></tbody>
      </table>
    </div>

    <!-- Konterlatten Zusammenfassung -->
    <div style="background: #e3f2fd; border-left: 4px solid #1e3c72; padding: 15px; margin: 15px 0; border-radius: 4px; display: inline-block; width: 48%; margin-right: 2%;">
      <h4 style="color: #1e3c72; margin-top: 0; margin-bottom: 12px; border-bottom: 2px solid #1e3c72; padding-bottom: 8px;">Konterlatten</h4>
      <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #b3e5fc;">
        <span style="color: #1e3c72;">Gesamtlänge:</span>
        <span id="konterlatte-gesamtlaenge" style="font-weight: bold; color: #1e3c72;">-</span>
      </div>
      <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #b3e5fc;">
        <span style="color: #1e3c72;">Anzahl (Stück):</span>
        <span id="konterlatte-anzahl" style="font-weight: bold; color: #1e3c72;">-</span>
      </div>
      <div style="display: flex; justify-content: space-between; padding: 8px 0;">
        <span style="color: #1e3c72;">Verschnitt:</span>
        <span id="konterlatte-verschnitt" style="font-weight: bold; color: #1e3c72;">-</span>
      </div>
    </div>

    <!-- Dachlatten Zusammenfassung -->
    <div style="background: #e0f2f1; border-left: 4px solid #2a5298; padding: 15px; margin: 15px 0; border-radius: 4px; display: inline-block; width: 48%;">
      <h4 style="color: #2a5298; margin-top: 0; margin-bottom: 12px; border-bottom: 2px solid #2a5298; padding-bottom: 8px;">Dachlatten</h4>
      <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #80deea;">
        <span style="color: #2a5298;">Gesamtlänge:</span>
        <span id="dachlatte-gesamtlaenge" style="font-weight: bold; color: #2a5298;">-</span>
      </div>
      <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #80deea;">
        <span style="color: #2a5298;">Anzahl (Stück):</span>
        <span id="dachlatte-anzahl" style="font-weight: bold; color: #2a5298;">-</span>
      </div>
      <div style="display: flex; justify-content: space-between; padding: 8px 0;">
        <span style="color: #2a5298;">Verschnitt:</span>
        <span id="dachlatte-verschnitt" style="font-weight: bold; color: #2a5298;">-</span>
      </div>
    </div>

    <!-- Print Button -->
    <div style="margin-top: 30px; text-align: center;">
      <button id="print-button" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; border: none; padding: 12px 30px; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: all 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(40, 167, 69, 0.3)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
        🖨️ Drucken
      </button>
    </div>
  </div>

  <InfoBox title="💡 Tipp: Lattenabstand" variant="tip">
    <p><strong>Trapezbleche:</strong> 600-900mm je nach Profiltiefe<br/>
    <strong>Ziegel:</strong> 350-600mm je nach Ziegeltyp<br/>
    <strong>Wellblech:</strong> 500-750mm je nach Wellenprofil</p>
  </InfoBox>

</ToolLayout>

<style>
  .section { background: rgba(255, 255, 255, 0.95); border-radius: 15px; padding: 25px; margin-bottom: 25px; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1); }
  .section h2 { color: #1e3c72; margin-bottom: 20px; font-size: 1.5em; border-bottom: 2px solid #e3f2fd; padding-bottom: 10px; }
  .input-row { display: flex; gap: 20px; margin-bottom: 20px; flex-wrap: wrap; }
  .input-group { flex: 1; min-width: 250px; }
  .input-group label { display: block; margin-bottom: 8px; font-weight: 600; color: #2c3e50; }
  .input-group input { width: 100%; padding: 12px 15px; border: 2px solid #e1e8ed; border-radius: 8px; font-size: 16px; transition: all 0.3s ease; }
  .input-group input:focus { outline: none; border-color: #1e3c72; box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.1); }
  .calculate-btn { background: linear-gradient(135deg, #007bff 0%, #0056b3 100%); color: white; border: none; padding: 15px 30px; border-radius: 12px; font-size: 16px; font-weight: 600; cursor: pointer; margin: 20px auto; display: block; box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3); transition: all 0.3s ease; min-width: 200px; }
  .calculate-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0, 123, 255, 0.4); background: linear-gradient(135deg, #0056b3 0%, #004085 100%); }
  .results { background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); border-radius: 15px; padding: 25px; margin-top: 25px; color: white; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15); }
  .result-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.2); }
  .result-item:last-child { border-bottom: none; }
  .result-item span:last-child { font-weight: bold; font-size: 1.1em; color: #ffd700; }
  #vorschau-svg { background: white; border-radius: 8px; padding: 15px; margin: 20px 0; }
  #vorschau-svg svg { max-width: 100%; height: auto; }
  @media (max-width: 768px) {
    .input-row { flex-direction: column; gap: 12px; }
    .input-group { min-width: auto; }
    #vorschau-svg { padding: 10px; }
  }
</style>

<script>
  // Placeholder für Utility - wird dynamisch geladen
  window.lattenrechner = null;

  // Dach-Parameter aus URL laden mit Retry-Mechanismus
  function ladParameterAusURL(retry = 0) {
    const params = new URLSearchParams(window.location.search);
    console.log(`📍 ladParameterAusURL called (attempt ${retry + 1}). URL:`, window.location.href);
    console.log('📍 URL Params:', Array.from(params.entries()));

    const breiteEl = document.getElementById('breite');
    const hoeheEl = document.getElementById('hoehe');

    // Wenn Elemente nicht gefunden UND noch weniger als 5 Versuche: Retry
    if ((!breiteEl || !hoeheEl) && retry < 5) {
      console.log(`⏳ Elemente nicht gefunden, versuche in ${100 + retry * 50}ms erneut...`);
      setTimeout(() => ladParameterAusURL(retry + 1), 100 + retry * 50);
      return;
    }

    if (params.has('breite')) {
      if (breiteEl) {
        breiteEl.value = parseFloat(params.get('breite')).toFixed(2);
        console.log('✅ Breite gefüllt:', breiteEl.value);
      } else {
        console.log('❌ Breite Element nicht gefunden (nach Retries)');
      }
    } else {
      console.log('⚠️ Breite Parameter nicht in URL');
    }

    if (params.has('hoehe')) {
      if (hoeheEl) {
        hoeheEl.value = parseFloat(params.get('hoehe')).toFixed(2);
        console.log('✅ Hoehe gefüllt:', hoeheEl.value);
      } else {
        console.log('❌ Hoehe Element nicht gefunden (nach Retries)');
      }
    } else {
      console.log('⚠️ Hoehe Parameter nicht in URL');
    }

    // Auto-calculate wenn Parameter vorhanden
    if (params.has('breite') && params.has('hoehe')) {
      console.log('🔄 Auto-berechnen wird aufgerufen...');
      setTimeout(berechnen, 100);
    }
  }

  // Auto-Berechnung: Wenn 2 von 3 Werten eingegeben sind, wird der 3. automatisch berechnet
  function berechneSparrenParameter() {
    const sparrenAnzahlEl = document.getElementById('sparren-anzahl');
    const sparrenAbstandEl = document.getElementById('sparren-abstand');
    const dachueberstandEl = document.getElementById('dachueberstand');
    const breiteEl = document.getElementById('breite');

    if (!sparrenAnzahlEl || !sparrenAbstandEl || !dachueberstandEl || !breiteEl) return;

    const dachBreite = parseFloat(breiteEl.value);
    if (!dachBreite || dachBreite <= 0) return;

    const anzahl = parseFloat(sparrenAnzahlEl.value) || 0;
    const abstand = parseFloat(sparrenAbstandEl.value) || 0;
    const ueberstand = parseFloat(dachueberstandEl.value) || 0;

    // Zähle gefüllte Felder
    let gefuellteFelder = 0;
    if (anzahl > 0 && sparrenAnzahlEl.value.trim() !== '') gefuellteFelder++;
    if (abstand > 0 && sparrenAbstandEl.value.trim() !== '') gefuellteFelder++;
    if (ueberstand >= 0 && dachueberstandEl.value.trim() !== '') gefuellteFelder++;

    // Reset background colors
    [sparrenAnzahlEl, sparrenAbstandEl, dachueberstandEl].forEach(input => {
      if (input.style.backgroundColor === 'rgb(144, 238, 144)' || input.style.backgroundColor === '#90ee90') {
        input.style.backgroundColor = '';
      }
    });

    // Wenn genau 2 Felder gefüllt sind, berechne den 3.
    if (gefuellteFelder === 2) {
      if (anzahl > 0 && abstand > 0 && sparrenAbstandEl.value.trim() !== '' && dachueberstandEl.value.trim() === '') {
        // Berechne Überstand aus Anzahl und Abstand
        const sparrenBreite = (anzahl - 1) * (abstand / 100);
        const neuerUeberstand = ((dachBreite - sparrenBreite) / 2) * 100;
        dachueberstandEl.value = Math.max(0, neuerUeberstand).toFixed(1);
        dachueberstandEl.style.backgroundColor = '#90ee90';
        console.log(`📐 Überstand berechnet: ${dachueberstandEl.value} cm`);
      }
      else if (anzahl > 0 && ueberstand >= 0 && sparrenAnzahlEl.value.trim() !== '' && dachueberstandEl.value.trim() !== '' && sparrenAbstandEl.value.trim() === '') {
        // Berechne Abstand aus Anzahl und Überstand
        const verfuegbareBreite = dachBreite - (2 * ueberstand / 100);
        const neuerAbstand = (verfuegbareBreite / (anzahl - 1)) * 100;
        sparrenAbstandEl.value = neuerAbstand.toFixed(1);
        sparrenAbstandEl.style.backgroundColor = '#90ee90';
        console.log(`📐 Abstand berechnet: ${sparrenAbstandEl.value} cm`);
      }
      else if (abstand > 0 && ueberstand >= 0 && sparrenAbstandEl.value.trim() !== '' && dachueberstandEl.value.trim() !== '' && sparrenAnzahlEl.value.trim() === '') {
        // Berechne Anzahl aus Abstand und Überstand
        const verfuegbareBreite = dachBreite - (2 * ueberstand / 100);
        const neueAnzahl = Math.round((verfuegbareBreite / (abstand / 100)) + 1);
        sparrenAnzahlEl.value = Math.max(2, neueAnzahl);
        sparrenAnzahlEl.style.backgroundColor = '#90ee90';
        console.log(`📐 Anzahl berechnet: ${sparrenAnzahlEl.value}`);
      }
    }
  }

  // Neue Funktion: Befülle die Materialliste
  function zeigeErgebnisse(result) {
    if (!result.counterRafters || !result.roofRafters) {
      console.warn('⚠️ Keine Material-Daten vorhanden');
      return;
    }

    // Zeige Optimierungs-Breakdown
    const optimizationBreakdown = document.getElementById('optimization-breakdown');
    const optimizationDetails = document.getElementById('optimization-details');

    if (optimizationBreakdown && optimizationDetails) {
      const gesamtVerschnitt = (result.counterRafters.waste || 0) + (result.roofRafters.waste || 0);
      const gesamtLaenge = result.counterRafters.totalLength + result.roofRafters.totalLength;
      const verschnittProzent = gesamtLaenge > 0 ? ((gesamtVerschnitt / gesamtLaenge) * 100).toFixed(1) : 0;

      optimizationDetails.innerHTML = `
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;">
          <div style="background: rgba(255, 255, 255, 0.05); padding: 12px; border-radius: 4px;">
            <div style="color: #aaa; font-size: 0.85em; margin-bottom: 5px;">Phase A: Knapsack-Matching</div>
            <div style="color: #ffd700; font-weight: bold; font-size: 1.1em;">✅ Aktiviert</div>
            <div style="color: #ccc; font-size: 0.85em; margin-top: 5px;">Unbegrenzte Kombinationen</div>
          </div>
          <div style="background: rgba(255, 255, 255, 0.05); padding: 12px; border-radius: 4px;">
            <div style="color: #aaa; font-size: 0.85em; margin-bottom: 5px;">Gesamter Verschnitt</div>
            <div style="color: #ffd700; font-weight: bold; font-size: 1.1em;">${gesamtVerschnitt.toFixed(1)} m</div>
            <div style="color: #ccc; font-size: 0.85em; margin-top: 5px;">${verschnittProzent}% der Gesamtlänge</div>
          </div>
        </div>
        <div style="padding-top: 10px; border-top: 1px solid rgba(255, 255, 255, 0.2);">
          <div style="color: #ccc; font-size: 0.9em;">
            💡 <strong>Tipp:</strong> Der Knapsack-Algorithmus testet alle möglichen Kombinationen von Restlatten für jede Reihe,
            um Verschnitt zu minimieren. Dies ist deutlich besser als die vorherige Greedy-Methode!
          </div>
        </div>
      `;
      optimizationBreakdown.style.display = 'block';
    }

    // Konterlatten-Zusammenfassung
    const konterlattenGesamtLaenge = document.getElementById('konterlatte-gesamtlaenge');
    const konterlattenAnzahlEl = document.getElementById('konterlatte-anzahl');
    const konterlattenVerschnitt = document.getElementById('konterlatte-verschnitt');

    if (konterlattenGesamtLaenge) konterlattenGesamtLaenge.textContent = result.counterRafters.totalLength.toFixed(1) + ' m';
    if (konterlattenAnzahlEl) konterlattenAnzahlEl.textContent = result.counterRafters.count + ' Stück';
    if (konterlattenVerschnitt) konterlattenVerschnitt.textContent = (result.counterRafters.waste || 0).toFixed(1) + ' m';

    // Dachlatten-Zusammenfassung
    const dachlattenGesamtLaenge = document.getElementById('dachlatte-gesamtlaenge');
    const dachlattenAnzahlEl = document.getElementById('dachlatte-anzahl');
    const dachlattenVerschnitt = document.getElementById('dachlatte-verschnitt');

    if (dachlattenGesamtLaenge) dachlattenGesamtLaenge.textContent = result.roofRafters.totalLength.toFixed(1) + ' m';
    if (dachlattenAnzahlEl) dachlattenAnzahlEl.textContent = result.roofRafters.count + ' Stück';
    if (dachlattenVerschnitt) dachlattenVerschnitt.textContent = (result.roofRafters.waste || 0).toFixed(1) + ' m';

    // Material-Details Tabelle befüllen
    const tbody = document.getElementById('material-details');
    if (!tbody) {
      console.error('❌ material-details tbody nicht gefunden');
      return;
    }

    tbody.innerHTML = '';

    // Konterlatten-Zeilen
    if (result.counterRafters.materials && Array.isArray(result.counterRafters.materials)) {
      result.counterRafters.materials.forEach(m => {
        const row = document.createElement('tr');
        row.style.borderBottom = '1px solid #ddd';
        row.innerHTML = `
          <td style="padding: 10px; font-weight: bold;">Konterlatten</td>
          <td style="padding: 10px;">${m.length.toFixed(1)} m</td>
          <td style="padding: 10px; text-align: center; color: #333; font-weight: bold;">${m.count}</td>
          <td style="padding: 10px; text-align: right; color: #333; font-weight: bold;">${(m.count * m.length).toFixed(1)} m</td>
        `;
        tbody.appendChild(row);
      });
    }

    // Dachlatten-Zeilen
    if (result.roofRafters.materials && Array.isArray(result.roofRafters.materials)) {
      result.roofRafters.materials.forEach(m => {
        const row = document.createElement('tr');
        row.style.borderBottom = '1px solid #ddd';
        row.innerHTML = `
          <td style="padding: 10px; font-weight: bold;">Dachlatten</td>
          <td style="padding: 10px;">${m.length.toFixed(1)} m</td>
          <td style="padding: 10px; text-align: center; color: #333; font-weight: bold;">${m.count}</td>
          <td style="padding: 10px; text-align: right; color: #333; font-weight: bold;">${(m.count * m.length).toFixed(1)} m</td>
        `;
        tbody.appendChild(row);
      });
    }

    console.log('✅ Materialtabelle befüllt');
  }

  // Neue Funktion: Druckfunktion
  function druckeLattenplan(roofDims, result) {
    if (!roofDims || !result) {
      console.error('❌ Fehlende Parameter für Druck');
      return;
    }

    const dachBreite = roofDims.breite?.toFixed(2) || roofDims.width?.toFixed(2) || 'N/A';
    const dachHoehe = roofDims.hoehe?.toFixed(2) || roofDims.height?.toFixed(2) || 'N/A';
    const dachTyp = roofDims.typ || roofDims.type || 'Rechteck';

    const svgHTML = document.getElementById('vorschau-svg').innerHTML;
    const tableHTML = document.getElementById('material-table').outerHTML;

    const druckInhalt = `
      <!DOCTYPE html>
      <html>
        <head>
          <meta charset="UTF-8">
          <title>Lattenrechner - Druck</title>
          <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }
            body { font-family: Arial, sans-serif; margin: 10px; padding: 10px; color: #333; font-size: 11px; line-height: 1.3; }
            h2 { color: #1e3c72; margin: 5px 0 8px 0; font-size: 14px; border-bottom: 1px solid #1e3c72; padding-bottom: 3px; }
            h3 { color: #1e3c72; margin: 3px 0 5px 0; font-size: 12px; }
            .dach-info { background: #f5f5f5; padding: 8px; border-radius: 3px; margin-bottom: 8px; font-size: 10px; }
            .dach-info p { margin: 2px 0; }
            svg { max-width: 100%; height: auto; max-height: 200px; }
            table { width: 100%; border-collapse: collapse; margin: 5px 0; font-size: 10px; }
            th { background-color: #1e3c72; color: white; padding: 4px 6px; text-align: left; }
            td { padding: 4px 6px; border-bottom: 1px solid #ddd; }
            @page { margin: 10mm; size: A4; }
            @media print {
              body { margin: 5px; padding: 5px; }
              h2 { page-break-after: avoid; margin-bottom: 3px; }
              h3 { page-break-after: avoid; margin-top: 5px; margin-bottom: 2px; }
              svg { page-break-inside: avoid; }
              table { page-break-inside: avoid; }
              .dach-info { page-break-after: avoid; }
            }
          </style>
        </head>
        <body>
          <h2>Lattenrechner - Verlegungsplan</h2>

          <div class="dach-info">
            <p><strong>Dachfläche:</strong> ${dachBreite}m × ${dachHoehe}m | <strong>Typ:</strong> ${dachTyp} | <strong>Datum:</strong> ${new Date().toLocaleDateString('de-DE')}</p>
          </div>

          <h3>Verlegungsplan</h3>
          ${svgHTML}

          <h3>Materialbedarf</h3>
          ${tableHTML}
        </body>
      </html>
    `;

    const druckFenster = window.open('', '_blank');
    druckFenster.document.write(druckInhalt);
    druckFenster.document.close();

    setTimeout(() => {
      druckFenster.print();
    }, 500);
  }

  async function berechnen() {
    const breiteEl = document.getElementById('breite');
    const hoeheEl = document.getElementById('hoehe');
    const sparrenAnzahlEl = document.getElementById('sparren-anzahl');
    const sparrenAbstandEl = document.getElementById('sparren-abstand');
    const dachueberstandEl = document.getElementById('dachueberstand');
    const konterlattenLaengenEl = document.getElementById('konterlatten-laengen');
    const dachlatteLaengenEl = document.getElementById('dachlatten-laengen');
    const lattenabstandEl = document.getElementById('lattenabstand');

    if (!breiteEl || !hoeheEl || !sparrenAnzahlEl || !sparrenAbstandEl ||
        !dachueberstandEl || !konterlattenLaengenEl || !dachlatteLaengenEl ||
        !lattenabstandEl) {
      console.error('Form elements not found');
      return;
    }

    const breite = parseFloat(breiteEl.value);
    const hoehe = parseFloat(hoeheEl.value);
    const sparrenAnzahl = parseInt(sparrenAnzahlEl.value);
    const sparrenAbstand = parseFloat(sparrenAbstandEl.value);
    const dachueberstand = parseFloat(dachueberstandEl.value);
    const lattenabstand = parseFloat(lattenabstandEl.value);

    // Parse verfügbare Längenlisten (komma-getrennt, als Meter)
    const parseLength = (str) => str.split(',').map(s => parseFloat(s.trim())).filter(n => !isNaN(n) && n > 0);
    const konterlattenLaengen = parseLength(konterlattenLaengenEl.value);
    const dachlatteLaengen = parseLength(dachlatteLaengenEl.value);

    // URL-Parameter lesen (für Dachform)
    const urlParams = new URLSearchParams(window.location.search);
    const typ = urlParams.get('typ') || 'rechteck';
    const obereBreite = urlParams.has('obereBreite') ? parseFloat(urlParams.get('obereBreite')) : breite * 0.8;
    const trapezHoehe = urlParams.has('trapezHoehe') ? parseFloat(urlParams.get('trapezHoehe')) : hoehe * 0.4;
    const rechteckHoehe = urlParams.has('rechteckHoehe') ? parseFloat(urlParams.get('rechteckHoehe')) : hoehe * 0.3;
    const spitzenPosition = urlParams.has('spitzenPosition') ? parseFloat(urlParams.get('spitzenPosition')) : breite * 0.5;

    if (!breite || !hoehe || !lattenabstand) {
      alert('Bitte füllen Sie alle erforderlichen Felder aus!');
      return;
    }

    if (konterlattenLaengen.length === 0) {
      alert('Bitte geben Sie verfügbare Konterlatten-Längen an (komma-getrennt)!');
      return;
    }

    if (dachlatteLaengen.length === 0) {
      alert('Bitte geben Sie verfügbare Dachlatten-Längen an (komma-getrennt)!');
      return;
    }

    try {
      // Berechne mit neuem Algorithmus
      const roofDims = {
        width: breite,
        height: hoehe,
        type: typ,
        upperWidth: typ === 'trapez' ? obereBreite : undefined,
        trapezHeight: typ === 'trapez-auf-rechteck' ? trapezHoehe : undefined,
        rectHeight: typ === 'trapez-auf-rechteck' ? rechteckHoehe : undefined,
        spitzenPosition: typ === 'ungleichschenkliges-dreieck' ? spitzenPosition : undefined
      };

      const calcParams = {
        roofDims,
        rafterCount: sparrenAnzahl,
        rafterSpacing: sparrenAbstand, // cm
        overhang: dachueberstand, // cm
        rowSpacing: lattenabstand, // mm
        availableCounters: konterlattenLaengen,
        availableRafters: dachlatteLaengen
      };

      // Lade Utility von Server (wird ca 400-600ms dauern beim ersten Load)
      if (!window.lattenrechner) {
        console.log('⏳ Lade Utility von Server...');
        const response = await fetch('/js-utils/lattenrechner.js');
        if (!response.ok) throw new Error('Utility konnte nicht geladen werden');
        const jsCode = await response.text();
        eval(jsCode);
      }

      if (!window.lattenrechner) {
        throw new Error('Utility konnte nicht initialisiert werden');
      }

      const result = window.lattenrechner.berechne(calcParams);

      // Zeige Ergebnisse
      const flaeche = (breite * hoehe).toFixed(2);
      const flaeche_result = document.getElementById('flaeche-result');
      if (flaeche_result) flaeche_result.textContent = flaeche + ' m²';

      const anzahl_latten = document.getElementById('anzahl-latten');
      if (anzahl_latten) anzahl_latten.textContent = result.roofRafters.count + ' Stück';

      const gesamt_laenge = document.getElementById('gesamt-laenge');
      if (gesamt_laenge) gesamt_laenge.textContent = result.roofRafters.totalLength.toFixed(2) + ' m';

      // Generiere SVG Verlegungsplan
      const svg = window.lattenrechner.generiereVorschau(result, roofDims, calcParams.rafterCount, calcParams.rowSpacing);

      const svgContainer = document.getElementById('vorschau-svg');
      if (svgContainer) {
        if (svg) {
          svgContainer.innerHTML = svg;
          console.log('✅ SVG wurde ins DOM eingefügt');
        } else {
          console.warn('⚠️ SVG-String war leer oder undefined');
        }
      } else {
        console.error('❌ SVG-Container nicht gefunden!');
      }

      // Zeige Ergebnisse
      const resultsDiv = document.getElementById('results');
      if (resultsDiv) resultsDiv.style.display = 'block';

      // Zeige Material-Ergebnisse
      zeigeErgebnisse(result);

      // Speichere Daten für Druckfunktion
      window.currentRoofDims = {
        breite: breite,
        hoehe: hoehe,
        typ: typ
      };
      window.currentResult = result;

      // Google Analytics
      if (typeof gtag !== 'undefined') {
        gtag('event', 'calculation', {
          'event_category': 'lattenrechner',
          'event_label': 'form_submitted'
        });
      }
    } catch (error) {
      console.error('Berechnung fehlgeschlagen:', error);
      alert('Ein Fehler bei der Berechnung ist aufgetreten: ' + error.message);
    }
  }

  // Expose berechnen to window for button onclick
  window.berechnen = berechnen;
  window.ladParameterAusURL = ladParameterAusURL;

  // Event-Listener für Auto-Berechnung der Sparren-Parameter
  const sparrenAnzahlEl = document.getElementById('sparren-anzahl');
  const sparrenAbstandEl = document.getElementById('sparren-abstand');
  const dachueberstandEl = document.getElementById('dachueberstand');
  const breiteEl = document.getElementById('breite');

  [sparrenAnzahlEl, sparrenAbstandEl, dachueberstandEl, breiteEl].forEach(input => {
    if (input) {
      input.addEventListener('input', berechneSparrenParameter);
      input.addEventListener('change', berechneSparrenParameter);
    }
  });

  // Verknüpfe Button
  const button = document.getElementById('lattenrechner-button');
  if (button) {
    button.addEventListener('click', berechnen);
  }

  // Print-Button Event-Listener
  const printButton = document.getElementById('print-button');
  if (printButton) {
    printButton.addEventListener('click', () => {
      if (window.currentRoofDims && window.currentResult) {
        druckeLattenplan(window.currentRoofDims, window.currentResult);
      } else {
        alert('Bitte führen Sie zuerst eine Berechnung durch!');
      }
    });
  }

  // Mehrfache Trigger-Punkte für maximale Kompatibilität
  console.log('🚀 Script initialisiert. DOMContentLoaded state:', document.readyState);

  // Sofort versuchen (mit Retries falls Elemente fehlen)
  ladParameterAusURL();

  // Load event
  window.addEventListener('load', () => {
    console.log('📌 window.load event fired');
    ladParameterAusURL();
  });

  // DOMContentLoaded
  document.addEventListener('DOMContentLoaded', () => {
    console.log('📌 DOMContentLoaded event fired');
    ladParameterAusURL();
  });

  // Visibility Change (für Astro View Transitions)
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) {
      console.log('📌 Seite wurde sichtbar (visibilitychange)');
      ladParameterAusURL();
    }
  });
</script>
