---
import ToolLayout from '../../layouts/ToolLayout.astro';
import InfoBox from '../../components/InfoBox.astro';
import AdUnit from '../../components/AdUnit.astro';
import * as lattenrechner from '../../utils/lattenrechner';
---

<ToolLayout
  title="Lattenrechner – Dachlatten und Konterlatten berechnen"
  description="Berechne Dachlatten und Konterlatten für deine Dachkonstruktion. Mit Materialbedarf und Verschnitt-Optimierung."
  keywords="Lattenrechner, Dachlatten berechnen, Konterlatten, Dachkonstruktion, Lattung"
  navTitle="Lattenrechner"
  backHref="/tools/dachformen/"
  backLabel="← Dachformen"
  background="url('/images/lattung.png')"
>
  <InfoBox title="Was sind Dachlatten und Konterlatten?" icon="🔨">
    <p>Die Lattung ist ein kritischer Teil der Dachkonstruktion. Sie trägt die Dacheindeckung (Trapezbleche, Ziegel, Wellblech) und sorgt zusammen mit der Hinterlüftung für Langlebigkeit.</p>
    <ul style="margin-top: 10px;">
      <li><strong>Konterlatten:</strong> Laufen parallel zu den Sparren (meist 30×50mm oder 40×60mm), schaffen Hinterlüftungsraum</li>
      <li><strong>Dachlatten:</strong> Laufen senkrecht zu den Sparren (meist 30×40mm), halten die Blech- oder Ziegelplatten</li>
    </ul>
  </InfoBox>

  <div class="section">
    <h2>1. Dachflächenabmessungen</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="breite">Breite (m)</label>
        <input type="number" id="breite" step="0.01" min="0" placeholder="z.B. 10.00">
      </div>
      <div class="input-group">
        <label for="hoehe">Höhe / Länge (m)</label>
        <input type="number" id="hoehe" step="0.01" min="0" placeholder="z.B. 8.00">
      </div>
    </div>
  </div>

  <div class="section">
    <h2>2. Sparren & Konterlatten</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="sparren-anzahl">Anzahl Sparren</label>
        <input type="number" id="sparren-anzahl" step="1" min="2" value="8" placeholder="z.B. 8">
      </div>
      <div class="input-group">
        <label for="sparren-abstand">Sparren-Abstand (cm)</label>
        <input type="number" id="sparren-abstand" step="10" min="50" value="80" placeholder="z.B. 80">
      </div>
      <div class="input-group">
        <label for="dachueberstand">Dachüberstand (cm)</label>
        <input type="number" id="dachueberstand" step="5" min="0" value="30" placeholder="z.B. 30">
      </div>
    </div>
  </div>

  <AdUnit position="middle" />

  <div class="section">
    <h2>3. Verfügbare Längenlisten</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="konterlatten-laengen">Konterlatten-Längen (m, komma-getrennt)</label>
        <input type="text" id="konterlatten-laengen" value="3, 4, 5, 6" placeholder="z.B. 3, 4, 5, 6">
      </div>
      <div class="input-group">
        <label for="dachlatten-laengen">Dachlatten-Längen (m, komma-getrennt)</label>
        <input type="text" id="dachlatten-laengen" value="3, 4, 5, 6" placeholder="z.B. 3, 4, 5, 6">
      </div>
    </div>
  </div>

  <div class="section">
    <h2>4. Lattenabstand</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="lattenabstand">Lattenabstand (mm, Mitte zu Mitte)</label>
        <input type="number" id="lattenabstand" step="10" min="100" value="600" placeholder="z.B. 600">
      </div>
    </div>
  </div>

  <button class="calculate-btn" id="lattenrechner-button">Berechnen</button>

  <div id="results" class="results" style="display: none;">
    <h3 style="text-align: center; margin-bottom: 20px; color: #ffd700;">Verlegungsplan & Materialberechnung</h3>

    <!-- SVG Visualization -->
    <div id="vorschau-svg" style="margin-bottom: 30px; text-align: center;"></div>

    <!-- Material-Ergebnisse -->
    <div class="result-item">
      <span>Dachfläche:</span>
      <span id="flaeche-result">-</span>
    </div>
    <div class="result-item">
      <span>Anzahl Latten:</span>
      <span id="anzahl-latten">-</span>
    </div>
    <div class="result-item">
      <span>Gesamtlänge (Laufmeter):</span>
      <span id="gesamt-laenge">-</span>
    </div>
  </div>

  <InfoBox title="💡 Tipp: Lattenabstand" variant="tip">
    <p><strong>Trapezbleche:</strong> 600-900mm je nach Profiltiefe<br/>
    <strong>Ziegel:</strong> 350-600mm je nach Ziegeltyp<br/>
    <strong>Wellblech:</strong> 500-750mm je nach Wellenprofil</p>
  </InfoBox>

</ToolLayout>

<style>
  .section { background: rgba(255, 255, 255, 0.95); border-radius: 15px; padding: 25px; margin-bottom: 25px; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1); }
  .section h2 { color: #1e3c72; margin-bottom: 20px; font-size: 1.5em; border-bottom: 2px solid #e3f2fd; padding-bottom: 10px; }
  .input-row { display: flex; gap: 20px; margin-bottom: 20px; flex-wrap: wrap; }
  .input-group { flex: 1; min-width: 250px; }
  .input-group label { display: block; margin-bottom: 8px; font-weight: 600; color: #2c3e50; }
  .input-group input { width: 100%; padding: 12px 15px; border: 2px solid #e1e8ed; border-radius: 8px; font-size: 16px; transition: all 0.3s ease; }
  .input-group input:focus { outline: none; border-color: #1e3c72; box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.1); }
  .calculate-btn { background: linear-gradient(135deg, #007bff 0%, #0056b3 100%); color: white; border: none; padding: 15px 30px; border-radius: 12px; font-size: 16px; font-weight: 600; cursor: pointer; margin: 20px auto; display: block; box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3); transition: all 0.3s ease; min-width: 200px; }
  .calculate-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0, 123, 255, 0.4); background: linear-gradient(135deg, #0056b3 0%, #004085 100%); }
  .results { background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); border-radius: 15px; padding: 25px; margin-top: 25px; color: white; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15); }
  .result-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.2); }
  .result-item:last-child { border-bottom: none; }
  .result-item span:last-child { font-weight: bold; font-size: 1.1em; color: #ffd700; }
  #vorschau-svg { background: white; border-radius: 8px; padding: 15px; margin: 20px 0; }
  #vorschau-svg svg { max-width: 100%; height: auto; }
  @media (max-width: 768px) {
    .input-row { flex-direction: column; gap: 12px; }
    .input-group { min-width: auto; }
    #vorschau-svg { padding: 10px; }
  }
</style>

<script type="module">
  // Import der Utility
  import * as lattenrechner from '../../utils/lattenrechner.ts';

  window.lattenrechner = lattenrechner;

  // Dach-Parameter aus URL laden
  function ladParameterAusURL() {
    const params = new URLSearchParams(window.location.search);
    console.log('📍 ladParameterAusURL called. URL:', window.location.href);
    console.log('📍 URL Params:', Array.from(params.entries()));

    if (params.has('breite')) {
      const breiteEl = document.getElementById('breite');
      if (breiteEl) {
        breiteEl.value = parseFloat(params.get('breite')).toFixed(2);
        console.log('✅ Breite gefüllt:', breiteEl.value);
      } else {
        console.log('❌ Breite Element nicht gefunden');
      }
    } else {
      console.log('⚠️ Breite Parameter nicht in URL');
    }

    if (params.has('hoehe')) {
      const hoeheEl = document.getElementById('hoehe');
      if (hoeheEl) {
        hoeheEl.value = parseFloat(params.get('hoehe')).toFixed(2);
        console.log('✅ Hoehe gefüllt:', hoeheEl.value);
      } else {
        console.log('❌ Hoehe Element nicht gefunden');
      }
    } else {
      console.log('⚠️ Hoehe Parameter nicht in URL');
    }

    // Auto-calculate wenn Parameter vorhanden
    if (params.has('breite') && params.has('hoehe')) {
      console.log('🔄 Auto-berechnen wird aufgerufen...');
      setTimeout(berechnen, 100);
    }
  }

  function berechnen() {
    const breiteEl = document.getElementById('breite');
    const hoeheEl = document.getElementById('hoehe');
    const sparrenAnzahlEl = document.getElementById('sparren-anzahl');
    const sparrenAbstandEl = document.getElementById('sparren-abstand');
    const dachueberstandEl = document.getElementById('dachueberstand');
    const konterlattenLaengenEl = document.getElementById('konterlatten-laengen');
    const dachlatteLaengenEl = document.getElementById('dachlatten-laengen');
    const lattenabstandEl = document.getElementById('lattenabstand');

    if (!breiteEl || !hoeheEl || !sparrenAnzahlEl || !sparrenAbstandEl ||
        !dachueberstandEl || !konterlattenLaengenEl || !dachlatteLaengenEl ||
        !lattenabstandEl) {
      console.error('Form elements not found');
      return;
    }

    const breite = parseFloat(breiteEl.value);
    const hoehe = parseFloat(hoeheEl.value);
    const sparrenAnzahl = parseInt(sparrenAnzahlEl.value);
    const sparrenAbstand = parseFloat(sparrenAbstandEl.value);
    const dachueberstand = parseFloat(dachueberstandEl.value);
    const lattenabstand = parseFloat(lattenabstandEl.value);

    // Parse verfügbare Längenlisten (komma-getrennt, als Meter)
    const parseLength = (str) => str.split(',').map(s => parseFloat(s.trim())).filter(n => !isNaN(n) && n > 0);
    const konterlattenLaengen = parseLength(konterlattenLaengenEl.value);
    const dachlatteLaengen = parseLength(dachlatteLaengenEl.value);

    // URL-Parameter lesen (für Dachform)
    const urlParams = new URLSearchParams(window.location.search);
    const typ = urlParams.get('typ') || 'rechteck';
    const obereBreite = urlParams.has('obereBreite') ? parseFloat(urlParams.get('obereBreite')) : breite * 0.8;
    const trapezHoehe = urlParams.has('trapezHoehe') ? parseFloat(urlParams.get('trapezHoehe')) : hoehe * 0.4;
    const rechteckHoehe = urlParams.has('rechteckHoehe') ? parseFloat(urlParams.get('rechteckHoehe')) : hoehe * 0.3;
    const spitzenPosition = urlParams.has('spitzenPosition') ? parseFloat(urlParams.get('spitzenPosition')) : breite * 0.5;

    if (!breite || !hoehe || !lattenabstand) {
      alert('Bitte füllen Sie alle erforderlichen Felder aus!');
      return;
    }

    if (konterlattenLaengen.length === 0) {
      alert('Bitte geben Sie verfügbare Konterlatten-Längen an (komma-getrennt)!');
      return;
    }

    if (dachlatteLaengen.length === 0) {
      alert('Bitte geben Sie verfügbare Dachlatten-Längen an (komma-getrennt)!');
      return;
    }

    try {
      // Berechne mit neuem Algorithmus
      const roofDims = {
        width: breite,
        height: hoehe,
        type: typ,
        upperWidth: typ === 'trapez' ? obereBreite : undefined,
        trapezHeight: typ === 'trapez-auf-rechteck' ? trapezHoehe : undefined,
        rectHeight: typ === 'trapez-auf-rechteck' ? rechteckHoehe : undefined,
        spitzenPosition: typ === 'ungleichschenkliges-dreieck' ? spitzenPosition : undefined
      };

      const calcParams = {
        roofDims,
        rafterCount: sparrenAnzahl,
        rafterSpacing: sparrenAbstand, // cm
        overhang: dachueberstand, // cm
        rowSpacing: lattenabstand, // mm
        availableCounters: konterlattenLaengen,
        availableRafters: dachlatteLaengen
      };

      const result = lattenrechner.berechne(calcParams);

      // Zeige Ergebnisse
      const flaeche = (breite * hoehe).toFixed(2);
      const flaeche_result = document.getElementById('flaeche-result');
      if (flaeche_result) flaeche_result.textContent = flaeche + ' m²';

      const anzahl_latten = document.getElementById('anzahl-latten');
      if (anzahl_latten) anzahl_latten.textContent = result.roofRafters.count + ' Stück';

      const gesamt_laenge = document.getElementById('gesamt-laenge');
      if (gesamt_laenge) gesamt_laenge.textContent = result.roofRafters.totalLength.toFixed(2) + ' m';

      // Generiere SVG Verlegungsplan
      const svg = lattenrechner.generiereVorschau(result, roofDims, calcParams.rafterCount);

      const svgContainer = document.getElementById('vorschau-svg');
      if (svgContainer) {
        svgContainer.innerHTML = svg;
      }

      // Zeige Ergebnisse
      const resultsDiv = document.getElementById('results');
      if (resultsDiv) resultsDiv.style.display = 'block';

      // Google Analytics
      if (typeof gtag !== 'undefined') {
        gtag('event', 'calculation', {
          'event_category': 'lattenrechner',
          'event_label': 'form_submitted'
        });
      }
    } catch (error) {
      console.error('Berechnung fehlgeschlagen:', error);
      alert('Ein Fehler bei der Berechnung ist aufgetreten: ' + error.message);
    }
  }

  // Expose berechnen to window for button onclick
  window.berechnen = berechnen;
  window.ladParameterAusURL = ladParameterAusURL;

  // Verknüpfe Button
  const button = document.getElementById('lattenrechner-button');
  if (button) {
    button.addEventListener('click', berechnen);
  }

  // Laden bei Seiten-Load (oder sofort, falls schon geladen)
  window.addEventListener('load', ladParameterAusURL);

  // Fallback: Sofort versuchen zu laden (für Fast Navigation)
  console.log('🚀 Script initialisiert. DOMContentLoaded state:', document.readyState);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', ladParameterAusURL);
  } else {
    // DOM ist bereits geladen, starte sofort
    ladParameterAusURL();
  }
</script>
