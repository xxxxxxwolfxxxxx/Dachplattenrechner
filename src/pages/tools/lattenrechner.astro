    console.log(`📐 DachformTyp gelesen: typ="${typ}" (from element value)`);

    const obereBreiteEl = document.getElementById('obere-breite');
    const obereBreite = obereBreiteEl && obereBreiteEl.value ? parseFloat(obereBreiteEl.value) : breite * 0.8;

    const trapezHoeheEl = document.getElementById('trapez-hoehe-tar');
    const trapezHoehe = trapezHoeheEl && trapezHoeheEl.value ? parseFloat(trapezHoeheEl.value) : hoehe * 0.4;

    const rechteckHoeheEl = document.getElementById('rechteck-hoehe');
    const rechteckHoehe = rechteckHoeheEl && rechteckHoeheEl.value ? parseFloat(rechteckHoeheEl.value) : hoehe * 0.3;

    const dreieckHoeheEl = document.getElementById('dreieck-hoehe');
    const dreieckHoehe = dreieckHoeheEl && dreieckHoeheEl.value ? parseFloat(dreieckHoeheEl.value) : hoehe * 0.4;

    // Lese Dreieck-Typ von Radio-Buttons ZUERST
    let dreieckTyp = 'gleichschenkliges';
    if (typ === 'dreieck') {
      const selectedDreieck = document.querySelector('input[name="dreieck-typ-select"]:checked');
      if (selectedDreieck) {
        dreieckTyp = selectedDreieck.value;
      }
    } else if (typ === 'dreieck-auf-rechteck') {
      const selectedDreieck = document.querySelector('input[name="dreieck-auf-rechteck-typ"]:checked');
      if (selectedDreieck) {
        dreieckTyp = selectedDreieck.value;
      }
    } else if (typ === 'ungleichschenkliges-dreieck') {
      dreieckTyp = 'ungleichschenkliges';
    }

    // Lese Spitzenposition von Input-Feldern oder URL (für ungleichschenklige Dreiecke)
    let spitzenPosition = 0.5; // Default: 50% (center) als Dezimal
    const spitzenPosEl = document.getElementById('spitzen-pos');
