        spitzenPosValue = parseFloat(spitzenPosDarEl.value);
        source = 'form element spitzen-pos-dar';
      } else {
        // Fallback: Versuche von URL-Parametern zu lesen
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('spitzenPosition')) {
          spitzenPosValue = parseFloat(urlParams.get('spitzenPosition'));
          source = 'URL parameter spitzenPosition';
          console.log(`✅ spitzenPosition read from URL: ${spitzenPosValue}`);
        }
      }

      spitzenPosition = spitzenPosValue / breite; // Convert to decimal (0-1)
      console.log(`🔍 Spitzenposition (${source}): ${spitzenPosValue}m (${(spitzenPosition * 100).toFixed(1)}% von ${breite}m)`);
