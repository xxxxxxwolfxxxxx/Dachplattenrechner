---
import ToolLayout from '../../layouts/ToolLayout.astro';
import InfoBox from '../../components/InfoBox.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<ToolLayout
  title="Ungleichschenkliges Dreieck – Trapezplatten berechnen"
  description="Berechnen Sie Trapezbleche für ungleichschenklige Dreiecksflächen. Ideal für asymmetrische Giebel und schiefe Dachformen mit Schnittliste."
  keywords="Trapezblech asymmetrisch berechnen, schiefes Dach Blech, Giebelfläche Profilblech, Dachblech Schnittliste, Blechdach ungleich, Trapezprofil kaufen"
  navTitle="Ungleichschenkliges Dreieck"
  backHref="/tools/dachformen/"
  backLabel="← Dachformen"
  background="url('/images/ungleichschenkliges-dreieck.png')"
>
  <InfoBox title="Wann verwende ich diesen Rechner?" icon="📐">
    <p>Dieser Rechner eignet sich für <strong>asymmetrische Dreiecksflächen</strong> wie:</p>
    <ul>
      <li>Schiefe Giebeldreiecke mit versetzter Spitze</li>
      <li>Asymmetrische Dachflächen</li>
      <li>Dreiecke mit unterschiedlich langen Schenkeln</li>
    </ul>
    <p>Die Spitze liegt <em>nicht</em> zwingend in der Mitte. Sie können entweder die Kantenlängen oder die Spitzen-Position + Höhe eingeben.</p>
  </InfoBox>

  <div style="text-align: center; margin-bottom: 30px;">
    <div style="display: inline-block; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(148, 163, 184, 0.15); border-radius: 12px; padding: 20px;">
      <svg width="250" height="160" viewBox="0 0 250 160" style="margin-bottom: 15px;">
        <polygon points="100,15 30,130 200,130" fill="rgba(14, 165, 233, 0.15)" stroke="#0ea5e9" stroke-width="2"/>
        <line x1="45" y1="130" x2="45" y2="110" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="60" y1="130" x2="60" y2="90" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="75" y1="130" x2="75" y2="68" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="90" y1="130" x2="90" y2="40" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="100" y1="130" x2="100" y2="15" stroke="#dc3545" stroke-width="2" opacity="0.9"/>
        <line x1="115" y1="130" x2="115" y2="35" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="130" y1="130" x2="130" y2="55" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="145" y1="130" x2="145" y2="75" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="160" y1="130" x2="160" y2="90" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="175" y1="130" x2="175" y2="105" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <circle cx="100" cy="15" r="3" fill="#dc3545"/>
        <text x="110" y="20" font-size="10" fill="#dc3545" font-weight="bold">Spitze</text>
        <text x="65" y="62" font-size="10" fill="#0ea5e9" font-weight="bold" text-anchor="middle" transform="rotate(-58 65 62)">Linke Kante</text>
        <text x="150" y="62" font-size="10" fill="#0ea5e9" font-weight="bold" text-anchor="middle" transform="rotate(49 150 62)">Rechte Kante</text>
        <line x1="30" y1="145" x2="200" y2="145" stroke="#cbd5e1" stroke-width="1"/>
        <line x1="30" y1="142" x2="30" y2="148" stroke="#cbd5e1" stroke-width="1"/>
        <line x1="200" y1="142" x2="200" y2="148" stroke="#cbd5e1" stroke-width="1"/>
        <text x="115" y="160" text-anchor="middle" font-size="11" fill="#cbd5e1" font-weight="bold">Basis-Breite</text>
        <line x1="15" y1="15" x2="15" y2="130" stroke="#cbd5e1" stroke-width="1"/>
        <line x1="12" y1="15" x2="18" y2="15" stroke="#cbd5e1" stroke-width="1"/>
        <line x1="12" y1="130" x2="18" y2="130" stroke="#cbd5e1" stroke-width="1"/>
        <text x="8" y="75" font-size="11" fill="#cbd5e1" font-weight="bold" transform="rotate(-90 8 75)">Höhe</text>
        <line x1="30" y1="135" x2="100" y2="135" stroke="#ff6b35" stroke-width="2" stroke-dasharray="5,5"/>
        <text x="65" y="125" font-size="9" fill="#ff6b35" font-weight="bold">Spitzen-Position</text>
      </svg>
    </div>
  </div>

  <div class="preview-screenshot">
    <div class="preview-label">📊 So sehen deine Ergebnisse aus:</div>
    <div class="preview-grid">
      <div class="preview-col">
        <img src="/images/preview-ungleichschenkliges-dreieck.png" alt="Berechnungs-Ergebnis" class="preview-img">
        <span class="preview-col-label">Ergebnis & Schnittliste</span>
      </div>
      <div class="preview-col">
        <img src="/images/preview-anrissplan.png" alt="Anrissplan" class="preview-img">
        <span class="preview-col-label">Anrissplan</span>
      </div>
      <div class="preview-col">
        <img src="/images/preview-lattenrechner.png" alt="Lattenrechner" class="preview-img">
        <span class="preview-col-label">Lattenrechner</span>
      </div>
    </div>
  </div>

  <div class="section">
    <h2>1. Dreiecks-Geometrie</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="basis-breite">Basis-Breite (m)</label>
        <input type="number" id="basis-breite" step="0.01" min="0" placeholder="z.B. 12.00">
      </div>
    </div>
    <div class="parameter-switch">
      <button id="btn-kantenlaengen" class="active" onclick="wechsleParameterModus('kantenlaengen')">
        🔹 Kantenlängen eingeben
      </button>
      <button id="btn-position" onclick="wechsleParameterModus('position')">
        📏 Spitzen-Position + Höhe eingeben
      </button>
    </div>
    <div id="kantenlaengen-inputs">
      <div class="input-row">
        <div class="input-group">
          <label for="kante-links">Linke Kantenlänge (m)</label>
          <input type="number" id="kante-links" step="0.01" min="0" placeholder="z.B. 7.50">
        </div>
        <div class="input-group">
          <label for="kante-rechts">Rechte Kantenlänge (m)</label>
          <input type="number" id="kante-rechts" step="0.01" min="0" placeholder="z.B. 9.20">
        </div>
      </div>
      <div class="info-box">
        <strong>💡 Kantenlängen-Modus:</strong> Geben Sie die Längen der beiden schrägen Seiten des Dreiecks ein.
        Die Höhe und Position der Spitze werden automatisch berechnet.
        <br><br>
        <strong>💡 Tipp:</strong> Falls ein Maß fehlt, können Sie es mit unserem
        <a href="https://dreieck-berechnen.de" target="_blank" rel="noopener noreferrer" style="color: var(--accent-blue); font-weight: 600; text-decoration: underline;">Dreiecksrechner</a>
        berechnen – ohne nochmal aufs Dach zu müssen!
      </div>
    </div>
    <div id="position-inputs" style="display: none;">
      <div class="input-row">
        <div class="input-group">
          <label for="spitze-position">Spitzen-Position von links (m)</label>
          <input type="number" id="spitze-position" step="0.01" min="0" placeholder="z.B. 4.50">
        </div>
        <div class="input-group">
          <label for="hoehe">Höhe (m)</label>
          <input type="number" id="hoehe" step="0.01" min="0" placeholder="z.B. 6.00">
        </div>
      </div>
      <div class="info-box">
        <strong>💡 Positions-Modus:</strong> Geben Sie an, wo die Spitze steht und wie hoch das Dreieck ist.
        Die Kantenlängen werden automatisch berechnet.
        <br><br>
        <strong>💡 Tipp:</strong> Falls ein Maß fehlt, können Sie es mit unserem
        <a href="https://dreieck-berechnen.de" target="_blank" rel="noopener noreferrer" style="color: var(--accent-blue); font-weight: 600; text-decoration: underline;">Dreiecksrechner</a>
        berechnen – ohne nochmal aufs Dach zu müssen!
      </div>
    </div>
  </div>

  <AdUnit position="middle" />

  <div class="section">
    <h2>2. Materialangaben</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="deckbreite">Deckbreite (m)</label>
        <input type="number" id="deckbreite" step="0.01" min="0" value="1.00">
      </div>
      <div class="input-group">
        <label for="lieferbreite">Lieferbreite (m)</label>
        <input type="number" id="lieferbreite" step="0.01" min="0" value="1.05">
      </div>
    </div>
  </div>

  <div class="section">
    <h2>3. Verlegerichtung</h2>
    <div style="margin-bottom: 20px;">
      <label style="display: block; margin-bottom: 12px; font-weight: 600; color: var(--text-secondary);">Verlegung von:</label>
      <div class="radio-group">
        <label class="radio-option" onclick="setVerlegerichtung('links')">
          <input type="radio" name="verlegerichtung" value="links" checked style="cursor: pointer;">
          <span style="font-weight: 500;">Links nach Rechts →</span>
        </label>
        <label class="radio-option" onclick="setVerlegerichtung('rechts')">
          <input type="radio" name="verlegerichtung" value="rechts" style="cursor: pointer;">
          <span style="font-weight: 500;">← Rechts nach Links</span>
        </label>
      </div>
    </div>
    <div class="info-box">
      <strong>💡 Wichtig - Wetterseite beachten!</strong><br>
      Die Verlegung sollte so erfolgen, dass die Hauptwindrichtung (meist West) ÜBER die Überlappungen weht.<br><br>
      <strong>⚠️ Ausnahmen:</strong> Bei Pfannenblechen oder Antikondensvlies-beschichteten Platten ist die Verlegerichtung vorgegeben!
    </div>
  </div>

  <button class="calculate-btn" onclick="berechnen()">Berechnen</button>

  <div id="results" class="results" style="display: none;">
    <div class="result-item">
      <span>Überlappung pro Blech:</span>
      <span id="ueberlappung">-</span>
    </div>
    <div class="result-item">
      <span>Berechnete Höhe:</span>
      <span id="hoehe-result">-</span>
    </div>
    <div class="result-item">
      <span>Spitzen-Position von links:</span>
      <span id="spitze-position-result">-</span>
    </div>
    <div class="result-item">
      <span>Berechnete Kantenlängen:</span>
      <span id="hypotenusen-result">-</span>
    </div>
    <div class="result-item">
      <span>Benötigte max. Plattenlänge:</span>
      <span id="benoetigte-plattenlaenge">-</span>
    </div>
    <div class="result-item">
      <span>Benötigte Anzahl Bleche:</span>
      <span id="anzahl-bleche-breite">-</span>
    </div>
    <div class="result-item">
      <span>Gesamtanzahl Bleche:</span>
      <span id="gesamt-bleche">-</span>
    </div>

    <div id="vorschau" style="display: none; margin-top: 25px;">
      <h4 style="color: #ffffff; font-size: 1.2em; margin-bottom: 15px;">Visuelle Vorschau</h4>
      <div style="text-align: center; margin-bottom: 15px;">
        <div id="vorschau-svg"></div>
      </div>
      <div id="vorschau-legende" style="display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; font-size: 13px; margin-bottom: 10px;">
        <div style="display: flex; align-items: center; gap: 6px;">
          <div style="width: 16px; height: 12px; background: #1e3c72; opacity: 0.4; border-radius: 2px;"></div>
          <span>Nutzen</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
          <div style="width: 16px; height: 12px; background: #dc3545; opacity: 0.3; border-radius: 2px;"></div>
          <span>Verschnitt</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
          <div style="width: 16px; height: 12px; background: #28a745; opacity: 0.25; border-radius: 2px;"></div>
          <span>Überlappung</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
          <div style="width: 16px; height: 12px; background: #ffc107; border-radius: 2px;"></div>
          <span>Dachspitze</span>
        </div>
      </div>
    </div>

    <div id="schnittliste" style="display: none;">
      <h4 style="margin-top: 25px; color: #ffffff; font-size: 1.3em;">Schnittliste (pro Dreiecksfläche):</h4>
      <table class="schnitt-table">
        <thead>
          <tr>
            <th>Platte Nr.</th>
            <th>Position von links (m)</th>
            <th>Plattenbreite (m)</th>
            <th>Benötigte Länge (m)</th>
          </tr>
        </thead>
        <tbody id="schnitt-details"></tbody>
      </table>
      <div style="margin-top: 15px; font-size: 14px; color: #cbd5e1; text-align: center;">
        <strong>Verlegung:</strong> <span id="verlege-info">Von links nach rechts, Platten verlaufen vertikal (oben → unten)</span>
      </div>
      <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
        <button class="anriss-btn" onclick="erstelleAnrissplan()">📋 Anrissplan öffnen</button>
        <button class="anriss-btn" onclick="erstelleLattenrechner()" style="background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%); box-shadow: 0 4px 15px rgba(255, 107, 53, 0.3);">🔨 Lattenrechner</button>
        <button class="anriss-btn" onclick="erstellePVRechner()" style="background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%); color:#1a1a1a; box-shadow: 0 4px 15px rgba(247, 151, 30, 0.3);">☀️ PV-Rechner</button>
      </div>
    </div>
  </div>

  <InfoBox title="💡 Tipp: Deckbreite vs. Lieferbreite" variant="tip">
    <p><strong>Deckbreite</strong> = nutzbare Breite des Bleches (z.B. 1,00 m)<br />
    <strong>Lieferbreite</strong> = tatsächliche Breite mit Überlappung (z.B. 1,06 m)</p>
  </InfoBox>

  <InfoBox title="⚠️ Hinweis zur Genauigkeit" variant="warning">
    <p>Alle Ergebnisse dienen als Planungshilfe. Vor der Ausführung bitte von Fachkraft prüfen lassen.</p>
  </InfoBox>

</ToolLayout>

<style>
  .info-box {
    background: rgba(14, 165, 233, 0.1);
    border-left: 4px solid var(--accent-blue);
    padding: 15px;
    border-radius: var(--radius-sm);
    margin-top: 15px;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  @media (max-width: 600px) { .preview-grid { grid-template-columns: 1fr; } }
  @media (max-width: 768px) {
    .parameter-switch { flex-direction: column; }
    .parameter-switch button { width: 100%; }
    .result-item { flex-direction: column; text-align: left; gap: 2px; }
  }
</style>

<script src="/tools-js/ungleichschenkliges-dreieck.js" defer></script>

<script>
  // Lade Parameter aus der URL
  function ladParameterAusURL() {
    const params = new URLSearchParams(window.location.search);
    if (params.has('breite')) {
      const basisInput = document.getElementById('basis-breite');
      if (basisInput) basisInput.value = parseFloat(params.get('breite')).toFixed(2);
    }
    if (params.has('hoehe')) {
      const hoeheInput = document.getElementById('hoehe');
      if (hoeheInput) hoeheInput.value = parseFloat(params.get('hoehe')).toFixed(2);
    }
    // Auto-calculate, falls Parameter vorhanden
    if (params.has('breite') && params.has('hoehe')) {
      setTimeout(berechnen, 100);
    }
  }

  window.addEventListener('load', ladParameterAusURL);
</script>
