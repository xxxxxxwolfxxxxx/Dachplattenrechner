---
import ToolLayout from '../../layouts/ToolLayout.astro';
import InfoBox from '../../components/InfoBox.astro';
import AdUnit from '../../components/AdUnit.astro';
import RechteckCalculator from '../../components/RechteckCalculator.astro';
import EmbedSnippet from '../../components/EmbedSnippet.astro';
---

<ToolLayout
  title="Rechteck / Quadrat – Trapezplatten berechnen"
  description="Berechnen Sie Trapezbleche für rechteckige und quadratische Dachflächen. Ideal für Flachdächer, Garagen, Carports und einfache Pultdächer."
  keywords="Trapezblech Rechteck berechnen, Dachblech Quadrat, Flachdach Trapezblech, Garagen Dach Blech, Trapezprofil Flachdach, Lichtplatte Flachdach, Profilblech kaufen, Wellblech Carport, Stahlblech Dach, Dacheindeckung Blech, Blechdach Schnittliste"
  navTitle="Rechteck / Quadrat"
  backHref="/tools/dachformen/"
  backLabel="← Dachformen"
  background="url('/images/rechteck.png')"
>
  <InfoBox title="Wann verwende ich diesen Rechner?" icon="📐">
    <p>Dieser Rechner eignet sich für <strong>rechteckige und quadratische Dachflächen</strong> wie:</p>
    <ul>
      <li>Flachdächer und Flachdachaufbauten</li>
      <li>Garagen- und Carport-Dächer</li>
      <li>Einfache Pultdächer</li>
      <li>Industriehallen-Dachflächen</li>
    </ul>
    <p>Die einfachste Dachart: Breite × Höhe. Die Bleche verlaufen senkrecht von oben nach unten, alle gleich lang.</p>
  </InfoBox>

  <div style="text-align: center; margin-bottom: 30px;">
    <div style="display: inline-block; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(148, 163, 184, 0.15); border-radius: 12px; padding: 20px;">
      <svg width="250" height="160" viewBox="0 0 250 160" style="margin-bottom: 15px;">
        <rect x="40" y="30" width="170" height="100" fill="rgba(14, 165, 233, 0.15)" stroke="#0ea5e9" stroke-width="2"/>
        <line x1="60" y1="30" x2="60" y2="130" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="80" y1="30" x2="80" y2="130" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="100" y1="30" x2="100" y2="130" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="125" y1="30" x2="125" y2="130" stroke="#dc3545" stroke-width="2" opacity="0.9"/>
        <line x1="150" y1="30" x2="150" y2="130" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="170" y1="30" x2="170" y2="130" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="190" y1="30" x2="190" y2="130" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="40" y1="145" x2="210" y2="145" stroke="#cbd5e1" stroke-width="1"/>
        <line x1="40" y1="142" x2="40" y2="148" stroke="#cbd5e1" stroke-width="1"/>
        <line x1="210" y1="142" x2="210" y2="148" stroke="#cbd5e1" stroke-width="1"/>
        <text x="125" y="160" text-anchor="middle" font-size="11" fill="#cbd5e1" font-weight="bold">Breite</text>
        <line x1="25" y1="30" x2="25" y2="130" stroke="#cbd5e1" stroke-width="1"/>
        <line x1="22" y1="30" x2="28" y2="30" stroke="#cbd5e1" stroke-width="1"/>
        <line x1="22" y1="130" x2="28" y2="130" stroke="#cbd5e1" stroke-width="1"/>
        <text x="18" y="85" font-size="11" fill="#cbd5e1" font-weight="bold" transform="rotate(-90 18 85)">Höhe</text>
      </svg>
    </div>
  </div>

  <div class="preview-screenshot">
    <div class="preview-label">📊 So sehen deine Ergebnisse aus:</div>
    <div class="preview-grid">
      <div class="preview-col">
        <img src="/images/preview-rechteck.png" alt="Berechnungs-Ergebnis" class="preview-img">
        <span class="preview-col-label">Ergebnis & Schnittliste</span>
      </div>
      <div class="preview-col">
        <img src="/images/preview-anrissplan.png" alt="Anrissplan" class="preview-img">
        <span class="preview-col-label">Anrissplan</span>
      </div>
      <div class="preview-col">
        <img src="/images/preview-lattenrechner.png" alt="Lattenrechner" class="preview-img">
        <span class="preview-col-label">Lattenrechner</span>
      </div>
    </div>
  </div>

  <RechteckCalculator>
    <AdUnit slot="after-geometry" position="middle" />
  </RechteckCalculator>

  <InfoBox title="💡 Tipp: Deckbreite vs. Lieferbreite" variant="tip">
    <p><strong>Deckbreite</strong> = nutzbare Breite des Bleches (z.B. 1,00 m)<br />
    <strong>Lieferbreite</strong> = tatsächliche Breite mit Überlappung (z.B. 1,06 m)</p>
  </InfoBox>

  <InfoBox title="⚠️ Hinweis zur Genauigkeit" variant="warning">
    <p>Alle Ergebnisse dienen als Planungshilfe. Vor der Ausführung bitte von Fachkraft prüfen lassen.</p>
  </InfoBox>

  <EmbedSnippet
    slug="rechteck"
    toolPath="/tools/rechteck/"
    toolName="Trapezblech-Rechner (Rechteck)"
    height={900}
  />

</ToolLayout>

<style>
  @media (max-width: 600px) { .preview-grid { grid-template-columns: 1fr; } }
</style>

