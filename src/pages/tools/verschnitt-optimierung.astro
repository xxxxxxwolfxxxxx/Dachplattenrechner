---
import ToolLayout from '../../layouts/ToolLayout.astro';
import InfoBox from '../../components/InfoBox.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<ToolLayout
  title="Verschnitt-Optimierung – Zuschnitte für Trapezbleche optimieren"
  description="Optimiere deine Blechzuschnitte für minimalen Verschnitt. Mit Abfallreduktion und Kostenersparnis."
  keywords="Verschnitt, Blechzuschnitt, Trapezbleche zuschneiden, Materialoptimierung, Abfallreduktion"
  navTitle="Verschnitt-Optimierung"
  backHref="/"
  backLabel="&larr; Übersicht"
  background="linear-gradient(135deg, rgba(30, 60, 114, 0.85) 0%, rgba(42, 82, 152, 0.85) 100%)"
>

  <div class="section">
    <h2>1. Benötigte Längen eingeben</h2>
    <div class="info-box">
      <strong>Eingabe-Hilfe:</strong><br>
      &bull; <strong>Verschiedene Längenangaben:</strong> 1.5m, 150cm, 1500mm, 1,5, 2.3<br>
      &bull; <strong>Wiederholungen:</strong> 100x1.5m, 50x2,3m, 25x150cm<br>
      &bull; <strong>Einheiten:</strong> m, cm, mm (wird automatisch erkannt)<br>
      &bull; <strong>Dezimalzeichen:</strong> Punkt (1.5) oder Komma (1,5) – beides funktioniert!
    </div>

    <div class="input-group">
      <label for="benoetigte-masze">Benötigte Längen (eine pro Zeile)</label>
      <textarea id="benoetigte-masze" rows="8" placeholder="Beispiele für verschiedene Eingaben:
100x1.5m
20x2,3
5x180cm
1x2500mm
3.5
4,2m">100x1.5</textarea>
    </div>
  </div>

  <AdUnit position="top" adSlot="9678418506" />

  <div class="section">
    <h2>2. Verfügbare Lagerlängen auswählen</h2>
    <div class="info-box">
      <strong>Lagerbestand:</strong> Wählen Sie alle verfügbaren Lagerlängen aus.
      Lassen Sie die Anzahl leer für unbegrenzt verfügbar, oder geben Sie eine konkrete Anzahl ein.
    </div>

    <div class="lager-grid">
      <div class="lager-item">
        <input type="checkbox" id="lager-2.0" value="2.0">
        <label for="lager-2.0">2,0m</label>
        <input type="number" id="anzahl-2.0" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-2.5" value="2.5">
        <label for="lager-2.5">2,5m</label>
        <input type="number" id="anzahl-2.5" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-3.0" value="3.0" checked>
        <label for="lager-3.0">3,0m</label>
        <input type="number" id="anzahl-3.0" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-3.1" value="3.1">
        <label for="lager-3.1">3,1m</label>
        <input type="number" id="anzahl-3.1" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-3.5" value="3.5">
        <label for="lager-3.5">3,5m</label>
        <input type="number" id="anzahl-3.5" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-4.0" value="4.0" checked>
        <label for="lager-4.0">4,0m</label>
        <input type="number" id="anzahl-4.0" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-4.5" value="4.5" checked>
        <label for="lager-4.5">4,5m</label>
        <input type="number" id="anzahl-4.5" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-5.0" value="5.0" checked>
        <label for="lager-5.0">5,0m</label>
        <input type="number" id="anzahl-5.0" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-5.5" value="5.5">
        <label for="lager-5.5">5,5m</label>
        <input type="number" id="anzahl-5.5" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-6.0" value="6.0" checked>
        <label for="lager-6.0">6,0m</label>
        <input type="number" id="anzahl-6.0" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-6.5" value="6.5">
        <label for="lager-6.5">6,5m</label>
        <input type="number" id="anzahl-6.5" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-7.0" value="7.0">
        <label for="lager-7.0">7,0m</label>
        <input type="number" id="anzahl-7.0" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-7.5" value="7.5">
        <label for="lager-7.5">7,5m</label>
        <input type="number" id="anzahl-7.5" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-8.0" value="8.0">
        <label for="lager-8.0">8,0m</label>
        <input type="number" id="anzahl-8.0" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-8.5" value="8.5">
        <label for="lager-8.5">8,5m</label>
        <input type="number" id="anzahl-8.5" placeholder="&infin;" min="0">
      </div>
      <div class="lager-item">
        <input type="checkbox" id="lager-9.0" value="9.0">
        <label for="lager-9.0">9,0m</label>
        <input type="number" id="anzahl-9.0" placeholder="&infin;" min="0">
      </div>
    </div>
  </div>

  <div class="section">
    <h2>3. Optimierungseinstellungen</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="optimierung-modus">Optimierungsmodus</label>
        <select id="optimierung-modus">
          <option value="verschnitt">Minimaler Verschnitt (Materialeinsparung)</option>
          <option value="schnitte" selected>Wenigste Schnitte (Zeiteinsparung)</option>
        </select>
      </div>
      <div class="input-group">
        <label for="schnittblatt-breite">Schnittblattbreite (mm)</label>
        <input type="number" id="schnittblatt-breite" value="3.0" step="0.1" min="0">
      </div>
    </div>
    <div class="input-row">
      <div class="input-group">
        <label for="toleranz">Toleranz pro Platte (mm)</label>
        <input type="number" id="toleranz" value="5.0" step="0.1" min="0">
      </div>
      <div class="input-group"></div>
    </div>
  </div>

  <button class="calculate-btn" onclick="berechneOptimierung()">Optimierung berechnen</button>

  <div id="results" class="results" style="display: none;">
    <h3>Optimierungsergebnisse</h3>

    <div class="result-item">
      <span>Benötigte Lagerplatten:</span>
      <span id="lager-anzahl">-</span>
    </div>
    <div class="result-item">
      <span>Gesamtmaterial eingekauft:</span>
      <span id="gesamt-material">-</span>
    </div>
    <div class="result-item">
      <span>Tatsächlich benötigtes Material:</span>
      <span id="nutzen-material">-</span>
    </div>
    <div class="result-item">
      <span>Gesamtverschnitt:</span>
      <span id="gesamt-verschnitt">-</span>
    </div>
    <div class="result-item">
      <span>Gesamtanzahl Schnitte:</span>
      <span id="gesamt-schnitte">-</span>
    </div>
    <div class="result-item">
      <span>Materialeffizienz:</span>
      <span id="effizienz">-</span>
    </div>

    <div id="saegeplan">
      <div class="saegeplan-header">
        <h4>Detaillierter Sägeplan</h4>
        <button onclick="druckeSaegeplan()" class="print-button">
          Sägeplan drucken
        </button>
      </div>

      <div id="druckbarer-saegeplan">
        <div class="table-container">
          <table class="schnitt-table">
            <thead>
              <tr>
                <th>Platte Nr.</th>
                <th>Lagerlänge</th>
                <th>Zu sägende Längen</th>
                <th>Verschnitt</th>
                <th>Anzahl Schnitte</th>
              </tr>
            </thead>
            <tbody id="saegeplan-details">
            </tbody>
          </table>
        </div>

        <div id="verschnitt-optimierung" class="optimization-tip" style="display: none;">
          <h4>Verschnitt-Optimierungstipp</h4>
          <div id="optimierung-text"></div>
        </div>
      </div>
    </div>
  </div>

  <AdUnit position="bottom" adSlot="9678418507" />

  <InfoBox title="Warum Verschnitt optimieren?" variant="tip">
    <p>Jedes Dachblechprojekt erzeugt Abfallschrott. Eine schlecht geplante Zuschnittliste kann zu
    30-40% Verschnitt führen, bei optimierter Planung sinkt dies auf 5-10%. Bei größeren Projekten
    bedeutet das Einsparungen von hunderten Euro.</p>
  </InfoBox>

  <InfoBox title="Hinweis zur Genauigkeit" variant="warning">
    <p>Alle Ergebnisse dienen als Planungshilfe. Vor der Ausführung bitte von Fachkraft prüfen lassen.</p>
  </InfoBox>

</ToolLayout>

<style>
  #benoetigte-masze { font-family: 'Courier New', monospace; resize: vertical; min-height: 200px; background: rgba(15, 23, 42, 0.6); color: var(--text-primary); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 10px 14px; font-size: 0.95rem; width: 100%; }
  #benoetigte-masze::placeholder { color: var(--text-muted); font-style: italic; }
  #benoetigte-masze:focus { outline: none; border-color: var(--accent-blue); box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15); }
  .info-box { background: rgba(14, 165, 233, 0.08); border-left: 4px solid var(--accent-blue); padding: 15px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; color: var(--text-secondary); }
  .info-box strong { color: var(--accent-blue); font-weight: 700; }
  .lager-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; }
  .lager-item { display: flex; align-items: center; gap: 12px; padding: 12px 15px; border-radius: 8px; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); transition: all 0.3s ease; }
  .lager-item:hover { background: rgba(14, 165, 233, 0.08); border-color: var(--accent-blue); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .lager-item input[type="checkbox"] { transform: scale(1.3); accent-color: var(--accent-blue); cursor: pointer; }
  .lager-item label { flex: 1; font-weight: 600; color: var(--text-secondary); cursor: pointer; font-size: 1.05em; }
  .lager-item input[type="number"] { width: 70px; padding: 8px; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: rgba(15, 23, 42, 0.6); color: var(--text-primary); text-align: center; font-weight: 600; }
  .lager-item input[type="number"]:focus { outline: none; border-color: var(--accent-blue); box-shadow: 0 0 0 2px rgba(14, 165, 233, 0.15); }
  .result-item span:first-child { font-weight: 500; }
  .result-item span:last-child { font-weight: bold; font-size: 1.1em; color: var(--accent-blue); }
  .saegeplan-header { display: flex; justify-content: space-between; align-items: center; margin: 25px 0 15px 0; flex-wrap: wrap; gap: 15px; }
  .saegeplan-header h4 { color: var(--text-primary); margin: 0; font-size: 1.3em; font-weight: 700; }
  .print-button { background: linear-gradient(135deg, var(--accent-green), #20c997); color: white; border: none; padding: 12px 24px; border-radius: var(--radius-md); font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3); }
  .print-button:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4); }
  .table-container { overflow-x: auto; border-radius: var(--radius-md); background: rgba(14, 165, 233, 0.05); margin: 15px 0; }
  .optimization-tip { background: rgba(245, 158, 11, 0.1); border: 1px solid var(--accent-orange); padding: 20px; border-radius: 12px; margin-top: 20px; color: var(--text-secondary); }
  .optimization-tip h4 { color: var(--accent-orange); margin-bottom: 15px; font-size: 1.2em; font-weight: 700; }
  .optimization-tip strong { color: var(--accent-blue); font-weight: 700; }
  .optimization-tip em { color: var(--text-muted); font-style: italic; }
  @media (max-width: 768px) {
    .input-row { grid-template-columns: 1fr; gap: 12px; }
    .lager-grid { grid-template-columns: 1fr; gap: 10px; }
    #benoetigte-masze { min-height: 150px; }
    .result-item { flex-direction: column; align-items: flex-start; gap: 4px; }
    .saegeplan-header { flex-direction: column; align-items: stretch; }
    .print-button { width: 100%; }
  }
</style>

<script src="/tools-js/verschnitt-optimierung.js" defer></script>
