---
import ToolLayout from '../../layouts/ToolLayout.astro';
import InfoBox from '../../components/InfoBox.astro';
---

<ToolLayout
  title="PV-Rechner – Solarmodule aufs Dach planen"
  description="Berechnen Sie kostenlos wie viele Solarmodule auf Ihr Dach passen, wie viel kWp Sie installieren können und welchen Jahresertrag Sie erwarten dürfen."
  keywords="PV Rechner, Solaranlage planen, Photovoltaik Dach, Solarmodule berechnen, kWp berechnen, Jahresertrag Photovoltaik, Solarmodule Dachfläche, PV Anlage Planung"
  navTitle="☀️ PV-Rechner"
  backHref="/tools/dachformen/"
  backLabel="← Dachformen"
  background="linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%)"
  adSlot2="2863789525"
  adSlot3="4156689892"
>

  <!-- Dachabmessungen -->
  <div class="section">
    <h2>📐 Dachabmessungen</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="dach-breite">Dachbreite (m)</label>
        <input type="number" id="dach-breite" step="0.1" min="1" placeholder="z. B. 10.0">
      </div>
      <div class="input-group">
        <label for="dach-laenge">Dachlänge / Schräge (m)</label>
        <input type="number" id="dach-laenge" step="0.1" min="1" placeholder="z. B. 6.5">
      </div>
      <div class="input-group">
        <label for="rand-abstand">Randabstand (m)</label>
        <input type="number" id="rand-abstand" step="0.05" min="0" value="0.20">
      </div>
    </div>
  </div>

  <!-- Ausrichtung & Neigung -->
  <div class="section">
    <h2>🧭 Ausrichtung &amp; Neigung</h2>
    <div class="input-row">
      <div class="input-group">
        <label>Himmelsrichtung (Dachfläche zeigt nach…)</label>
        <div class="compass-grid">
          <button class="compass-btn" data-dir="NW">NW</button>
          <button class="compass-btn" data-dir="N">N</button>
          <button class="compass-btn" data-dir="NE">NO</button>
          <button class="compass-btn" data-dir="W">W</button>
          <div class="compass-center">☀️</div>
          <button class="compass-btn" data-dir="E">O</button>
          <button class="compass-btn" data-dir="SW">SW</button>
          <button class="compass-btn active" data-dir="S">S</button>
          <button class="compass-btn" data-dir="SE">SO</button>
        </div>
        <div style="margin-top:8px; font-size:13px; color:#666;">
          <a href="https://maps.google.com" target="_blank" rel="noopener" style="color:#1e3c72;">📍 Google Maps öffnen</a>
          um Ausrichtung zu prüfen
        </div>
      </div>
      <div class="input-group">
        <label for="neigung">Dachneigung: <span id="neigung-wert">30</span>°</label>
        <input type="range" id="neigung" min="5" max="60" value="30" step="1" class="slider">
        <div style="display:flex; justify-content:space-between; font-size:12px; color:#888; margin-top:4px;">
          <span>5° (flach)</span><span>30° (Standard)</span><span>60° (steil)</span>
        </div>
      </div>
      <div class="input-group">
        <label for="region">Region (für Ertragsfaktor)</label>
        <select id="region">
          <option value="sued">Süddeutschland (Bayern, BW) +10%</option>
          <option value="mitte" selected>Mitteldeutschland (Standard)</option>
          <option value="ost">Ostdeutschland −5%</option>
          <option value="west">Westdeutschland (NRW, Rheinland) −3%</option>
          <option value="nord">Norddeutschland −10%</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Modul-Auswahl -->
  <div class="section">
    <h2>🔲 Solarmodul auswählen</h2>
    <div class="module-grid" id="module-grid">
      <button class="module-btn" data-w="1134" data-h="1722" data-watt="410">
        <strong>Halbzellen M10</strong><span>1134 × 1722 mm</span><span class="watt-badge">410 W</span>
      </button>
      <button class="module-btn active" data-w="1038" data-h="2094" data-watt="550">
        <strong>Groß-Modul 72Z</strong><span>1038 × 2094 mm</span><span class="watt-badge">550 W</span>
      </button>
      <button class="module-btn" data-w="1134" data-h="2172" data-watt="600">
        <strong>TOPCon / HJT</strong><span>1134 × 2172 mm</span><span class="watt-badge">600 W</span>
      </button>
      <button class="module-btn" data-w="992" data-h="1956" data-watt="390">
        <strong>Standard 72Z</strong><span>992 × 1956 mm</span><span class="watt-badge">390 W</span>
      </button>
      <button class="module-btn" data-w="992" data-h="1650" data-watt="310">
        <strong>Standard 60Z</strong><span>992 × 1650 mm</span><span class="watt-badge">310 W</span>
      </button>
      <button class="module-btn" data-w="1002" data-h="2008" data-watt="420">
        <strong>Glas-Glas / Rahmenlos</strong><span>1002 × 2008 mm</span><span class="watt-badge">420 W</span>
      </button>
    </div>

    <div class="custom-module-box">
      <strong>Eigenes Modul:</strong>
      <div class="input-row" style="margin-bottom:0; margin-top:12px;">
        <div class="input-group" style="min-width:120px;">
          <label>Breite (mm)</label>
          <input type="number" id="mod-breite" step="1" min="500" max="2000" placeholder="1134">
        </div>
        <div class="input-group" style="min-width:120px;">
          <label>Höhe (mm)</label>
          <input type="number" id="mod-hoehe" step="1" min="500" max="2500" placeholder="1722">
        </div>
        <div class="input-group" style="min-width:100px;">
          <label>Leistung (W)</label>
          <input type="number" id="mod-watt" step="5" min="100" max="1000" placeholder="410">
        </div>
        <div class="input-group" style="min-width:120px;">
          <label>Modul-Abstand (mm)</label>
          <input type="number" id="mod-abstand" step="5" min="0" value="20">
        </div>
      </div>
    </div>

    <div style="margin-top:15px;">
      <label style="font-weight:600;">Modulausrichtung:</label>
      <div class="orient-btns">
        <button class="orient-btn active" data-orient="auto">🔄 Auto (beste Anzahl)</button>
        <button class="orient-btn" data-orient="hoch">📱 Hochformat</button>
        <button class="orient-btn" data-orient="quer">📺 Querformat</button>
      </div>
    </div>
  </div>

  <!-- Hindernisse -->
  <div class="section">
    <h2>🏗️ Hindernisse auf der Dachfläche</h2>
    <p style="color:#555; margin-bottom:15px;">Schornsteine, Dachfenster oder andere Hindernisse, die Platz belegen.</p>
    <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:15px;">
      <button class="add-hindernis-btn" onclick="addHindernis('schornstein')">🏭 Schornstein</button>
      <button class="add-hindernis-btn" onclick="addHindernis('fenster')">🪟 Dachfenster</button>
      <button class="add-hindernis-btn add-clear-btn" onclick="clearHindernisse()">🗑️ Alle löschen</button>
    </div>
    <div id="hindernis-liste" style="display:none; margin-bottom:15px;">
      <table class="material-table" id="hindernis-table">
        <thead><tr><th>Typ</th><th>Breite (m)</th><th>Höhe (m)</th><th>Links (m)</th><th>Oben (m)</th><th></th></tr></thead>
        <tbody id="hindernis-body"></tbody>
      </table>
    </div>
  </div>

  <!-- Hindernis-Modal -->
  <div id="hindernis-modal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
      <h3 id="hindernis-modal-titel">Hindernis hinzufügen</h3>
      <div class="input-row">
        <div class="input-group">
          <label>Breite (m)</label>
          <input type="number" id="h-breite" step="0.1" min="0.1" value="0.5">
        </div>
        <div class="input-group">
          <label>Höhe (m)</label>
          <input type="number" id="h-hoehe" step="0.1" min="0.1" value="0.5">
        </div>
      </div>
      <div class="input-row">
        <div class="input-group">
          <label>Abstand vom linken Rand (m)</label>
          <input type="number" id="h-left" step="0.1" min="0" value="1.0">
        </div>
        <div class="input-group">
          <label>Abstand vom oberen Rand (m)</label>
          <input type="number" id="h-top" step="0.1" min="0" value="1.0">
        </div>
      </div>
      <div style="display:flex; gap:12px; justify-content:center; margin-top:15px;">
        <button class="calculate-btn" style="margin:0; min-width:120px;" onclick="confirmHindernis()">✅ Hinzufügen</button>
        <button class="calculate-btn" style="margin:0; min-width:120px; background:linear-gradient(135deg,#666,#444);" onclick="closeHindernisModal()">Abbrechen</button>
      </div>
    </div>
  </div>

  <!-- Berechnen-Button -->
  <button class="calculate-btn" onclick="berechne()">☀️ PV-Anlage berechnen</button>

  <!-- Ergebnisse -->
  <div id="results" class="results" style="display:none;">
    <h3 style="text-align:center; margin-bottom:25px; color:#ffd700; font-size:1.4em;">Ergebnis – PV-Planung</h3>

    <!-- Kacheln -->
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-wert" id="res-anzahl">–</div>
        <div class="kpi-label">Solarmodule</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-wert" id="res-kwp">–</div>
        <div class="kpi-label">kWp installiert</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-wert" id="res-ertrag">–</div>
        <div class="kpi-label">kWh / Jahr</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-wert" id="res-wert">–</div>
        <div class="kpi-label">€ Wert / Jahr</div>
      </div>
    </div>

    <!-- Detail-Tabelle -->
    <div style="margin-top:25px;">
      <table class="material-table">
        <tbody id="res-details"></tbody>
      </table>
    </div>

    <!-- Canvas-Visualisierung -->
    <div style="margin-top:25px;">
      <h4 style="color:#ffd700; margin-bottom:12px; text-align:center;">Modul-Layout Dachfläche</h4>
      <div style="text-align:center;">
        <canvas id="pv-canvas" style="border-radius:8px; max-width:100%; box-shadow:0 4px 15px rgba(0,0,0,0.3);"></canvas>
      </div>
      <div style="margin-top:10px; display:flex; gap:20px; justify-content:center; flex-wrap:wrap; font-size:13px; color:#cbd5e1;">
        <span><span style="display:inline-block;width:16px;height:16px;background:#2196f3;border-radius:2px;vertical-align:middle;margin-right:4px;"></span>Solarmodul</span>
        <span><span style="display:inline-block;width:16px;height:16px;background:#ef5350;border-radius:2px;vertical-align:middle;margin-right:4px;"></span>Hindernis</span>
        <span><span style="display:inline-block;width:16px;height:16px;background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.3);border-radius:2px;vertical-align:middle;margin-right:4px;"></span>Randabstand</span>
      </div>
    </div>

    <!-- Navigation zu anderen Tools -->
    <div style="margin-top:30px; text-align:center;">
      <p style="color:#cbd5e1; margin-bottom:12px;">Weiter mit anderen Planungswerkzeugen:</p>
      <div style="display:flex; gap:15px; justify-content:center; flex-wrap:wrap;">
        <button onclick="zuLattenrechner()" style="background:linear-gradient(135deg,#ff6b35,#f7931e); color:white; border:none; padding:13px 22px; border-radius:12px; font-size:15px; font-weight:600; cursor:pointer; box-shadow:0 4px 15px rgba(255,107,53,0.3);">🔨 Lattenrechner</button>
        <button onclick="zuVerschnitt()" style="background:linear-gradient(135deg,#28a745,#20c997); color:white; border:none; padding:13px 22px; border-radius:12px; font-size:15px; font-weight:600; cursor:pointer; box-shadow:0 4px 15px rgba(40,167,69,0.3);">✂️ Verschnitt-Optimierung</button>
      </div>
    </div>
  </div>

  <InfoBox title="ℹ️ Hinweise zum PV-Rechner" variant="info">
    <p>Erträge basieren auf Durchschnittswerten (PVGis/BDEW). Tatsächliche Erträge variieren je nach Verschattung, Modulqualität und Wechselrichter-Wirkungsgrad. Die Berechnung ersetzt keine professionelle Planung.</p>
    <p style="margin-top:8px;">Strompreis-Annahme: 0,32 €/kWh (Eigenverbrauch) bzw. 0,082 €/kWh (Einspeisung, EEG 2024 für Anlagen &lt; 10 kWp).</p>
  </InfoBox>

</ToolLayout>

<style>
  .section { background: rgba(255, 255, 255, 0.95); border-radius: 15px; padding: 25px; margin-bottom: 25px; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1); }
  .section h2 { color: #1e3c72; margin-bottom: 20px; font-size: 1.5em; border-bottom: 2px solid #e3f2fd; padding-bottom: 10px; }
  .input-row { display: flex; gap: 20px; margin-bottom: 20px; flex-wrap: wrap; }
  .input-group { flex: 1; min-width: 180px; }
  .input-group label { display: block; margin-bottom: 8px; font-weight: 600; color: #2c3e50; }
  .input-group input, .input-group select { width: 100%; padding: 12px 15px; border: 2px solid #e1e8ed; border-radius: 8px; font-size: 16px; transition: all 0.3s ease; background: white; color: #333; box-sizing: border-box; }
  .input-group input:focus, .input-group select:focus { outline: none; border-color: #1e3c72; box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.1); }
  .slider { -webkit-appearance: none; appearance: none; height: 8px; border-radius: 4px; background: #dde1e7; outline: none; cursor: pointer; }
  .slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 22px; height: 22px; border-radius: 50%; background: #1e3c72; cursor: pointer; }

  /* Kompass */
  .compass-grid { display: grid; grid-template-columns: repeat(3, 48px); gap: 6px; margin-top: 10px; }
  .compass-center { display: flex; align-items: center; justify-content: center; font-size: 20px; }
  .compass-btn { padding: 8px 0; border: 2px solid #1e3c72; border-radius: 8px; background: white; color: #1e3c72; font-weight: 700; font-size: 13px; cursor: pointer; transition: all 0.2s; }
  .compass-btn:hover { background: #e3f2fd; }
  .compass-btn.active { background: #1e3c72; color: white; box-shadow: 0 2px 8px rgba(30,60,114,0.3); }

  /* Modul-Karten */
  .module-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; margin-bottom: 20px; }
  .module-btn { padding: 14px 10px; border: 2px solid #dde1e7; border-radius: 12px; background: white; cursor: pointer; transition: all 0.2s; display: flex; flex-direction: column; gap: 4px; text-align: center; }
  .module-btn span { font-size: 12px; color: #666; }
  .module-btn:hover { border-color: #1e3c72; }
  .module-btn.active { border-color: #1e3c72; background: #e8f0fe; box-shadow: 0 2px 10px rgba(30,60,114,0.2); }
  .watt-badge { background: #ffd700; color: #1a1a1a; border-radius: 20px; padding: 2px 8px; font-weight: 700; font-size: 13px !important; }
  .custom-module-box { background: #f8f9fa; border-radius: 10px; padding: 15px; border: 1px dashed #aaa; }
  .orient-btns { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px; }
  .orient-btn { padding: 10px 18px; border: 2px solid #dde1e7; border-radius: 10px; background: white; cursor: pointer; font-size: 14px; font-weight: 600; transition: all 0.2s; }
  .orient-btn.active { border-color: #1e3c72; background: #e8f0fe; color: #1e3c72; }

  /* Hindernisse */
  .add-hindernis-btn { padding: 10px 18px; border: none; border-radius: 10px; background: linear-gradient(135deg, #1e3c72, #2a5298); color: white; font-weight: 600; cursor: pointer; font-size: 14px; }
  .add-clear-btn { background: linear-gradient(135deg, #666, #444) !important; }

  /* Berechnen-Button */
  .calculate-btn { background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%); color: #1a1a1a; border: none; padding: 15px 40px; border-radius: 12px; font-size: 18px; font-weight: 700; cursor: pointer; margin: 20px auto; display: block; box-shadow: 0 4px 15px rgba(247, 151, 30, 0.4); transition: all 0.3s ease; min-width: 250px; }
  .calculate-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(247, 151, 30, 0.5); }

  /* Ergebnis */
  .results { background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); border-radius: 15px; padding: 25px; margin-top: 25px; color: white; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15); }
  .kpi-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 15px; }
  .kpi-card { background: rgba(255,255,255,0.1); border-radius: 12px; padding: 18px 10px; text-align: center; }
  .kpi-wert { font-size: 1.8em; font-weight: 700; color: #ffd700; }
  .kpi-label { font-size: 13px; color: #cbd5e1; margin-top: 4px; }
  .material-table { width: 100%; border-collapse: collapse; }
  .material-table th, .material-table td { padding: 10px 14px; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.15); }
  .material-table th { background: rgba(255,255,255,0.1); color: #ffd700; font-weight: 600; }
  .material-table td { color: #e8eaf6; }

  /* Modal */
  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1000; display: flex; align-items: center; justify-content: center; }
  .modal-box { background: white; border-radius: 15px; padding: 30px; max-width: 480px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,0.4); }
  .modal-box h3 { color: #1e3c72; margin-bottom: 20px; }
</style>

<script src="/tools-js/pv-rechner.js" is:inline></script>
