---
import ToolLayout from '../../layouts/ToolLayout.astro';
import InfoBox from '../../components/InfoBox.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<ToolLayout
  title="PV-Rechner – Solaranlage für dein Dach berechnen"
  description="Berechne die optimale Größe deiner Solaranlage für dein Dach. Mit Ertrag, Kostenersparnis und Amortisation."
  keywords="PV-Rechner, Solaranlage berechnen, Photovoltaik Dach, Solarertrag, Solaranlage Kosten, Photovoltaik Ertrag, Solaranlage Wirtschaftlichkeit"
  navTitle="PV-Rechner"
  backHref="/tools/dachformen/"
  backLabel="← Dachformen"
  background="linear-gradient(135deg, rgba(30, 60, 114, 0.85) 0%, rgba(42, 82, 152, 0.85) 100%), url('/images/rechteck.png')"
>
  <div class="section">
    <h2>1. Dachform & Geometrie</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="dach-form">Dachform</label>
        <select id="dach-form" style="width: 100%; padding: 12px 15px; border: 2px solid #e1e8ed; border-radius: 8px; font-size: 16px; cursor: pointer;">
          <option value="rechteck">Rechteck</option>
          <option value="gleichschenkliges-dreieck">Gleichschenkliges Dreieck</option>
          <option value="ungleichschenkliges-dreieck">Ungleichschenkliges Dreieck</option>
          <option value="trapez">Trapez</option>
          <option value="dreieck-auf-rechteck">Dreieck auf Rechteck</option>
          <option value="trapez-auf-rechteck">Trapez auf Rechteck</option>
        </select>
      </div>
      <div class="input-group">
        <label for="dach-breite">Dachbreite (m)</label>
        <input type="number" id="dach-breite" step="0.01" min="0" placeholder="z.B. 10.00" value="">
      </div>
      <div class="input-group">
        <label for="dach-hoehe">Dachhöhe/Länge (m)</label>
        <input type="number" id="dach-hoehe" step="0.01" min="0" placeholder="z.B. 8.00" value="">
      </div>
      <div class="input-group" id="dach-breite-oben-group" style="display: none;">
        <label for="dach-breite-oben">Breite oben (m) - für Trapez</label>
        <input type="number" id="dach-breite-oben" step="0.01" min="0" placeholder="z.B. 8.00" value="">
      </div>
    </div>
  </div>

  <div class="section">
    <h2>2. Dachneigung & Ausrichtung</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="neigung">Dachneigung (°)</label>
        <input type="number" id="neigung" step="1" min="0" max="90" value="30">
      </div>
      <div class="input-group">
        <label for="azimuth">Himmelsrichtung (Azimut in °)</label>
        <input type="number" id="azimuth" step="1" min="0" max="359" value="180">
      </div>
      <div class="input-group">
        <label for="region">Deine Region</label>
        <select id="region" style="width: 100%; padding: 12px 15px; border: 2px solid #e1e8ed; border-radius: 8px; font-size: 16px; cursor: pointer;">
          <option value="nord">Nord (Bremen, Schleswig-Holstein)</option>
          <option value="nordost">Nordost (Mecklenburg, Berlin)</option>
          <option value="ost">Ost (Sachsen)</option>
          <option value="mitte" selected>Mitte (NRW, Hessen, Thüringen)</option>
          <option value="suedwest">Südwest (Baden-Württemberg, Rheinland-Pfalz)</option>
          <option value="suedost">Südost (Bayern)</option>
        </select>
      </div>
      <div id="dreieck-typ-group" class="input-group" style="display: none;">
        <label style="font-size: 14px; color: #333; margin-bottom: 8px; font-weight: 600;">Dreieck-Typ</label>
        <div style="display: flex; gap: 10px;">
          <label style="flex: 1;">
            <input type="radio" name="dreieck-typ" value="gleichschenkliges" checked>
            <span>Gleichschenkliges (symmetrisch)</span>
          </label>
          <label style="flex: 1;">
            <input type="radio" name="dreieck-typ" value="ungleichschenkliges">
            <span>Ungleichschenkliges (asymmetrisch)</span>
          </label>
        </div>
      </div>
      <div class="input-group" id="spitze-pos-group" style="display: none;">
        <label for="spitze-pos">Spitzenposition von links (m)</label>
        <input type="number" id="spitze-pos" step="0.1" min="0" placeholder="z.B. 3.00">
      </div>
    </div>
  </div>

  <div class="section">
    <h2>3. Modultyp & Ausrichtung</h2>

    <div style="margin-bottom: 20px;">
      <label style="display: block; font-weight: 600; color: #333; margin-bottom: 12px; font-size: 14px;">Modul-Vorsets:</label>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-bottom: 15px;">
        <button class="module-btn" data-w="1134" data-h="1722" data-watt="410" style="padding: 10px; border: 2px solid #e1e8ed; background: white; border-radius: 8px; cursor: pointer; font-weight: 600; color: #333; transition: all 0.3s ease;">
          Halbzellen M10<br><span style="font-size: 12px; font-weight: normal; color: #666;">410 W</span>
        </button>
        <button class="module-btn" data-w="1038" data-h="2094" data-watt="550" style="padding: 10px; border: 2px solid #e1e8ed; background: white; border-radius: 8px; cursor: pointer; font-weight: 600; color: #333; transition: all 0.3s ease;">
          Groß-Modul 72Z<br><span style="font-size: 12px; font-weight: normal; color: #666;">550 W</span>
        </button>
        <button class="module-btn" data-w="1134" data-h="2172" data-watt="600" style="padding: 10px; border: 2px solid #e1e8ed; background: white; border-radius: 8px; cursor: pointer; font-weight: 600; color: #333; transition: all 0.3s ease;">
          TOPCon / HJT<br><span style="font-size: 12px; font-weight: normal; color: #666;">600 W</span>
        </button>
        <button class="module-btn" data-w="992" data-h="1956" data-watt="390" style="padding: 10px; border: 2px solid #e1e8ed; background: white; border-radius: 8px; cursor: pointer; font-weight: 600; color: #333; transition: all 0.3s ease;">
          Standard 72Z<br><span style="font-size: 12px; font-weight: normal; color: #666;">390 W</span>
        </button>
        <button class="module-btn" data-w="992" data-h="1650" data-watt="310" style="padding: 10px; border: 2px solid #e1e8ed; background: white; border-radius: 8px; cursor: pointer; font-weight: 600; color: #333; transition: all 0.3s ease;">
          Standard 60Z<br><span style="font-size: 12px; font-weight: normal; color: #666;">310 W</span>
        </button>
        <button class="module-btn" data-w="1002" data-h="2008" data-watt="420" style="padding: 10px; border: 2px solid #e1e8ed; background: white; border-radius: 8px; cursor: pointer; font-weight: 600; color: #333; transition: all 0.3s ease;">
          Glas-Glas / Rahmenlos<br><span style="font-size: 12px; font-weight: normal; color: #666;">420 W</span>
        </button>
      </div>
      <button onclick="findeOptimalesFormat()" style="padding: 10px 20px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; margin-bottom: 15px;">
        🔍 Optimales Format finden
      </button>
    </div>

    <div style="background: #f0f4f8; border-left: 4px solid #2196F3; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
      <label style="display: block; font-weight: 600; color: #333; margin-bottom: 12px; font-size: 14px;">Ausrichtung:</label>
      <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <button class="orient-btn" data-orient="hoch" style="flex: 1; min-width: 100px; padding: 10px; border: 2px solid #e1e8ed; background: white; border-radius: 8px; cursor: pointer; font-weight: 600; color: #333; transition: all 0.3s ease;">
          📱 Hochformat
        </button>
        <button class="orient-btn" data-orient="quer" style="flex: 1; min-width: 100px; padding: 10px; border: 2px solid #e1e8ed; background: white; border-radius: 8px; cursor: pointer; font-weight: 600; color: #333; transition: all 0.3s ease;">
          📺 Querformat
        </button>
        <button class="orient-btn active" data-orient="auto" style="flex: 1; min-width: 100px; padding: 10px; border: 2px solid #3b82f6; background: white; border-radius: 8px; cursor: pointer; font-weight: 600; color: #3b82f6; transition: all 0.3s ease;">
          ⚙️ Auto
        </button>
      </div>
    </div>

    <div style="background: #fef3c7; border-left: 4px solid #f59e0b; padding: 15px; border-radius: 8px;">
      <label style="display: block; font-weight: 600; color: #92400e; margin-bottom: 12px; font-size: 14px;">Benutzerdefiniertes Modul:</label>
      <div class="input-row">
        <div class="input-group">
          <label for="mod-breite">Breite (mm)</label>
          <input type="number" id="mod-breite" step="1" min="0" placeholder="z.B. 1000">
        </div>
        <div class="input-group">
          <label for="mod-hoehe">Höhe (mm)</label>
          <input type="number" id="mod-hoehe" step="1" min="0" placeholder="z.B. 2000">
        </div>
        <div class="input-group">
          <label for="mod-watt">Leistung (W)</label>
          <input type="number" id="mod-watt" step="1" min="0" placeholder="z.B. 550">
        </div>
      </div>
    </div>
  </div>

  <div class="section">
    <h2>4. Stromverbrauch & Wirtschaftlichkeit</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="eigenverbrauch-rate">Eigenverbrauchsquote (%)</label>
        <input type="number" id="eigenverbrauch-rate" step="1" min="0" max="100" value="30">
      </div>
      <div class="input-group">
        <label for="strompreis">Strompreis (€/kWh)</label>
        <input type="number" id="strompreis" step="0.01" min="0" value="0.32">
      </div>
      <div class="input-group">
        <label for="einspeisung-preis">Einspeisevergütung (€/kWh)</label>
        <input type="number" id="einspeisung-preis" step="0.01" min="0" value="0.082">
      </div>
    </div>
  </div>

  <div class="section">
    <h2>5. Speicher & Weitere Einstellungen</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="rand-abstand">Rand-Abstand (m)</label>
        <input type="number" id="rand-abstand" step="0.05" min="0" value="0.2">
      </div>
      <div class="input-group">
        <label for="mod-abstand">Modul-Abstand (mm)</label>
        <input type="number" id="mod-abstand" step="1" min="0" value="20">
      </div>
    </div>

    <div style="background: #f0f4f8; border-left: 4px solid #2196F3; padding: 15px; border-radius: 8px; margin: 20px 0;">
      <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; margin-bottom: 10px;">
        <input type="checkbox" id="batterie-aktiv" style="width: 20px; height: 20px; cursor: pointer;">
        <span style="font-weight: 600; color: #1e3c72;">Speicherbatterie hinzufügen?</span>
      </label>

      <div id="batterie-box" style="display: none; margin-top: 15px; padding-top: 15px; border-top: 1px solid #ccc;">
        <div class="input-row">
          <div class="input-group">
            <label for="batterie-kwh">Speicher-Größe (kWh)</label>
            <input type="number" id="batterie-kwh" step="0.5" min="0" value="10">
          </div>
          <div class="input-group">
            <label style="font-size: 13px; color: #666;">Kosten-Option:</label>
            <div style="display: flex; gap: 10px;">
              <label style="flex: 1;">
                <input type="radio" name="batterie-price-mode" value="kwh" checked>
                <span>€/kWh</span>
              </label>
              <label style="flex: 1;">
                <input type="radio" name="batterie-price-mode" value="gesamt">
                <span>Gesamtpreis</span>
              </label>
            </div>
          </div>
        </div>

        <div class="input-row">
          <div class="input-group" id="batterie-preis-kwh-group">
            <label for="batterie-preis-kwh">Preis pro kWh (€)</label>
            <input type="number" id="batterie-preis-kwh" step="10" min="0" value="650">
          </div>
          <div class="input-group" id="batterie-preis-gesamt-group" style="display: none;">
            <label for="batterie-preis-gesamt">Gesamtpreis (€)</label>
            <input type="number" id="batterie-preis-gesamt" step="100" min="0" value="6500">
          </div>
        </div>

        <div id="batterie-info" style="background: #e8f5e9; padding: 10px; border-radius: 6px; margin-top: 10px; font-size: 14px; color: #2e7d32;"></div>
      </div>
    </div>
  </div>

  <div style="text-align: center; margin: 30px 0;">
    <button id="berechne-btn" class="anriss-btn" style="background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%); min-width: 250px; padding: 18px 40px; font-size: 18px;">
      ⚡ Jetzt berechnen
    </button>
  </div>

  <div id="format-results" style="display: none; margin-top: 30px;">
    <!-- Ergebnisse werden hier eingefügt -->
  </div>

  <div id="results" style="display: none; margin-top: 30px; background: white; border: 2px solid #e1e8ed; border-radius: 12px; padding: 20px;">
    <h3 style="color: #1e3c72; margin-bottom: 20px;">📊 Deine PV-Ergebnisse</h3>

    <!-- Zusammenfassung mit Key-Metriken -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
      <div style="background: #e3f2fd; padding: 15px; border-radius: 8px; border-left: 4px solid #3b82f6;">
        <div style="font-size: 12px; color: #666; margin-bottom: 5px;">Module</div>
        <div style="font-size: 28px; font-weight: bold; color: #1e3c72;" id="res-anzahl">–</div>
      </div>
      <div style="background: #f3e5f5; padding: 15px; border-radius: 8px; border-left: 4px solid #8b5cf6;">
        <div style="font-size: 12px; color: #666; margin-bottom: 5px;">Leistung</div>
        <div style="font-size: 28px; font-weight: bold; color: #1e3c72;" id="res-kwp">–</div>
        <div style="font-size: 12px; color: #666;">kWp</div>
      </div>
      <div style="background: #e8f5e9; padding: 15px; border-radius: 8px; border-left: 4px solid #10b981;">
        <div style="font-size: 12px; color: #666; margin-bottom: 5px;">Jahresertrag</div>
        <div style="font-size: 24px; font-weight: bold; color: #1e3c72;" id="res-ertrag">–</div>
        <div style="font-size: 12px; color: #666;">kWh</div>
      </div>
      <div style="background: #fef3c7; padding: 15px; border-radius: 8px; border-left: 4px solid #f59e0b;">
        <div style="font-size: 12px; color: #666; margin-bottom: 5px;">Jahreswert</div>
        <div style="font-size: 24px; font-weight: bold; color: #1e3c72;" id="res-wert">–</div>
        <div style="font-size: 12px; color: #666;">€/Jahr</div>
      </div>
    </div>

    <!-- Detaillierte Ergebnisse -->
    <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; margin: 20px 0; overflow-x: auto;">
      <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
        <tbody id="res-details">
          <!-- Details werden hier eingefügt -->
        </tbody>
      </table>
    </div>

    <!-- Canvas für Modul-Layout -->
    <div style="margin: 20px 0; text-align: center;">
      <h4 style="margin-bottom: 15px; color: #1e3c72;">🏠 Modul-Layout auf deinem Dach</h4>
      <canvas id="pv-canvas" width="800" height="600" style="max-width: 100%; border: 1px solid #ccc; border-radius: 8px;"></canvas>
    </div>

    <!-- Navigation zu anderen Rechnern -->
    <div style="display: flex; gap: 15px; justify-content: center; margin-top: 25px; flex-wrap: wrap;">
      <a id="to-anrissplan" href="#" style="display: none; padding: 12px 24px; background: linear-gradient(135deg, #007bff 0%, #0056b3 100%); color: white; text-decoration: none; border-radius: 8px; font-weight: 600; box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3); transition: all 0.3s ease;">
        📋 Zum Anrissplan
      </a>
      <a id="to-lattenrechner" href="#" style="display: none; padding: 12px 24px; background: linear-gradient(135deg, #007bff 0%, #0056b3 100%); color: white; text-decoration: none; border-radius: 8px; font-weight: 600; box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3); transition: all 0.3s ease;">
        📏 Zum Lattenrechner
      </a>
    </div>
  </div>

  <InfoBox title="💡 Warum eine Solaranlage aufs Dach?" icon="☀️">
    <p>Mit einer Solaranlage produzierst du kostenlos deinen eigenen Strom — eine der besten Investitionen für Hausbesitzer:</p>
    <ul>
      <li><strong>Kostenersparnis:</strong> 300-500 Euro/Jahr sparen (je nach Anlagengröße)</li>
      <li><strong>Fördergeld:</strong> KfW 270/271 und BAFA unterstützen mit bis zu 9.600 Euro</li>
      <li><strong>Unabhängigkeit:</strong> Weniger abhängig von Strompreisen und Versorgung</li>
      <li><strong>Wertsteigerung:</strong> Erhöht den Wert deines Hauses um 3-5%</li>
      <li><strong>Klimaschutz:</strong> 100% regenerative Energie ohne CO2-Emissionen</li>
    </ul>
    <p>Moderne PV-Anlagen arbeiten 25+ Jahre wartungsfrei und senken deine Stromkosten um 50-80%.</p>
  </InfoBox>

  <AdUnit position="middle" />

  <InfoBox title="❓ Wie funktioniert der Rechner?" variant="info">
    <ol style="margin: 1rem 0 1rem 2rem;">
      <li>Gib deine Dachfläche ein</li>
      <li>Wähle deine Ausrichtung (Südseite ideal, Ost-West möglich, Nordseite ungeeignet)</li>
      <li>Der Rechner berechnet Anlagengröße, Ertrag, Kosten und Amortisation über 25 Jahre</li>
      <li>Ergebnis zeigt kWp, Jahresertrag, Eigenverbrauch und finanzielle Einsparungen</li>
    </ol>
  </InfoBox>

  <InfoBox title="💡 2025 ist eines der besten Jahre für Solar" variant="tip">
    <p>Noch hohe Förderungen (BAFA, KfW), fallende Modulpreise und schnelle Amortisation. Nach 2025 wird die BAFA-Förderung reduziert. Viele Bundesländer bieten zusätzliche Zuschüsse. Nutze den Rechner, um sofort zu sehen, wie wirtschaftlich dein Projekt ist!</p>
  </InfoBox>

  <AdUnit position="bottom" adSlot="9678418507" />
</ToolLayout>

<style>
  .section {
    margin: 30px 0;
    padding: 20px;
    background: #f8f9fa;
    border-radius: 12px;
  }

  .section h2 {
    color: #1e3c72;
    margin-bottom: 15px;
    font-size: 1.3rem;
  }

  .input-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    margin-bottom: 15px;
  }

  .input-group {
    display: flex;
    flex-direction: column;
  }

  .input-group label {
    font-weight: 600;
    color: #333;
    margin-bottom: 8px;
    font-size: 14px;
  }

  .input-group input,
  .input-group select {
    padding: 12px 15px;
    border: 2px solid #e1e8ed;
    border-radius: 8px;
    font-size: 16px;
    font-family: inherit;
    transition: border-color 0.3s ease;
  }

  .input-group input:focus,
  .input-group select:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  .info-box {
    background: #fff3cd;
    border-left: 4px solid #ffc107;
    padding: 15px;
    border-radius: 8px;
    margin-top: 15px;
    font-size: 14px;
    line-height: 1.6;
  }

  .anriss-btn {
    background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
    color: white;
    border: none;
    padding: 15px 30px;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.3);
    transition: all 0.3s ease;
    min-width: 200px;
  }

  .anriss-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
  }

  .module-btn.active {
    border-color: #3b82f6;
    background: linear-gradient(135deg, #e3f2fd 0%, #f0f8ff 100%);
    color: #1e3c72;
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.1);
  }

  .module-btn:hover {
    border-color: #3b82f6;
  }

  .orient-btn.active {
    border-color: #3b82f6;
    background: #e3f2fd;
    color: #1e3c72;
  }

  .orient-btn:hover {
    border-color: #3b82f6;
  }

  @media (max-width: 768px) {
    .input-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Dachform-Logik: Zeige "dach-breite-oben" nur für Trapez-Formen
  document.addEventListener('DOMContentLoaded', function() {
    const dachFormSelect = document.getElementById('dach-form');
    const dachBreiteObenGroup = document.getElementById('dach-breite-oben-group');

    function updateDachFormFields() {
      const form = dachFormSelect.value;
      if (form.includes('trapez')) {
        dachBreiteObenGroup.style.display = 'block';
      } else {
        dachBreiteObenGroup.style.display = 'none';
      }
    }

    dachFormSelect.addEventListener('change', updateDachFormFields);
    updateDachFormFields();

    // Lade Parameter aus URL
    const params = new URLSearchParams(window.location.search);
    if (params.has('typ')) {
      const typMap = {
        'rechteck': 'rechteck',
        'gleichschenkliges-dreieck': 'gleichschenkliges-dreieck',
        'ungleichschenkliges-dreieck': 'ungleichschenkliges-dreieck',
        'trapez': 'trapez',
        'dreieck-auf-rechteck': 'dreieck-auf-rechteck',
        'trapez-auf-rechteck': 'trapez-auf-rechteck',
      };
      const typ = params.get('typ');
      if (typMap[typ]) {
        dachFormSelect.value = typMap[typ];
        updateDachFormFields();
      }
    }

    if (params.has('breite')) {
      document.getElementById('dach-breite').value = parseFloat(params.get('breite')).toFixed(2);
    }
    if (params.has('hoehe')) {
      document.getElementById('dach-hoehe').value = parseFloat(params.get('hoehe')).toFixed(2);
    }
    if (params.has('breiteOben') || params.has('breite-oben')) {
      const breiteOben = params.get('breiteOben') || params.get('breite-oben');
      document.getElementById('dach-breite-oben').value = parseFloat(breiteOben).toFixed(2);
    }
  });
</script>

