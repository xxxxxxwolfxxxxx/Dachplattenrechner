---
import ToolLayout from '../../layouts/ToolLayout.astro';
import InfoBox from '../../components/InfoBox.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<ToolLayout
  title="Dreieck auf Rechteck – Dreieckplatten berechnen"
  description="Berechnen Sie Dreieckbleche für kombinierte Dreieck-auf-Rechteck-Flächen. Ideal für Satteldächer mit Walm, Mansardendächer und Spitzdächer mit rechteckiger Basis."
  keywords="Dreieckdach Blech berechnen, Spitzdach auf Rechteck, Satteldach Blech, Walmdach Dreieck, Dachblech Dreieck, Dreieckprofil Dreieck, Dreieckfläche berechnen"
  navTitle="Dreieck auf Rechteck"
  backHref="/tools/dachformen/"
  backLabel="← Dachformen"
  background="linear-gradient(135deg, rgba(30, 60, 114, 0.85) 0%, rgba(42, 82, 152, 0.85) 100%), url('/images/dreieck-rechteck.png')"
>
  <InfoBox title="Wann verwende ich diesen Rechner?" icon="📐">
    <p>Dieser Rechner eignet sich für Flächen, die aus einem <strong>Dreieck oben und einem Rechteck unten</strong> bestehen:</p>
    <ul>
      <li>Satteldächer mit Walm-Seitenflächen</li>
      <li>Mansardendächer</li>
      <li>Spitzdächer mit rechteckiger Basis</li>
      <li>Kombinierte Fassaden- und Dachflächen</li>
    </ul>
    <p>Die Bleche verlaufen durchgehend von unten nach oben über beide Bereiche (Rechteck + Dreieck).</p>
  </InfoBox>

  <div style="text-align: center; margin-bottom: 30px;">
    <div style="display: inline-block; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(148, 163, 184, 0.15); border-radius: 12px; padding: 0; overflow: hidden; max-width: 400px;">
      <img src="/images/dreieck-rechteck.png" alt="Dreieck auf Rechteck Visualisierung" style="width: 100%; height: auto; display: block;">
    </div>
  </div>

  <div class="preview-screenshot">
    <div class="preview-label">📊 So sehen deine Ergebnisse aus:</div>
    <div class="preview-grid">
      <div class="preview-col">
        <img src="/images/preview-dreieckaufrechteck.jpg" alt="Berechnungs-Ergebnis" class="preview-img">
        <span class="preview-col-label">Ergebnis & Schnittliste</span>
      </div>
      <div class="preview-col">
        <img src="/images/preview-anrissplan.png" alt="Anrissplan" class="preview-img">
        <span class="preview-col-label">Anrissplan</span>
      </div>
      <div class="preview-col">
        <img src="/images/preview-pv-dreieckaufrechteck.jpg" alt="PV-Rechner" class="preview-img">
        <span class="preview-col-label">PV-Rechner</span>
      </div>
    </div>
  </div>

  <div class="section">
    <h2>1. Dreieck-auf-Rechteck-Geometrie</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="breite">Breite (unten) (m)</label>
        <input type="number" id="breite" step="0.01" min="0" placeholder="z.B. 10.00">
      </div>
      <div class="input-group">
        <label for="dreieck-typ">Dreieckstyp</label>
        <select id="dreieck-typ" style="cursor: pointer;">
          <option value="gleichschenkliges">Gleichschenkliges Dreieck (Spitze zentriert)</option>
          <option value="ungleichschenkliges">Ungleichschenkliges Dreieck (Spitze versetzt)</option>
        </select>
      </div>
    </div>
    <div class="input-row">
      <div class="input-group">
        <label for="dreieck-hoehe">Dreieck-Höhe (m)</label>
        <input type="number" id="dreieck-hoehe" step="0.01" min="0" placeholder="z.B. 3.00">
      </div>
      <div class="input-group">
        <label for="rechteck-hoehe">Rechteck-Höhe (m)</label>
        <input type="number" id="rechteck-hoehe" step="0.01" min="0" placeholder="z.B. 4.00">
      </div>
    </div>
    <div class="input-row">
      <div class="input-group">
        <label for="spitzen-position" id="spitzen-position-label" style="display: none;">Spitzen-Position (m von links)</label>
        <input type="number" id="spitzen-position" step="0.01" min="0" placeholder="z.B. 5.0 (Breite ÷ 2 = Mitte)" style="display: none;">
      </div>
    </div>
    <div class="info-box">
      <strong>💡 Hinweis:</strong> Die Bleche verlaufen senkrecht und überdecken beide Bereiche (Rechteck und Dreieck).
      <br><br>
      <strong>💡 Tipp:</strong> Falls ein Maß fehlt, können Sie es mit unserem
      <a href="https://dreieck-berechnen.de" target="_blank" rel="noopener noreferrer" style="color: var(--accent-blue); font-weight: 600; text-decoration: underline;">Dreiecksrechner</a>
      berechnen – ohne nochmal aufs Dach zu müssen!
    </div>
  </div>

  <AdUnit position="middle" />

  <div class="section">
    <h2>2. Materialangaben</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="deckbreite">Deckbreite (m)</label>
        <input type="number" id="deckbreite" step="0.01" min="0" value="1.00">
      </div>
      <div class="input-group">
        <label for="lieferbreite">Lieferbreite (m)</label>
        <input type="number" id="lieferbreite" step="0.01" min="0" value="1.05">
      </div>
    </div>
  </div>

  <div class="section">
    <h2>3. Verlegerichtung</h2>
    <div style="margin-bottom: 20px;">
      <label style="display: block; margin-bottom: 12px; font-weight: 600; color: var(--text-secondary);">Verlegung von:</label>
      <div class="radio-group">
        <label class="radio-option" onclick="setVerlegerichtung('links')">
          <input type="radio" name="verlegerichtung" value="links" checked style="cursor: pointer;">
          <span style="font-weight: 500;">Links nach Rechts →</span>
        </label>
        <label class="radio-option" onclick="setVerlegerichtung('rechts')">
          <input type="radio" name="verlegerichtung" value="rechts" style="cursor: pointer;">
          <span style="font-weight: 500;">← Rechts nach Links</span>
        </label>
      </div>
    </div>
    <div class="info-box">
      <strong>💡 Wichtig - Wetterseite beachten!</strong><br>
      Die Verlegung sollte so erfolgen, dass die Hauptwindrichtung (meist West) ÜBER die Überlappungen weht.<br><br>
      <strong>⚠️ Ausnahmen:</strong> Bei Pfannenblechen oder Antikondensvlies-beschichteten Platten ist die Verlegerichtung vorgegeben!
    </div>
  </div>

  <button class="calculate-btn" onclick="berechnen()">Berechnen</button>

  <div id="results" class="results" style="display: none;">
    <div class="result-item">
      <span>Überlappung pro Blech:</span>
      <span id="ueberlappung">-</span>
    </div>
    <div class="result-item">
      <span>Gesamt-Höhe:</span>
      <span id="gesamt-hoehe-result">-</span>
    </div>
    <div class="result-item">
      <span>Berechnete Seitenlängen:</span>
      <span id="seiten-result">-</span>
    </div>
    <div class="result-item">
      <span>Benötigte max. Plattenlänge:</span>
      <span id="benoetigte-plattenlaenge">-</span>
    </div>
    <div class="result-item">
      <span>Benötigte Anzahl Bleche:</span>
      <span id="anzahl-bleche-breite">-</span>
    </div>
    <div class="result-item">
      <span>Gesamtanzahl Bleche:</span>
      <span id="gesamt-bleche">-</span>
    </div>

    <div id="vorschau" style="display: none; margin-top: 25px;">
      <h4 style="color: #ffffff; font-size: 1.2em; margin-bottom: 15px;">Visuelle Vorschau</h4>
      <div style="text-align: center; margin-bottom: 15px;">
        <div id="vorschau-svg"></div>
      </div>
      <div id="vorschau-legende" style="display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; font-size: 13px; margin-bottom: 10px;">
        <div style="display: flex; align-items: center; gap: 6px;">
          <div style="width: 16px; height: 12px; background: #1e3c72; opacity: 0.4; border-radius: 2px;"></div>
          <span>Nutzen</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
          <div style="width: 16px; height: 12px; background: #dc3545; opacity: 0.3; border-radius: 2px;"></div>
          <span>Verschnitt</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
          <div style="width: 16px; height: 12px; background: #28a745; opacity: 0.25; border-radius: 2px;"></div>
          <span>Überlappung</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
          <div style="width: 16px; height: 12px; background: #ffc107; border-radius: 2px;"></div>
          <span>Übergangszone</span>
        </div>
      </div>
    </div>

    <div id="schnittliste" style="display: none;">
      <h4 style="margin-top: 25px; color: #ffffff; font-size: 1.3em;">Schnittliste (pro Dreieck-auf-Rechteck-Fläche):</h4>
      <table style="width: 100%; border-collapse: collapse; margin-top: 15px; background: rgba(255, 255, 255, 0.1); border-radius: 8px; overflow: hidden; table-layout: fixed;">
        <thead>
          <tr>
            <th style="width: 12%; background: rgba(255, 255, 255, 0.2); font-weight: 600; padding: 12px; text-align: center; border-bottom: 2px solid rgba(255, 255, 255, 0.3);">Platte Nr.</th>
            <th style="width: 28%; background: rgba(255, 255, 255, 0.2); font-weight: 600; padding: 12px; text-align: right; border-bottom: 2px solid rgba(255, 255, 255, 0.3);">Position von links (m)</th>
            <th style="width: 28%; background: rgba(255, 255, 255, 0.2); font-weight: 600; padding: 12px; text-align: right; border-bottom: 2px solid rgba(255, 255, 255, 0.3);">Plattenbreite (m)</th>
            <th style="width: 32%; background: rgba(255, 255, 255, 0.2); font-weight: 600; padding: 12px; text-align: right; border-bottom: 2px solid rgba(255, 255, 255, 0.3);">Benötigte Länge (m)</th>
          </tr>
        </thead>
        <tbody id="schnitt-details"></tbody>
      </table>
      <div style="margin-top: 15px; font-size: 14px; color: #cbd5e1; text-align: center;">
        <strong>Verlegung:</strong> <span id="verlege-info">Von links nach rechts, Platten verlaufen vertikal über beide Bereiche (Rechteck + Dreieck)</span>
      </div>
      <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
        <button class="anriss-btn" onclick="erstelleAnrissplan()">📋 Anrissplan öffnen</button>
        <button class="anriss-btn" onclick="erstelleLattenrechner()" style="background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%); box-shadow: 0 4px 15px rgba(255, 107, 53, 0.3);">🔨 Lattenrechner</button>
        <button class="anriss-btn" onclick="erstellePVRechner()" style="background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%); color:#1a1a1a; box-shadow: 0 4px 15px rgba(247, 151, 30, 0.3);">☀️ PV-Rechner</button>
      </div>
    </div>
  </div>

  <InfoBox title="💡 Tipp: Deckbreite vs. Lieferbreite" variant="tip">
    <p><strong>Deckbreite</strong> = nutzbare Breite des Bleches (z.B. 1,00 m)<br />
    <strong>Lieferbreite</strong> = tatsächliche Breite mit Überlappung (z.B. 1,06 m)</p>
  </InfoBox>

  <InfoBox title="⚠️ Hinweis zur Genauigkeit" variant="warning">
    <p>Alle Ergebnisse dienen als Planungshilfe. Vor der Ausführung bitte von Fachkraft prüfen lassen.</p>
  </InfoBox>

</ToolLayout>

<style>
  .info-box {
    background: rgba(14, 165, 233, 0.1);
    border-left: 4px solid var(--accent-blue);
    padding: 15px;
    border-radius: var(--radius-sm);
    margin-top: 15px;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  .schnitt-table { table-layout: fixed; }
  .schnitt-table th:nth-child(1) { width: 12%; }
  .schnitt-table th:nth-child(2) { width: 28%; }
  .schnitt-table th:nth-child(3) { width: 28%; }
  .schnitt-table th:nth-child(4) { width: 32%; }
  .schnitt-table td:nth-child(1) { text-align: center; }
  .schnitt-table td:nth-child(2), .schnitt-table td:nth-child(3), .schnitt-table td:nth-child(4) { text-align: right; }
  @media (max-width: 600px) { .preview-grid { grid-template-columns: 1fr; } }
  @media (max-width: 768px) {
    .result-item { flex-direction: column; text-align: left; gap: 2px; }
  }
</style>

<script src="/tools-js/dreieckaufrechteck.js" defer></script>

<script>
  // Lade Parameter aus der URL
  function ladParameterAusURL() {
    const params = new URLSearchParams(window.location.search);
    const dreieckTypSelect = document.getElementById('dreieck-typ');
    const spitzenPositionInput = document.getElementById('spitzen-position');
    const spitzenPositionLabel = document.getElementById('spitzen-position-label');

    if (params.has('breite')) {
      const breiteInput = document.getElementById('breite');
      if (breiteInput) breiteInput.value = parseFloat(params.get('breite')).toFixed(2);
    }
    if (params.has('dreieckHoehe')) {
      const dreieckHoeheInput = document.getElementById('dreieck-hoehe');
      if (dreieckHoeheInput) dreieckHoeheInput.value = parseFloat(params.get('dreieckHoehe')).toFixed(2);
    }
    if (params.has('rechteckHoehe')) {
      const rechteckHoeheInput = document.getElementById('rechteck-hoehe');
      if (rechteckHoeheInput) rechteckHoeheInput.value = parseFloat(params.get('rechteckHoehe')).toFixed(2);
    }
    if (params.has('dreieckTyp')) {
      if (dreieckTypSelect) dreieckTypSelect.value = params.get('dreieckTyp');
    }
    if (params.has('spitzenPosition')) {
      if (spitzenPositionInput) spitzenPositionInput.value = parseFloat(params.get('spitzenPosition')).toFixed(2);
    }

    // Zeige Spitzen-Position-Input nur für ungleichschenkliges Dreieck
    updateDreieckTypUI();

    // Auto-calculate, falls Parameter vorhanden
    if (params.has('breite') && params.has('dreieckHoehe') && params.has('rechteckHoehe')) {
      setTimeout(berechnen, 100);
    }
  }

  function updateDreieckTypUI() {
    const dreieckTypSelect = document.getElementById('dreieck-typ');
    const spitzenPositionInput = document.getElementById('spitzen-position');
    const spitzenPositionLabel = document.getElementById('spitzen-position-label');

    if (dreieckTypSelect.value === 'ungleichschenkliges') {
      spitzenPositionInput.style.display = 'block';
      spitzenPositionLabel.style.display = 'block';
    } else {
      spitzenPositionInput.style.display = 'none';
      spitzenPositionLabel.style.display = 'none';
    }
  }

  // Update UI wenn Dreieckstyp ändert
  document.addEventListener('DOMContentLoaded', function() {
    const dreieckTypSelect = document.getElementById('dreieck-typ');
    if (dreieckTypSelect) {
      dreieckTypSelect.addEventListener('change', updateDreieckTypUI);
    }
  });

  window.addEventListener('load', ladParameterAusURL);
</script>
