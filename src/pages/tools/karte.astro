---
import ToolLayout from '../../layouts/ToolLayout.astro';
import InfoBox from '../../components/InfoBox.astro';
import AdUnit from '../../components/AdUnit.astro';
import SchneelastSuche from '../../components/SchneelastSuche.astro';
import ZonenKarte from '../../components/ZonenKarte.astro';
---

<ToolLayout
  title="Schnee- & Windlastzonen Deutschland"
  description="Schneelastzone und Windzone für deinen Postleitzahl, Ort oder Landkreis nachschlagen – nach DIN EN 1991-1-3 und DIN EN 1991-1-4. Mit Zonenkarte Deutschland."
  keywords="Schneelastzone Deutschland, Windlastzone Deutschland, Schneelast berechnen Dach, DIN 1991 Schneelast, Windzone Karte, Dach Statik Schneelast, Carport Schneelast, Blech Dach Windlast"
  navTitle="Schnee- & Windlastzonen"
  background="url('/images/Schneelast.png')"
>

  <InfoBox title="Zonenwerte nach DIN-Norm">
    <ul>
      <li><strong>Schneelastzonen 1, 1a, 2, 2a, 3</strong> nach DIN EN 1991-1-3 (Eurocode 1), je Gemeinde bzw. Landkreis nach DIBt-Tabelle</li>
      <li><strong>Windzonen 1–4</strong> nach DIN EN 1991-1-4 (Eurocode 1), ebenfalls nach DIBt-Tabelle</li>
      <li>Postleitzahl, Ort oder Landkreis eingeben – Schnee- und Windzone werden gemeinsam angezeigt</li>
      <li>Bei Höhenlagen oder Sonderfällen können abweichende Werte gelten</li>
    </ul>
  </InfoBox>

  <SchneelastSuche />

  <AdUnit position="middle" adSlot="1581807497" />

  <ZonenKarte />
  <noscript>
    <img src="/images/Schneelast.png" alt="Schneelastzonen Deutschland" class="map-image" width="600" />
    <img src="/images/Windlast.png" alt="Windzonen Deutschland" class="map-image" width="600" />
  </noscript>

  <InfoBox title="Hinweise" variant="warning" heading="h3">
    <ul>
      <li>Die Daten basieren auf den offiziellen Verwaltungsgrenzen nach DIN EN 1991-1-3 und DIN EN 1991-1-4</li>
      <li>Schneelastzonen: 1 (niedrig) bis 3 (hoch) – Zone 1a/2a sind um 25 % erhöhte Zonen, in Bayern gibt es zusätzlich Zone 3a</li>
      <li>Windzonen: 1 (niedrig) bis 4 (sehr hoch, Küste/Nordseeinseln)</li>
      <li>Bei Sonderfällen, Höhenlagen über 400 m oder Hanglagen sind Rücksprachen mit dem Statiker erforderlich</li>
    </ul>
  </InfoBox>

</ToolLayout>

<style>
  .map-image { display: block; max-width: 100%; height: auto; margin: 16px auto; }
</style>
