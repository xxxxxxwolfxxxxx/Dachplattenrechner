---
import ToolLayout from '../../layouts/ToolLayout.astro';
import InfoBox from '../../components/InfoBox.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<ToolLayout
  title="Trapez – Trapezplatten berechnen"
  description="Berechnen Sie Trapezbleche für trapezförmige Dachflächen. Ideal für Pultdächer, Mansarden und asymmetrische Dachformen mit Schnittliste."
  keywords="Trapezblech Pultdach berechnen, Dachblech Trapez, Mansarddach Blech, Profilblech Pultdach, Trapezprofil Schnittliste, Blechdach Pultdach, Lichtplatte Pultdach, Dacheindeckung Trapez, Dachblech kaufen"
  navTitle="Trapez"
  backHref="/tools/dachformen/"
  backLabel="← Dachformen"
  background="url('/images/trapez.png')"
>
  <InfoBox title="Wann verwende ich diesen Rechner?" icon="📐">
    <p>Dieser Rechner eignet sich für <strong>trapezförmige Dachflächen</strong> wie:</p>
    <ul>
      <li>Pultdächer mit schräger Seitenabschluss-Fläche</li>
      <li>Mansardendächer</li>
      <li>Gauben und asymmetrische Dachformen</li>
      <li>Walmdach-Seitenflächen</li>
    </ul>
    <p>Das Trapez hat eine obere und eine untere Parallele. Die Bleche verlaufen senkrecht von unten nach oben.</p>
  </InfoBox>

  <div style="text-align: center; margin-bottom: 30px;">
    <div style="display: inline-block; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(148, 163, 184, 0.15); border-radius: 12px; padding: 20px;">
      <svg width="280" height="160" viewBox="0 0 280 160" style="margin-bottom: 15px;">
        <polygon points="80,20 200,20 240,120 40,120" fill="rgba(14, 165, 233, 0.15)" stroke="#0ea5e9" stroke-width="2"/>
        <line x1="60" y1="120" x2="60" y2="70" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="80" y1="120" x2="80" y2="20" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="100" y1="120" x2="100" y2="20" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="120" y1="120" x2="120" y2="20" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="140" y1="120" x2="140" y2="20" stroke="#dc3545" stroke-width="2" opacity="0.9"/>
        <line x1="160" y1="120" x2="160" y2="20" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="180" y1="120" x2="180" y2="20" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="200" y1="120" x2="200" y2="20" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="220" y1="120" x2="220" y2="70" stroke="#666" stroke-width="1.5" opacity="0.8"/>
        <line x1="80" y1="20" x2="200" y2="20" stroke="#28a745" stroke-width="3"/>
        <text x="140" y="15" text-anchor="middle" font-size="10" fill="#28a745" font-weight="bold">Obere Breite</text>
        <line x1="40" y1="120" x2="240" y2="120" stroke="#dc3545" stroke-width="3"/>
        <text x="140" y="138" text-anchor="middle" font-size="10" fill="#dc3545" font-weight="bold">Untere Breite</text>
        <line x1="25" y1="20" x2="25" y2="120" stroke="#cbd5e1" stroke-width="1"/>
        <line x1="22" y1="20" x2="28" y2="20" stroke="#cbd5e1" stroke-width="1"/>
        <line x1="22" y1="120" x2="28" y2="120" stroke="#cbd5e1" stroke-width="1"/>
        <text x="18" y="70" font-size="11" fill="#cbd5e1" font-weight="bold" transform="rotate(-90 18 70)">Höhe</text>
      </svg>
    </div>
  </div>

  <div class="preview-screenshot">
    <div class="preview-label">📊 So sehen deine Ergebnisse aus:</div>
    <div class="preview-grid">
      <div class="preview-col">
        <img src="/images/preview-trapez.png" alt="Berechnungs-Ergebnis" class="preview-img">
        <span class="preview-col-label">Ergebnis & Schnittliste</span>
      </div>
      <div class="preview-col">
        <img src="/images/preview-anrissplan.png" alt="Anrissplan" class="preview-img">
        <span class="preview-col-label">Anrissplan</span>
      </div>
      <div class="preview-col">
        <img src="/images/preview-lattenrechner.png" alt="Lattenrechner" class="preview-img">
        <span class="preview-col-label">Lattenrechner</span>
      </div>
    </div>
  </div>

  <div class="section">
    <h2>1. Trapez-Geometrie</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="obere-breite">Obere Breite (m)</label>
        <input type="number" id="obere-breite" step="0.01" min="0" placeholder="z.B. 8.00">
      </div>
      <div class="input-group">
        <label for="untere-breite">Untere Breite (m)</label>
        <input type="number" id="untere-breite" step="0.01" min="0" placeholder="z.B. 12.00">
      </div>
    </div>
    <div class="input-row">
      <div class="input-group">
        <label for="hoehe">Höhe (m)</label>
        <input type="number" id="hoehe" step="0.01" min="0" placeholder="z.B. 4.00">
      </div>
    </div>
    <div class="info-box">
      <strong>💡 Hinweis:</strong> Berechnung für trapezförmige Dachflächen.
      Die Bleche verlaufen senkrecht von unten nach oben.
      <br><br>
      <strong>💡 Tipp:</strong> Falls ein Maß fehlt, können Sie es mit unserem
      <a href="https://dreieck-berechnen.de/trapez" target="_blank" rel="noopener noreferrer" style="color: var(--accent-blue); font-weight: 600; text-decoration: underline;">Trapezrechner</a>
      berechnen – ohne nochmal aufs Dach zu müssen!
    </div>
  </div>

  <AdUnit position="middle" />

  <div class="section">
    <h2>2. Materialangaben</h2>
    <div class="input-row">
      <div class="input-group">
        <label for="deckbreite">Deckbreite (m)</label>
        <input type="number" id="deckbreite" step="0.01" min="0" value="1.00">
      </div>
      <div class="input-group">
        <label for="lieferbreite">Lieferbreite (m)</label>
        <input type="number" id="lieferbreite" step="0.01" min="0" value="1.05">
      </div>
    </div>
  </div>

  <div class="section">
    <h2>3. Verlegerichtung</h2>
    <div style="margin-bottom: 20px;">
      <label style="display: block; margin-bottom: 12px; font-weight: 600; color: var(--text-secondary);">Verlegung von:</label>
      <div class="radio-group">
        <label class="radio-option" onclick="setVerlegerichtung('links')">
          <input type="radio" name="verlegerichtung" value="links" checked style="cursor: pointer;">
          <span style="font-weight: 500;">Links nach Rechts →</span>
        </label>
        <label class="radio-option" onclick="setVerlegerichtung('rechts')">
          <input type="radio" name="verlegerichtung" value="rechts" style="cursor: pointer;">
          <span style="font-weight: 500;">← Rechts nach Links</span>
        </label>
      </div>
    </div>
    <div class="info-box">
      <strong>💡 Wichtig - Wetterseite beachten!</strong><br>
      Die Verlegung sollte so erfolgen, dass die Hauptwindrichtung (meist West) ÜBER die Überlappungen weht.<br><br>
      <strong>⚠️ Ausnahmen:</strong> Bei Pfannenblechen oder Antikondensvlies-beschichteten Platten ist die Verlegerichtung vorgegeben!
    </div>
  </div>

  <button class="calculate-btn" onclick="berechnen()">Berechnen</button>

  <div id="results" class="results" style="display: none;">
    <div class="result-item">
      <span>Überlappung pro Blech:</span>
      <span id="ueberlappung">-</span>
    </div>
    <div class="result-item">
      <span>Berechnete Seitenlängen:</span>
      <span id="seiten-result">-</span>
    </div>
    <div class="result-item">
      <span>Benötigte max. Plattenlänge:</span>
      <span id="benoetigte-plattenlaenge">-</span>
    </div>
    <div class="result-item">
      <span>Benötigte Anzahl Bleche:</span>
      <span id="anzahl-bleche-breite">-</span>
    </div>
    <div class="result-item">
      <span>Gesamtanzahl Bleche:</span>
      <span id="gesamt-bleche">-</span>
    </div>

    <div id="vorschau" style="display: none; margin-top: 25px;">
      <h4 style="color: #ffffff; font-size: 1.2em; margin-bottom: 15px;">Visuelle Vorschau</h4>
      <div style="text-align: center; margin-bottom: 15px;">
        <div id="vorschau-svg"></div>
      </div>
      <div id="vorschau-legende" style="display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; font-size: 13px; margin-bottom: 10px;">
        <div style="display: flex; align-items: center; gap: 6px;">
          <div style="width: 16px; height: 12px; background: #1e3c72; opacity: 0.4; border-radius: 2px;"></div>
          <span>Nutzen</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
          <div style="width: 16px; height: 12px; background: #dc3545; opacity: 0.3; border-radius: 2px;"></div>
          <span>Verschnitt</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
          <div style="width: 16px; height: 12px; background: #28a745; opacity: 0.25; border-radius: 2px;"></div>
          <span>Überlappung</span>
        </div>
        <div style="display: flex; align-items: center; gap: 6px;">
          <div style="width: 16px; height: 12px; background: #ffc107; border-radius: 2px;"></div>
          <span>Trapez-Ecken</span>
        </div>
      </div>
    </div>

    <div id="schnittliste" style="display: none;">
      <h4 style="margin-top: 25px; color: #ffffff; font-size: 1.3em;">Schnittliste (pro Trapezfläche):</h4>
      <table class="schnitt-table">
        <thead>
          <tr>
            <th>Platte Nr.</th>
            <th>Position von links (m)</th>
            <th>Plattenbreite (m)</th>
            <th>Benötigte Länge (m)</th>
          </tr>
        </thead>
        <tbody id="schnitt-details"></tbody>
      </table>
      <div style="margin-top: 15px; font-size: 14px; color: #cbd5e1; text-align: center;">
        <strong>Verlegung:</strong> <span id="verlege-info">Von links nach rechts, Platten verlaufen vertikal (unten → oben)</span>
      </div>
      <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
        <button class="anriss-btn" onclick="erstelleAnrissplan()">📋 Anrissplan öffnen</button>
        <button class="anriss-btn" onclick="erstelleLattenrechner()" style="background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%); box-shadow: 0 4px 15px rgba(255, 107, 53, 0.3);">🔨 Lattenrechner</button>
        <button class="anriss-btn" onclick="erstellePVRechner()" style="background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%); color:#1a1a1a; box-shadow: 0 4px 15px rgba(247, 151, 30, 0.3);">☀️ PV-Rechner</button>
      </div>
    </div>
  </div>

  <InfoBox title="💡 Tipp: Deckbreite vs. Lieferbreite" variant="tip">
    <p><strong>Deckbreite</strong> = nutzbare Breite des Bleches (z.B. 1,00 m)<br />
    <strong>Lieferbreite</strong> = tatsächliche Breite mit Überlappung (z.B. 1,06 m)</p>
  </InfoBox>

  <InfoBox title="⚠️ Hinweis zur Genauigkeit" variant="warning">
    <p>Alle Ergebnisse dienen als Planungshilfe. Vor der Ausführung bitte von Fachkraft prüfen lassen.</p>
  </InfoBox>

</ToolLayout>

<style>
  .info-box {
    background: rgba(14, 165, 233, 0.1);
    border-left: 4px solid var(--accent-blue);
    padding: 15px;
    border-radius: var(--radius-sm);
    margin-top: 15px;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  @media (max-width: 600px) { .preview-grid { grid-template-columns: 1fr; } }
  @media (max-width: 768px) {
    .result-item { flex-direction: column; text-align: left; gap: 2px; }
  }
</style>

<script src="/tools-js/trapez.js" defer></script>

<script>
  // Lade Parameter aus der URL
  function ladParameterAusURL() {
    const params = new URLSearchParams(window.location.search);
    if (params.has('breite')) {
      const untereInput = document.getElementById('untere-breite');
      if (untereInput) untereInput.value = parseFloat(params.get('breite')).toFixed(2);
    }
    if (params.has('hoehe')) {
      const hoeheInput = document.getElementById('hoehe');
      if (hoeheInput) hoeheInput.value = parseFloat(params.get('hoehe')).toFixed(2);
    }
    // Auto-calculate, falls Parameter vorhanden
    if (params.has('breite') && params.has('hoehe')) {
      setTimeout(berechnen, 100);
    }
  }

  window.addEventListener('load', ladParameterAusURL);
</script>
