---
import ToolLayout from '../../layouts/ToolLayout.astro';
import AdUnit from '../../components/AdUnit.astro';
---

<ToolLayout
  title="Farbkatalog – RAL & Prelaq Farben für Trapezbleche"
  description="Wähle aus RAL- und Prelaq-Farbtönen für deine Trapezbleche. Mit visueller Vorschau und Bestellangaben."
  keywords="RAL-Farben, Prelaq Farben, Trapezbleche Farbe, Dachbleche Farbe, Farbkatalog Dach"
  navTitle="Farbkatalog"
  backHref="/"
  backLabel="&larr; Übersicht"
  background="linear-gradient(135deg, rgba(30, 60, 114, 0.85) 0%, rgba(42, 82, 152, 0.85) 100%)"
>

  <div class="header-box">
    <p id="headerDescription">Über 300 RAL- und Prelaq-Farben für Trapezblech, Kantteile und Metallverarbeitung</p>
  </div>

  <div class="color-tabs">
    <button class="tab-btn active" onclick="switchTab('ral')">RAL Farben</button>
    <button class="tab-btn" onclick="switchTab('prelaq')">Prelaq Farben</button>
  </div>

  <div class="search-box">
    <input type="text" class="search-input" id="searchInput" placeholder="Farbe suchen (Code oder Name)...">
  </div>

  <AdUnit position="top" adSlot="9678418506" />

  <div id="ral-tab" class="tab-content active">
    <div class="color-grid" id="ralGrid"></div>
  </div>

  <div id="prelaq-tab" class="tab-content">
    <div class="color-grid" id="prelaqGrid"></div>
  </div>

  <div class="selection-info" id="selectionInfo">
    <h3>Ausgewählte Farbe</h3>
    <div id="selectedColorInfo"></div>
  </div>

  <AdUnit position="bottom" adSlot="9678418507" />

</ToolLayout>

<style>
  .header-box { text-align: center; margin-bottom: 25px; padding: 20px; background: rgba(255, 255, 255, 0.9); border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
  .header-box p { color: #666; font-size: 1.1em; margin: 0; }
  .color-tabs { display: flex; justify-content: center; margin-bottom: 20px; gap: 10px; padding: 0 20px; flex-wrap: wrap; }
  .tab-btn { padding: 12px 24px; border: none; border-radius: 25px; background: rgba(255, 255, 255, 0.7); color: #1e3c72; font-weight: 600; cursor: pointer; transition: all 0.3s ease; font-size: 16px; }
  .tab-btn.active { background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); color: white; box-shadow: 0 4px 15px rgba(30, 60, 114, 0.3); }
  .tab-btn:hover:not(.active) { background: rgba(255, 255, 255, 1); transform: translateY(-2px); }
  .search-box { max-width: 400px; margin: 0 auto 25px; padding: 0 20px; }
  .search-input { width: 100%; padding: 12px 20px; border: 2px solid #e0e0e0; border-radius: 25px; font-size: 16px; background: rgba(255, 255, 255, 0.9); transition: all 0.3s ease; }
  .search-input:focus { outline: none; border-color: #1e3c72; box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.1); }
  .color-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 15px; max-width: 1200px; margin: 0 auto; padding: 0; }
  .tab-content { display: none; }
  .tab-content.active { display: block; }
  .selection-info { position: fixed; bottom: 20px; right: 20px; background: rgba(255, 255, 255, 0.95); padding: 20px; border-radius: 15px; box-shadow: 0 8px 25px rgba(0,0,0,0.2); backdrop-filter: blur(10px); border: 2px solid #27ae60; min-width: 200px; display: none; z-index: 100; }
  .selection-info h3 { color: #27ae60; margin-bottom: 10px; }
  @media (max-width: 768px) {
    .color-grid { grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 10px; }
    .selection-info { bottom: 10px; right: 10px; left: 10px; }
  }
</style>

<script src="/tools-js/farben.js" defer></script>
