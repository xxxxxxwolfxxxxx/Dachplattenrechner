---
interface Props {
  href: string;
  title: string;
  description: string;
  icon?: string;
  badge?: string;
  features?: string[];
  external?: boolean;
}
const { href, title, description, icon, badge, features = [], external = false } = Astro.props;
const isEmoji = icon && !icon.startsWith('/') && !icon.startsWith('http');
---
<a
  href={href}
  class="card"
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  {badge && (
    <span style="position: absolute; top: 14px; right: 14px; background: linear-gradient(135deg, #0ea5e9, #06b6d4); color: white; font-size: 0.65rem; font-weight: 700; padding: 4px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.5px;">
      {badge}
    </span>
  )}

  {icon && (
    <div class="card-icon">
      {isEmoji
        ? <span style="font-size: 3rem;">{icon}</span>
        : <img src={icon} alt={title} loading="lazy" width="70" height="70" style="height: 70px; width: auto; max-width: 100px; object-fit: contain; filter: drop-shadow(0 4px 8px rgba(14, 165, 233, 0.3));" />
      }
    </div>
  )}

  <h3 class="card-title" style="font-size: 1.05rem;">{title}</h3>

  <p class="card-description">{description}</p>

  {features.length > 0 && (
    <ul class="card-features">
      {features.map(f => (
        <li>{f}</li>
      ))}
    </ul>
  )}

  <span class="card-cta">Rechner öffnen →</span>
</a>
