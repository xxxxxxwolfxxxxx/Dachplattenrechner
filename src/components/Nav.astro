---
interface Props {
  title?: string;
  backHref?: string;
  backLabel?: string;
}
const { title = 'Dachplattenrechner.de', backHref = '/', backLabel = '← Startseite' } = Astro.props;
---
<nav class="site-nav no-print">
  <div class="nav-inner container">
    <a href={backHref} class="back-btn">{backLabel}</a>
    <span class="nav-title">{title}</span>
    <a href="/" class="nav-logo">🏠 Dachplattenrechner.de</a>
  </div>
</nav>

<style>
  .site-nav {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.95));
    backdrop-filter: blur(12px);
    padding: 14px 0;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .back-btn,
  .nav-logo {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color var(--transition-fast);
    white-space: nowrap;
  }
  .back-btn:hover,
  .nav-logo:hover {
    color: var(--accent-blue);
  }
  .nav-title {
    color: var(--text-primary);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.5px;
    text-align: center;
    flex: 1;
  }
  @media (max-width: 600px) {
    .nav-logo { display: none; }
    .nav-title { font-size: 0.88rem; }
  }
</style>
