---
interface Props {
  position?: 'top' | 'middle' | 'bottom';
  adSlot?: string;
}
const { position = 'middle', adSlot = '9678418506' } = Astro.props;
---
<div class={`ad-container ad-${position} no-print`} style="display:none">
  <p class="ad-label">Anzeige</p>
  <div class="ad-row" style="display:flex;justify-content:center;gap:16px;flex-wrap:wrap;">
    <ins
      class="adsbygoogle"
      style="display:inline-block;width:300px;height:250px"
      data-ad-client="ca-pub-8687929894744033"
      data-ad-slot={adSlot}
      data-ad-format="rectangle"
    ></ins>
    <ins
      class="adsbygoogle"
      style="display:inline-block;width:300px;height:250px"
      data-ad-client="ca-pub-8687929894744033"
      data-ad-slot="5964798846"
      data-ad-format="rectangle"
    ></ins>
  </div>
</div>

<style>
  .ad-container {
    margin: 28px 0;
    text-align: center;
  }
  .ad-label {
    font-size: 0.68rem;
    color: #374151;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }
  .ad-row {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
</style>
