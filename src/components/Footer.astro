---
const year = new Date().getFullYear();
---
<footer class="site-footer no-print">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        <h3>Dachplattenrechner.de</h3>
        <p>Kostenlose Berechnungstools für Dachdecker, Architekten und Heimwerker. Alle Berechnungen laufen direkt im Browser – keine Registrierung nötig.</p>
      </div>
      <div>
        <h3>Dachfläche berechnen</h3>
        <ul>
          <li><a href="/tools/rechteck/">Rechteck / Quadrat</a></li>
          <li><a href="/tools/gleichschenkliges-dreieck/">Gleichschenkliges Dreieck</a></li>
          <li><a href="/tools/ungleichschenkliges-dreieck/">Ungleichschenkliges Dreieck</a></li>
          <li><a href="/tools/dreieckaufrechteck/">Dreieck auf Rechteck</a></li>
          <li><a href="/tools/trapez/">Trapez</a></li>
          <li><a href="/tools/trapezaufrechteck/">Trapez auf Rechteck</a></li>
          <li><a href="/tools/dachformen/">Alle Dachformen</a></li>
        </ul>
      </div>
      <div>
        <h3>Weitere Rechner</h3>
        <ul>
          <li><a href="/tools/lattenrechner/">Lattenrechner</a></li>
          <li><a href="/tools/verschnitt-optimierung/">Verschnitt-Optimierung</a></li>
          <li><a href="/tools/u-wert/">U-Wert Rechner</a></li>
          <li><a href="/tools/pv-rechner/">PV-Rechner</a></li>
          <li><a href="/tools/schneelastzone/">Schneelastzone</a></li>
          <li><a href="/tools/karte/">Schnee- &amp; Windlastzonen</a></li>
          <li><a href="/tools/kantteil/">Kantteil-Zeichner</a></li>
          <li><a href="/tools/farben/">Farbkatalog</a></li>
        </ul>
      </div>
      <div>
        <h3>Ratgeber</h3>
        <ul>
          <li><a href="/tools/dachflaeche-berechnen/">Dachfläche berechnen</a></li>
          <li><a href="/ratgeber/">Dach-Ratgeber</a></li>
          <li><a href="/ratgeber/blechdach/">Blechdach selbst decken</a></li>
        </ul>
        <h3 style="margin-top: 20px;">Recht</h3>
        <ul>
          <li><a href="/impressum/">Impressum</a></li>
          <li><a href="/kontakt/">Kontakt</a></li>
          <li><a href="/datenschutz/">Datenschutz</a></li>
          <li><a href="/agb/">AGB</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-projects">
      <h3>Weitere Projekte</h3>
      <ul>
        <li>
          <a href="https://dreieck-berechnen.de/" title="Dreieck berechnen – Fläche, Umfang und Winkel online">Dreieck-Berechnen.de</a>
          <span>Geometrie-Rechner für Fläche, Umfang, Winkel und Höhen</span>
        </li>
        <li>
          <a href="https://deutschland-rechnet.de/" title="Kostenlose Online-Rechner für Deutschland">Deutschland-Rechnet.de</a>
          <span>105+ Rechner für Steuern, Kredit, Energie und Familie</span>
        </li>
        <li>
          <a href="https://sportbootnavi.de/" title="Kostenlose Navigation und Törnplaner für Sportboote">SportbootNavi.de</a>
          <span>Törnplaner und Navigation für Binnenwasserstraßen</span>
        </li>
      </ul>
    </div>

    <p class="footer-copy">&copy; {year} Dachplattenrechner.de &ndash; Matthias Dührkop &bull; Boizenburg/Elbe</p>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(135deg, #060b18 0%, #0f172a 100%);
    border-top: 1px solid var(--border-color);
    padding: 48px 0 24px;
    margin-top: 60px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 0.8fr;
    gap: 40px;
    margin-bottom: 36px;
  }
  .footer-about p {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.7;
    margin-top: 8px;
    max-width: 320px;
  }
  .site-footer h3 {
    color: var(--text-primary);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 14px;
  }
  .site-footer ul {
    list-style: none;
  }
  .site-footer li {
    margin-bottom: 8px;
  }
  .site-footer a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color var(--transition-fast);
  }
  .site-footer a:hover {
    color: var(--accent-blue);
  }
  /* ── Weitere Projekte ── */
  .footer-projects {
    border-top: 1px solid rgba(148, 163, 184, 0.08);
    padding-top: 24px;
    margin-bottom: 28px;
  }
  .footer-projects ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px 32px;
  }
  .footer-projects li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 0;
  }
  .footer-projects a {
    color: #64748b;
    font-weight: 600;
  }
  .footer-projects span {
    color: #374151;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .footer-copy {
    color: #374151;
    font-size: 0.78rem;
    text-align: center;
    border-top: 1px solid var(--border-color);
    padding-top: 20px;
  }
  /* ── Weitere Projekte ── */
  .footer-projects {
    border-top: 1px solid var(--border-color);
    padding-top: 24px;
    margin-bottom: 28px;
  }
  .footer-projects ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px 32px;
  }
  .footer-projects li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 0;
  }
  .footer-projects a {
    color: var(--text-muted);
    font-weight: 600;
  }
  .footer-projects span {
    color: var(--text-muted);
    opacity: 0.7;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
    .footer-about { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-about { grid-column: auto; }
  }
</style>
