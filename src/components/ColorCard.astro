---
import type { Farbton } from '../data/farben';
import type { Dachfarbe } from '../data/dachfarben';

interface Props {
  farbton: Farbton;
  /** 'RAL' oder 'Prelaq' */
  praefix: string;
  /** Gesetzt, wenn es zu diesem Ton eine eigene Detailseite gibt */
  dachfarbe?: Dachfarbe;
}

const { farbton, praefix, dachfarbe } = Astro.props;

const bezeichnung = `${praefix} ${farbton.code}`;
// Helle Toene brauchen dunkle Schrift auf dem Farbfeld.
const helligkeit =
  (parseInt(farbton.hex.slice(1, 3), 16) * 299 +
    parseInt(farbton.hex.slice(3, 5), 16) * 587 +
    parseInt(farbton.hex.slice(5, 7), 16) * 114) /
  1000;
const textfarbe = helligkeit > 150 ? '#222' : '#fff';

// Das Suchfeld filtert ueber dieses Attribut - ohne die Karten neu zu bauen.
const suchtext = `${bezeichnung} ${farbton.name}`.toLowerCase();
---

<article
  class:list={['color-card', { 'is-linked': dachfarbe }]}
  data-search={suchtext}
  data-code={farbton.code}
  data-name={farbton.name}
  data-praefix={praefix}
>
  <div class="color-sample" style={`background-color: ${farbton.hex}; color: ${textfarbe};`}>
    {bezeichnung}
  </div>
  <div class="color-info">
    <h3 class="color-code">{bezeichnung}</h3>
    <p class="color-name">{farbton.name}</p>
    {dachfarbe ? (
      <>
        <p class="color-usage">{dachfarbe.usage}</p>
        <a class="color-link" href={`/tools/farben/${dachfarbe.slug}/`}>
          {bezeichnung} im Detail
        </a>
      </>
    ) : (
      <p class="color-hex">{farbton.hex.toUpperCase()}</p>
    )}
  </div>
</article>

<style>
  .color-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: rgba(15, 23, 42, 0.7);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .color-card.is-linked {
    border-color: rgba(14, 165, 233, 0.35);
    box-shadow: var(--shadow-sm);
  }
  .color-card:hover,
  .color-card:focus-within {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-blue);
  }
  .color-card[hidden] {
    display: none;
  }

  .color-sample {
    min-height: 74px;
    display: flex;
    align-items: flex-end;
    padding: 8px 10px;
    font-size: 0.82em;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .color-info {
    padding: 10px 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .color-code {
    font-size: 0.95em;
    font-weight: 700;
    color: var(--accent-blue);
    margin: 0;
  }
  .color-name {
    font-size: 0.88em;
    color: var(--text-secondary);
    margin: 0;
  }
  .color-hex {
    font-size: 0.78em;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }
  .color-usage {
    font-size: 0.8em;
    color: var(--text-muted);
    line-height: 1.45;
    margin: 4px 0 0;
  }
  .color-link {
    margin-top: 6px;
    font-size: 0.82em;
    font-weight: 600;
    color: var(--accent-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .color-link:hover,
  .color-link:focus-visible {
    color: var(--accent-cyan);
  }
</style>
