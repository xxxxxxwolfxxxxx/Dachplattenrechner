---
/**
 * Der eigentliche Rechteck-Rechner – ohne Erklärtexte, Vorschaubilder und
 * Werbung. Wird von /tools/rechteck/ und von /embed/rechteck/ verwendet, damit
 * beide dieselbe Logik zeigen und nicht auseinanderlaufen.
 *
 * Das Styling kommt komplett aus dem globalen Design-System (src/styles/main.css),
 * damit der Rechner in der Tool-Seite und im Embed identisch aussieht.
 */
interface Props {
  /** Im Embed sind die Folge-Tools (Anrissplan, Lattenrechner, PV) ausgeblendet:
   *  sie öffnen neue Seiten, was im fremden iframe unerwartet wäre. */
  showFollowUpTools?: boolean;
}
const { showFollowUpTools = true } = Astro.props;
---

<div class="section">
  <h2>1. Rechteck-Geometrie</h2>
  <div class="input-row">
    <div class="input-group">
      <label for="breite">Breite (m)</label>
      <input type="number" id="breite" step="0.01" min="0" placeholder="z.B. 10.00">
    </div>
    <div class="input-group">
      <label for="hoehe">Höhe (m)</label>
      <input type="number" id="hoehe" step="0.01" min="0" placeholder="z.B. 8.00">
    </div>
  </div>
  <div class="calc-note">
    <strong>Hinweis:</strong> Berechnung für rechteckige und quadratische Dachflächen.
    Die Bleche verlaufen senkrecht von oben nach unten – alle haben die gleiche Länge.
  </div>
</div>

<slot name="after-geometry" />

<div class="section">
  <h2>2. Materialangaben</h2>
  <div class="input-row">
    <div class="input-group">
      <label for="deckbreite">Deckbreite (m)</label>
      <input type="number" id="deckbreite" step="0.01" min="0" value="1.00">
    </div>
    <div class="input-group">
      <label for="lieferbreite">Lieferbreite (m)</label>
      <input type="number" id="lieferbreite" step="0.01" min="0" value="1.05">
    </div>
  </div>
</div>

<div class="section">
  <h2>3. Verlegerichtung</h2>
  <div style="margin-bottom: 20px;">
    <label style="display: block; margin-bottom: 12px; font-weight: 600; color: var(--text-secondary);">Verlegung von:</label>
    <div class="radio-group">
      <label class="radio-option" onclick="setVerlegerichtung('links')">
        <input type="radio" name="verlegerichtung" value="links" checked style="cursor: pointer;">
        <span style="font-weight: 500;">Links nach Rechts →</span>
      </label>
      <label class="radio-option" onclick="setVerlegerichtung('rechts')">
        <input type="radio" name="verlegerichtung" value="rechts" style="cursor: pointer;">
        <span style="font-weight: 500;">← Rechts nach Links</span>
      </label>
    </div>
  </div>
  <div class="calc-note calc-note--warning">
    <strong>💡 Wichtig – Wetterseite beachten!</strong><br>
    Die Verlegung sollte so erfolgen, dass die Hauptwindrichtung (meist West) ÜBER die Überlappungen weht.<br><br>
    <strong>⚠️ Ausnahmen:</strong> Bei Pfannenblechen oder Antikondensvlies-beschichteten Platten ist die Verlegerichtung vorgegeben!
  </div>
</div>

<button class="calculate-btn" onclick="berechnen()">Berechnen</button>

<div id="results" class="results" style="display: none;">
  <div class="result-item">
    <span>Überlappung pro Blech:</span>
    <span id="ueberlappung">-</span>
  </div>
  <div class="result-item">
    <span>Fläche:</span>
    <span id="flaeche-result">-</span>
  </div>
  <div class="result-item">
    <span>Benötigte Plattenlänge:</span>
    <span id="benoetigte-plattenlaenge">-</span>
  </div>
  <div class="result-item">
    <span>Benötigte Anzahl Bleche:</span>
    <span id="anzahl-bleche-breite">-</span>
  </div>
  <div class="result-item">
    <span>Gesamtanzahl Bleche:</span>
    <span id="gesamt-bleche">-</span>
  </div>

  <div id="vorschau" style="display: none; margin-top: 25px;">
    <h4 style="color: #ffffff; font-size: 1.2em; margin-bottom: 15px;">Visuelle Vorschau</h4>
    <div style="text-align: center; margin-bottom: 15px;">
      <div id="vorschau-svg"></div>
    </div>
    <div id="vorschau-legende" style="display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; font-size: 13px; margin-bottom: 10px;">
      <div style="display: flex; align-items: center; gap: 6px;">
        <div style="width: 16px; height: 12px; background: #1e3c72; opacity: 0.4; border-radius: 2px;"></div>
        <span>Nutzen</span>
      </div>
      <div style="display: flex; align-items: center; gap: 6px;">
        <div style="width: 16px; height: 12px; background: #28a745; opacity: 0.25; border-radius: 2px;"></div>
        <span>Überlappung</span>
      </div>
    </div>
  </div>

  <div id="schnittliste" style="display: none;">
    <h4 style="margin-top: 25px; color: #ffffff; font-size: 1.3em;">Schnittliste (pro Rechteckfläche):</h4>
    <table class="schnitt-table">
      <thead>
        <tr>
          <th>Platte Nr.</th>
          <th>Position von links (m)</th>
          <th>Plattenbreite (m)</th>
          <th>Benötigte Länge (m)</th>
        </tr>
      </thead>
      <tbody id="schnitt-details"></tbody>
    </table>
    <div style="margin-top: 15px; font-size: 14px; color: #cbd5e1; text-align: center;">
      <strong>Verlegung:</strong> <span id="verlege-info">Von links nach rechts, Platten verlaufen vertikal (oben → unten)</span>
    </div>
    {showFollowUpTools && (
      <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
        <button class="anriss-btn" onclick="erstelleAnrissplan()">📋 Anrissplan öffnen</button>
        <button class="anriss-btn" onclick="erstelleLattenrechner()" style="background: linear-gradient(135deg, #ff6b35 0%, #f7931e 100%); box-shadow: 0 4px 15px rgba(255, 107, 53, 0.3);">🔨 Lattenrechner</button>
        <button class="anriss-btn" onclick="erstellePVRechner()" style="background: linear-gradient(135deg, #f7971e 0%, #ffd200 100%); color:#1a1a1a; box-shadow: 0 4px 15px rgba(247, 151, 30, 0.3);">☀️ PV-Rechner</button>
      </div>
    )}
  </div>
</div>

<script src="/tools-js/rechteck.js" defer></script>

<style>
  /* Hinweisboxen innerhalb des Rechners – die globalen .section-Styles liefern
     bereits den dunklen Rahmen, hier nur die farbliche Akzentuierung. */
  .calc-note {
    background: rgba(14, 165, 233, 0.1);
    border-left: 4px solid var(--accent-blue);
    padding: 15px;
    border-radius: var(--radius-sm);
    margin-top: 15px;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  .calc-note--warning {
    background: rgba(245, 158, 11, 0.1);
    border-left-color: #f59e0b;
  }
  @media (max-width: 768px) {
    .result-item { flex-direction: column; text-align: left; gap: 2px; }
  }
</style>
