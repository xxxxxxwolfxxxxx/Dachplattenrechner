---
// Interaktive Zonenkarte (Schnee/Wind) mit Landkreis- und Gemeindeebene, Zoom und Verschieben.
// Geometrie: © GeoBasis-DE / BKG (VG250), dl-de/by-2-0 (siehe scripts/build-kreiskarte.py, build-gemeindekarte.py).
---

<section class="kk" aria-labelledby="kk-titel">
  <h2 id="kk-titel" class="kk-titel">Zonenkarte</h2>
  <div class="kk-steuerung">
    <div class="kk-umschalter" role="group" aria-label="Zonenart wählen">
      <button type="button" class="kk-modus" id="kk-schnee" aria-pressed="true">Schneelastzonen</button>
      <button type="button" class="kk-modus" id="kk-wind" aria-pressed="false">Windzonen</button>
    </div>
    <div class="kk-umschalter" role="group" aria-label="Detailgrad wählen">
      <button type="button" class="kk-modus" id="kk-ebene-kreis" aria-pressed="true">Landkreise</button>
      <button type="button" class="kk-modus" id="kk-ebene-gemeinde" aria-pressed="false">Gemeinden</button>
    </div>
  </div>

  <div class="kk-flaeche">
    <div class="kk-rahmen">
      <div class="kk-karte" id="kk-karte">
        <p class="kk-laden" id="kk-laden">Karte wird geladen …</p>
        <div class="kk-tooltip" id="kk-tooltip" role="tooltip" hidden></div>
      </div>
      <div class="kk-zoom" role="group" aria-label="Kartenausschnitt">
        <button type="button" id="kk-plus" aria-label="Hineinzoomen">+</button>
        <button type="button" id="kk-minus" aria-label="Herauszoomen">−</button>
        <button type="button" id="kk-reset" aria-label="Ganze Karte anzeigen">⌂</button>
      </div>
    </div>
    <div class="kk-legende" id="kk-legende" aria-live="polite"></div>
  </div>

  <p class="kk-tasten" id="kk-tastenhinweis">
    Tastatur: Karte mit Tab fokussieren, dann wählen die Pfeiltasten die Nachbarfläche, Enter oder Leertaste zeigt
    die Werte, + und − zoomen, 0 zeigt die ganze Karte.
  </p>
  <p class="kk-sr" id="kk-ansage" role="status" aria-live="polite"></p>

  <p class="kk-hinweis" id="kk-hinweis"></p>
  <p class="kk-quelle">
    Zonen: DIBt, Stand Schnee 07.02.2023, Wind 02.06.2022. Grenzen: © GeoBasis-DE / BKG
    (<a href="https://gdz.bkg.bund.de/index.php/default/verwaltungsgebiete-1-250-000-stand-01-01-vg250-01-01.html" rel="noopener">VG250</a>,
    Stand <span id="kk-stand">12/2022</span>), Datenlizenz Deutschland – Namensnennung 2.0, vereinfacht dargestellt.
  </p>
</section>

<script>
  import { kartenZone, type Datensatz, type KartenZone } from '../utils/schneelastzonen';

  interface KarteKreis { ags: string; name: string; land: string; k: string | null; stadt: boolean; d: string }
  interface KartenDaten { viewBox: [number, number]; stand: string; kreise: KarteKreis[] }
  /** [AGS, Name, Kreis-AGS, Schneezone, Windzone, Pfad] */
  type GemeindeEintrag = [string, string, string, string | null, string | null, string];
  interface GemeindeDaten { kreise: string[]; gemeinden: GemeindeEintrag[] }
  type Modus = 'schnee' | 'wind';
  type Ebene = 'kreis' | 'gemeinde';

  const SVG_NS = 'http://www.w3.org/2000/svg';
  const MAX_ZOOM = 14;
  const SCHRITT = 1.6;
  const LEGENDEN: Record<Modus, { zone: string; text: string }[]> = {
    schnee: [
      { zone: '1', text: 'Zone 1 – mind. 0,65 kN/m²' },
      { zone: '1a', text: 'Zone 1a – mind. 0,81 kN/m²' },
      { zone: '2', text: 'Zone 2 – mind. 0,85 kN/m²' },
      { zone: '2a', text: 'Zone 2a – mind. 1,06 kN/m²' },
      { zone: '3', text: 'Zone 3 – mind. 1,10 kN/m²' },
      { zone: '3a', text: 'Zone 3a – Sonderzone Bayern' },
    ],
    wind: [
      { zone: '1', text: 'Zone 1 – 22,5 m/s' },
      { zone: '2', text: 'Zone 2 – 25 m/s' },
      { zone: '3', text: 'Zone 3 – 27,5 m/s' },
      { zone: '4', text: 'Zone 4 – 30 m/s' },
    ],
  };
  const HINWEISE: Record<Ebene, string> = {
    kreis: 'Klicke auf einen Landkreis, um Zone und Werte oben anzuzeigen. Die Färbung zeigt die Standardzone des Landkreises; schraffierte Landkreise haben Gemeinden mit abweichender Zone – wechsle dafür zu „Gemeinden“.',
    gemeinde: 'Gemeinden sind dort einzeln dargestellt, wo die Zone im Landkreis wechselt; alle anderen Landkreise erscheinen als Fläche. Zoome mit + und −, Strg + Mausrad oder per Pinch, um einzelne Gemeinden zu erkennen. Zonen neu gebildeter Gemeinden sind aus den Vorgängergemeinden abgeleitet; wenige Gemeinden (graue Flächen, v. a. in Thüringen) fehlen in der DIBt-Tabelle.',
  };

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const container = el('kk-karte');
  const laden = el('kk-laden');
  const tooltip = el('kk-tooltip');
  const legende = el('kk-legende');
  const hinweisFeld = el('kk-hinweis');
  const ansage = el('kk-ansage');
  const modusKnoepfe: Record<Modus, HTMLButtonElement> = { schnee: el('kk-schnee'), wind: el('kk-wind') };
  const ebenenKnoepfe: Record<Ebene, HTMLButtonElement> = { kreis: el('kk-ebene-kreis'), gemeinde: el('kk-ebene-gemeinde') };

  let modus: Modus = 'schnee';
  let ebene: Ebene = 'kreis';
  let karte: KartenDaten | null = null;
  let gemeindeDaten: GemeindeDaten | null = null;
  let zonen: Record<Modus, KartenZone[]> | null = null;
  let svg: SVGSVGElement | null = null;
  let kreisPfade: SVGPathElement[] = [];
  let schraffuren: SVGPathElement[] = [];
  let gemeindePfade: SVGPathElement[] = [];
  let gemeindeGruppe: SVGGElement | null = null;
  let gewaehlt: SVGPathElement | null = null;
  let ansicht = { x: 0, y: 0, w: 1, h: 1 };
  let gesamt = { w: 1, h: 1 };
  let gezogen = false;
  let aktiv: SVGPathElement | null = null;
  let fokusRing: SVGPathElement | null = null;
  let tastaturAktiv = false;
  const mitten = new Map<SVGPathElement, [number, number]>();

  const ladeJson = <T,>(url: string): Promise<T> =>
    fetch(url).then((res) => {
      if (!res.ok) throw new Error(`${url}: HTTP ${res.status}`);
      return res.json() as Promise<T>;
    });

  const kurz = (z: KartenZone) => (z.haupt ? `Zone ${z.haupt}${z.gemischt ? ' (einzelne Gemeinden abweichend)' : ''}` : 'keine Angabe');
  const zahlText = (n: number) => n.toFixed(1);

  // ---- Ansicht (Zoom/Verschieben) --------------------------------------------------------------

  function setzeAnsicht(x: number, y: number, w: number): void {
    const breite = Math.min(gesamt.w, Math.max(gesamt.w / MAX_ZOOM, w));
    const hoehe = breite * (gesamt.h / gesamt.w);
    ansicht = {
      x: Math.min(gesamt.w - breite, Math.max(0, x)),
      y: Math.min(gesamt.h - hoehe, Math.max(0, y)),
      w: breite,
      h: hoehe,
    };
    svg?.setAttribute('viewBox', `${zahlText(ansicht.x)} ${zahlText(ansicht.y)} ${zahlText(ansicht.w)} ${zahlText(ansicht.h)}`);
    container.style.touchAction = ansicht.w < gesamt.w - 0.5 ? 'none' : 'pan-y';
  }

  /** Zoomt um einen Punkt (in Container-Anteilen 0..1), Faktor > 1 vergrößert. */
  function zoome(faktor: number, ax = 0.5, ay = 0.5): void {
    const neueBreite = ansicht.w / faktor;
    const neueHoehe = neueBreite * (gesamt.h / gesamt.w);
    setzeAnsicht(ansicht.x + (ansicht.w - neueBreite) * ax, ansicht.y + (ansicht.h - neueHoehe) * ay, neueBreite);
  }

  function ankerAus(e: { clientX: number; clientY: number }): [number, number] {
    const r = svg!.getBoundingClientRect();
    return [(e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height];
  }

  function richteSteuerungEin(): void {
    const zeiger = new Map<number, { x: number; y: number }>();
    let start: { x: number; y: number; ansicht: typeof ansicht } | null = null;
    let pinchAbstand = 0;

    container.addEventListener('wheel', (e) => {
      if (!(e.ctrlKey || e.metaKey)) return; // normales Scrollen der Seite nicht kapern
      e.preventDefault();
      const [ax, ay] = ankerAus(e);
      zoome(e.deltaY < 0 ? 1.25 : 1 / 1.25, ax, ay);
    }, { passive: false });

    container.addEventListener('pointerdown', (e) => {
      zeiger.set(e.pointerId, { x: e.clientX, y: e.clientY });
      gezogen = false;
      if (zeiger.size === 1) start = { x: e.clientX, y: e.clientY, ansicht: { ...ansicht } };
      if (zeiger.size === 2) {
        const [a, b] = [...zeiger.values()];
        pinchAbstand = Math.hypot(a.x - b.x, a.y - b.y);
      }
    });

    container.addEventListener('pointermove', (e) => {
      if (!zeiger.has(e.pointerId)) return;
      zeiger.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (zeiger.size === 2) {
        const [a, b] = [...zeiger.values()];
        const abstand = Math.hypot(a.x - b.x, a.y - b.y);
        if (pinchAbstand > 0) zoome(abstand / pinchAbstand, ...ankerAus({ clientX: (a.x + b.x) / 2, clientY: (a.y + b.y) / 2 }));
        pinchAbstand = abstand;
        gezogen = true;
        return;
      }
      if (!start || ansicht.w >= gesamt.w - 0.5) return;
      const dx = e.clientX - start.x;
      const dy = e.clientY - start.y;
      if (!gezogen && Math.hypot(dx, dy) < 5) return;
      if (!gezogen) container.setPointerCapture(e.pointerId);
      gezogen = true;
      const r = svg!.getBoundingClientRect();
      setzeAnsicht(start.ansicht.x - (dx / r.width) * start.ansicht.w, start.ansicht.y - (dy / r.height) * start.ansicht.h, start.ansicht.w);
      tooltip.hidden = true;
    });

    const ende = (e: PointerEvent) => {
      zeiger.delete(e.pointerId);
      if (zeiger.size < 2) pinchAbstand = 0;
      if (zeiger.size === 0) start = null;
    };
    container.addEventListener('pointerup', ende);
    container.addEventListener('pointercancel', ende);

    el('kk-plus').addEventListener('click', () => zoome(SCHRITT));
    el('kk-minus').addEventListener('click', () => zoome(1 / SCHRITT));
    el('kk-reset').addEventListener('click', () => setzeAnsicht(0, 0, gesamt.w));
  }

  // ---- Zeichnen ---------------------------------------------------------------------------------

  function erzeugePfad(d: string, klasse: string): SVGPathElement {
    const pfad = document.createElementNS(SVG_NS, 'path');
    pfad.setAttribute('d', d);
    pfad.setAttribute('class', klasse);
    return pfad;
  }

  function zeichneKreise(daten: KartenDaten): void {
    gesamt = { w: daten.viewBox[0], h: daten.viewBox[1] };
    svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('class', 'kk-svg');
    svg.setAttribute('aria-hidden', 'true');
    container.tabIndex = 0;
    container.setAttribute('role', 'application');
    container.setAttribute('aria-roledescription', 'interaktive Karte');
    container.setAttribute('aria-label', 'Zonenkarte der Landkreise und Gemeinden in Deutschland');
    container.setAttribute('aria-describedby', 'kk-tastenhinweis');

    const defs = document.createElementNS(SVG_NS, 'defs');
    defs.innerHTML =
      '<pattern id="kk-schraffur" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">' +
      '<line x1="0" y1="0" x2="0" y2="5" stroke="rgba(15,23,42,0.6)" stroke-width="1.6"/></pattern>';
    svg.append(defs);
    fokusRing = erzeugePfad('', 'kk-fokus');
    fokusRing.setAttribute('pointer-events', 'none');
    fokusRing.setAttribute('display', 'none');

    const kreisGruppe = document.createElementNS(SVG_NS, 'g');
    const schraffurGruppe = document.createElementNS(SVG_NS, 'g');
    schraffurGruppe.setAttribute('pointer-events', 'none');
    daten.kreise.forEach((kreis, i) => {
      const pfad = erzeugePfad(kreis.d, 'kk-kreis');
      pfad.dataset.art = 'kreis';
      pfad.dataset.index = String(i);
      kreisGruppe.append(pfad);
      kreisPfade.push(pfad);
      const schraffur = erzeugePfad(kreis.d, 'kk-schraffur');
      schraffur.setAttribute('fill', 'url(#kk-schraffur)');
      schraffurGruppe.append(schraffur);
      schraffuren.push(schraffur);
    });
    gemeindeGruppe = document.createElementNS(SVG_NS, 'g');
    gemeindeGruppe.setAttribute('display', 'none');
    svg.append(kreisGruppe, gemeindeGruppe, schraffurGruppe, fokusRing);

    svg.addEventListener('pointermove', zeigeTooltip);
    svg.addEventListener('pointerleave', () => { tooltip.hidden = true; });
    svg.addEventListener('click', waehle);
    svg.addEventListener('pointerdown', () => { tastaturAktiv = false; zeigeFokus(); });
    richteTastaturEin();
    laden.remove();
    container.prepend(svg);
    setzeAnsicht(0, 0, gesamt.w);
    richteSteuerungEin();
  }

  function zeichneGemeinden(daten: GemeindeDaten): void {
    if (!karte || !gemeindeGruppe) return;
    const fragment = document.createDocumentFragment();
    daten.gemeinden.forEach((g, i) => {
      const pfad = erzeugePfad(g[5], 'kk-gem');
      pfad.dataset.art = 'gemeinde';
      pfad.dataset.index = String(i);
      fragment.append(pfad);
      gemeindePfade.push(pfad);
    });
    gemeindeGruppe.append(fragment);
  }

  function faerbe(): void {
    if (!karte || !zonen) return;
    kreisPfade.forEach((pfad, i) => {
      const z = zonen![modus][i];
      // Ersetzte Landkreise bleiben als Unterlage sichtbar: Lücken zwischen vereinfachten Gemeindegrenzen zeigen so die Landkreisfarbe
      pfad.setAttribute('class', `kk-kreis kk-${modus}-${z.haupt ?? 'keine'}${pfad === gewaehlt ? ' kk-gewaehlt' : ''}`);
      schraffuren[i].style.display = z.gemischt && ebene === 'kreis' ? '' : 'none';
    });
    if (gemeindeDaten && gemeindeGruppe) {
      gemeindeGruppe.setAttribute('display', ebene === 'gemeinde' ? '' : 'none');
      gemeindePfade.forEach((pfad, i) => {
        const g = gemeindeDaten!.gemeinden[i];
        const zone = modus === 'schnee' ? g[3] : g[4];
        pfad.setAttribute('class', `kk-gem kk-${modus}-${zone ?? 'keine'}${pfad === gewaehlt ? ' kk-gewaehlt' : ''}`);
      });
    }
    zeichneLegende();
  }

  function zeichneLegende(): void {
    legende.replaceChildren();
    const zeile = (farbeKlasse: string, text: string) => {
      const z = document.createElement('div');
      z.className = 'kk-legende-zeile';
      const farbe = document.createElement('span');
      farbe.className = `kk-farbe ${farbeKlasse}`;
      z.append(farbe, document.createTextNode(text));
      legende.append(z);
    };
    for (const eintrag of LEGENDEN[modus]) zeile(`kk-${modus}-${eintrag.zone}`, eintrag.text);
    if (ebene === 'kreis') zeile('kk-muster', 'mehrere Zonen im Landkreis');
    else zeile('kk-keine', 'Zone nicht in der DIBt-Tabelle');
  }

  // ---- Interaktion ------------------------------------------------------------------------------

  function trefferDaten(ziel: SVGPathElement): { name: string; text: string } | null {
    if (!karte || !zonen) return null;
    const i = Number(ziel.dataset.index);
    if (ziel.dataset.art === 'gemeinde' && gemeindeDaten) {
      const g = gemeindeDaten.gemeinden[i];
      const zone = modus === 'schnee' ? g[3] : g[4];
      const kreis = karte.kreise.find((k) => k.ags === g[2]);
      return { name: `${g[1]}${kreis ? ` (${kreis.k ?? kreis.name})` : ''}`, text: zone ? `Zone ${zone}` : 'keine Angabe in der DIBt-Tabelle' };
    }
    return { name: karte.kreise[i].name, text: kurz(zonen[modus][i]) };
  }

  function zeigeTooltip(e: PointerEvent): void {
    const ziel = (e.target as Element).closest('.kk-kreis, .kk-gem') as SVGPathElement | null;
    const daten = ziel && !gezogen ? trefferDaten(ziel) : null;
    if (!daten) {
      tooltip.hidden = true;
      return;
    }
    const rect = container.getBoundingClientRect();
    tooltip.textContent = `${daten.name}: ${daten.text}`;
    tooltip.style.left = `${Math.max(0, Math.min(e.clientX - rect.left + 12, rect.width - 200))}px`;
    tooltip.style.top = `${e.clientY - rect.top + 14}px`;
    tooltip.hidden = false;
  }

  function waehle(e: MouseEvent): void {
    if (gezogen) return;
    const ziel = (e.target as Element).closest('.kk-kreis, .kk-gem') as SVGPathElement | null;
    if (ziel) waehleZiel(ziel);
  }

  function waehleZiel(ziel: SVGPathElement): void {
    if (!karte) return;
    gewaehlt?.classList.remove('kk-gewaehlt');
    ziel.classList.add('kk-gewaehlt');
    gewaehlt = ziel;
    aktiv = ziel;
    ziel.parentNode?.append(ziel); // nach vorn, damit der Rand nicht verdeckt wird
    const i = Number(ziel.dataset.index);
    if (ziel.dataset.art === 'gemeinde' && gemeindeDaten) {
      const g = gemeindeDaten.gemeinden[i];
      const kreis = karte.kreise.find((k) => k.ags === g[2]);
      if (!kreis) return;
      window.dispatchEvent(new CustomEvent('slz-karte', {
        detail: { land: kreis.land, kreis: kreis.k ?? kreis.name, stadt: false, gemeinde: g[1], zs: g[3], zw: g[4] },
      }));
      return;
    }
    const kreis = karte.kreise[i];
    window.dispatchEvent(new CustomEvent('slz-karte', { detail: { land: kreis.land, kreis: kreis.k ?? kreis.name, stadt: kreis.stadt } }));
  }

  // ---- Tastaturbedienung ------------------------------------------------------------------------

  type Richtung = 'links' | 'rechts' | 'oben' | 'unten';
  const PFEILE: Record<string, Richtung> = { ArrowLeft: 'links', ArrowRight: 'rechts', ArrowUp: 'oben', ArrowDown: 'unten' };

  /** Flächen, die auf der aktuellen Ebene sichtbar und wählbar sind (Landkreise, ersetzte Landkreise ausgenommen). */
  function kandidaten(): SVGPathElement[] {
    if (ebene === 'kreis' || !gemeindeDaten || !karte) return kreisPfade;
    const ersetzt = new Set(gemeindeDaten.kreise);
    return [...gemeindePfade, ...kreisPfade.filter((_, i) => !ersetzt.has(karte!.kreise[i].ags))];
  }

  function mitteVon(pfad: SVGPathElement): [number, number] {
    let m = mitten.get(pfad);
    if (!m) {
      const b = pfad.getBBox();
      m = [b.x + b.width / 2, b.y + b.height / 2];
      mitten.set(pfad, m);
    }
    return m;
  }

  function naechsteFlaeche(von: SVGPathElement, richtung: Richtung): SVGPathElement | null {
    const [cx, cy] = mitteVon(von);
    let beste: SVGPathElement | null = null;
    let besterWert = Infinity;
    for (const pfad of kandidaten()) {
      if (pfad === von) continue;
      const [x, y] = mitteVon(pfad);
      const dx = x - cx;
      const dy = y - cy;
      const entlang = richtung === 'rechts' ? dx : richtung === 'links' ? -dx : richtung === 'unten' ? dy : -dy;
      if (entlang <= 0.01) continue;
      const quer = richtung === 'links' || richtung === 'rechts' ? Math.abs(dy) : Math.abs(dx);
      const wert = entlang + 2 * quer; // Fläche in Blickrichtung, die möglichst wenig seitlich versetzt liegt
      if (wert < besterWert) {
        besterWert = wert;
        beste = pfad;
      }
    }
    return beste;
  }

  function ersteFlaeche(): SVGPathElement | null {
    if (gewaehlt && kandidaten().includes(gewaehlt)) return gewaehlt;
    const mx = ansicht.x + ansicht.w / 2;
    const my = ansicht.y + ansicht.h / 2;
    let beste: SVGPathElement | null = null;
    let besterAbstand = Infinity;
    for (const pfad of kandidaten()) {
      const [x, y] = mitteVon(pfad);
      const abstand = Math.hypot(x - mx, y - my);
      if (abstand < besterAbstand) {
        besterAbstand = abstand;
        beste = pfad;
      }
    }
    return beste;
  }

  function zeigeFokus(): void {
    if (!fokusRing) return;
    const sichtbar = tastaturAktiv && aktiv !== null && document.activeElement === container;
    fokusRing.setAttribute('display', sichtbar ? '' : 'none');
    if (sichtbar && aktiv) fokusRing.setAttribute('d', aktiv.getAttribute('d') ?? '');
  }

  const MODUS_NAME: Record<Modus, string> = { schnee: 'Schneelastzone', wind: 'Windzone' };

  function setzeAktiv(pfad: SVGPathElement): void {
    aktiv = pfad;
    zeigeFokus();
    const [x, y] = mitteVon(pfad);
    const randX = ansicht.w * 0.1;
    const randY = ansicht.h * 0.1;
    if (x < ansicht.x + randX || x > ansicht.x + ansicht.w - randX || y < ansicht.y + randY || y > ansicht.y + ansicht.h - randY) {
      setzeAnsicht(x - ansicht.w / 2, y - ansicht.h / 2, ansicht.w);
      zeigeFokus();
    }
    const daten = trefferDaten(pfad);
    if (daten) ansage.textContent = `${daten.name}: ${daten.text.replace(/^Zone/, MODUS_NAME[modus])}`;
  }

  function richteTastaturEin(): void {
    container.addEventListener('focus', zeigeFokus);
    container.addEventListener('blur', zeigeFokus);
    container.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      tastaturAktiv = true;
      const richtung = PFEILE[e.key];
      if (richtung) {
        e.preventDefault();
        const start = aktiv && kandidaten().includes(aktiv) ? aktiv : null;
        const ziel = start ? naechsteFlaeche(start, richtung) : ersteFlaeche();
        if (ziel) setzeAktiv(ziel);
        return;
      }
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const ziel = aktiv && kandidaten().includes(aktiv) ? aktiv : ersteFlaeche();
        if (!ziel) return;
        setzeAktiv(ziel);
        waehleZiel(ziel);
        const daten = trefferDaten(ziel);
        if (daten) ansage.textContent = `${daten.name} gewählt, ${daten.text.replace(/^Zone/, MODUS_NAME[modus])}. Die Werte stehen in der Suche.`;
        return;
      }
      if (e.key === '+' || e.key === '=') {
        e.preventDefault();
        zoome(SCHRITT);
      } else if (e.key === '-') {
        e.preventDefault();
        zoome(1 / SCHRITT);
      } else if (e.key === '0' || e.key === 'Home') {
        e.preventDefault();
        setzeAnsicht(0, 0, gesamt.w);
      }
    });
  }

  // ---- Umschalten und Laden -------------------------------------------------------------------

  function aktualisiereKnoepfe(): void {
    (Object.keys(modusKnoepfe) as Modus[]).forEach((m) => modusKnoepfe[m].setAttribute('aria-pressed', String(m === modus)));
    (Object.keys(ebenenKnoepfe) as Ebene[]).forEach((x) => ebenenKnoepfe[x].setAttribute('aria-pressed', String(x === ebene)));
    hinweisFeld.textContent = HINWEISE[ebene];
  }

  async function setzeEbene(neu: Ebene): Promise<void> {
    if (neu === 'gemeinde' && !gemeindeDaten) {
      ebenenKnoepfe.gemeinde.disabled = true;
      ebenenKnoepfe.gemeinde.textContent = 'Lädt …';
      try {
        gemeindeDaten = await ladeJson<GemeindeDaten>('/data/gemeindekarte.json');
        zeichneGemeinden(gemeindeDaten);
      } catch (fehler) {
        console.error('Gemeindekarte konnte nicht geladen werden', fehler);
        hinweisFeld.textContent = 'Die Gemeindekarte konnte nicht geladen werden. Bitte später erneut versuchen.';
        return;
      } finally {
        ebenenKnoepfe.gemeinde.disabled = false;
        ebenenKnoepfe.gemeinde.textContent = 'Gemeinden';
      }
    }
    ebene = neu;
    aktiv = null;
    zeigeFokus();
    aktualisiereKnoepfe();
    faerbe();
  }

  function setzeModus(neu: Modus): void {
    modus = neu;
    aktualisiereKnoepfe();
    faerbe();
  }

  let gestartet = false;
  async function starte(): Promise<void> {
    if (gestartet) return;
    gestartet = true;
    try {
      const [kartenDaten, schnee, wind] = await Promise.all([
        ladeJson<KartenDaten>('/data/kreiskarte.json'),
        ladeJson<Datensatz>('/data/schneelastzonen.json'),
        ladeJson<Datensatz>('/data/windzonen.json'),
      ]);
      karte = kartenDaten;
      zonen = {
        schnee: kartenDaten.kreise.map((k) => (k.k ? kartenZone(schnee, k.land, k.k, k.stadt) : { haupt: null, alle: [], gemischt: false })),
        wind: kartenDaten.kreise.map((k) => kartenZone(wind, k.land, k.k ?? k.name, k.stadt)),
      };
      el('kk-stand').textContent = kartenDaten.stand.slice(0, 7).split('-').reverse().join('/');
      zeichneKreise(kartenDaten);
      aktualisiereKnoepfe();
      faerbe();
    } catch (fehler) {
      console.error('Karte konnte nicht geladen werden', fehler);
      laden.textContent = 'Die Karte konnte nicht geladen werden. Bitte Seite neu laden oder die Suche oben nutzen.';
      gestartet = false;
    }
  }

  modusKnoepfe.schnee.addEventListener('click', () => setzeModus('schnee'));
  modusKnoepfe.wind.addEventListener('click', () => setzeModus('wind'));
  ebenenKnoepfe.kreis.addEventListener('click', () => void setzeEbene('kreis'));
  ebenenKnoepfe.gemeinde.addEventListener('click', async () => {
    await starte(); // falls der Beobachter noch nicht ausgelöst hat
    if (karte) await setzeEbene('gemeinde');
  });
  hinweisFeld.textContent = HINWEISE.kreis;

  if ('IntersectionObserver' in window) {
    const beobachter = new IntersectionObserver((eintraege) => {
      if (eintraege.some((e) => e.isIntersecting)) {
        beobachter.disconnect();
        void starte();
      }
    }, { rootMargin: '300px' });
    beobachter.observe(container);
  } else {
    void starte();
  }
</script>

