---
// Suche nach Schneelastzone per Postleitzahl, Ort oder Landkreis (Daten: DIBt, geladen beim ersten Fokus).
---

<section class="slz" aria-labelledby="slz-titel">
  <h2 id="slz-titel" class="slz-titel">Schneelastzone und Windzone für deinen Ort finden</h2>
  <label for="slz-eingabe" class="slz-label">Postleitzahl, Ort oder Landkreis</label>
  <input
    id="slz-eingabe"
    class="slz-eingabe"
    type="search"
    autocomplete="off"
    spellcheck="false"
    placeholder="z. B. 82467, Ostalbkreis, Hamburg"
    aria-describedby="slz-status"
  />
  <p id="slz-status" class="slz-status" role="status" aria-live="polite"></p>
  <ul id="slz-treffer" class="slz-treffer"></ul>
  <div id="slz-detail" class="slz-detail" hidden></div>
  <p class="slz-quelle">
    Datengrundlage: Zuordnung der Schneelastzonen (Stand <span id="slz-stand">07.02.2023</span>) und der
    Windzonen (Stand <span id="slz-wind-stand">02.06.2022</span>) nach Verwaltungsgrenzen des DIBt, je Gemeinde
    bzw. Landkreis. Die Zuordnung von Postleitzahlen zu Gemeinden beruht auf Koordinaten von
    <a href="https://www.geonames.org/" rel="noopener">GeoNames</a> (CC BY 4.0) und BKG-Gemeindegrenzen. Höhenrichtwerte stammen aus dem Höhenmodell Copernicus GLO-90 (über
    <a href="https://open-meteo.com/" rel="noopener">Open-Meteo</a>, CC BY 4.0). Bei Postleitzahlen, die mehrere Gemeinden umfassen, wählst du deine Gemeinde. Verbindlich sind die amtlichen Bekanntmachungen der Länder.
  </p>
</section>

<script>
  import {
    sucheOrt,
    gruppiereNachZone,
    istBerechenbar,
    windzone,
    kartenTreffer,
    gemeindeKartenTreffer,
    istPlz,
    sucheNachPlz,
    findeHoehe,
    BUNDESLAENDER,
    WINDWERTE,
    type Datensatz,
    type PlzDatensatz,
    type HoehenDatensatz,
    type Treffer,
  } from '../utils/schneelastzonen';
  import { schneelastSk, schneeFormbeiwert, dachSchneelast, lastVergleich } from '../utils/sparren';

  const SCHNEE_URL = '/data/schneelastzonen.json';
  const WIND_URL = '/data/windzonen.json';
  const PLZ_URL = '/data/plz.json';
  const HOEHEN_URL = '/data/hoehen.json';
  const eingabe = document.getElementById('slz-eingabe') as HTMLInputElement;
  const status = document.getElementById('slz-status') as HTMLElement;
  const liste = document.getElementById('slz-treffer') as HTMLUListElement;
  const detail = document.getElementById('slz-detail') as HTMLElement;
  const standFeld = document.getElementById('slz-stand') as HTMLElement;
  const windStandFeld = document.getElementById('slz-wind-stand') as HTMLElement;

  let daten: Datensatz | null = null;
  let wind: Datensatz | null = null;
  let laden: Promise<Datensatz | null> | null = null;
  let plzDaten: Promise<PlzDatensatz | null> | null = null;
  let hoehenDaten: Promise<HoehenDatensatz | null> | null = null;
  /** Windzone laut Postleitzahl-Daten je Treffer (Gemeinden außerhalb der Gemeindetabelle der Wind-Daten) */
  const windVorgaben = new WeakMap<Treffer, string | null>();

  const ladeJson = (url: string): Promise<Datensatz> =>
    fetch(url).then((res) => {
      if (!res.ok) throw new Error(`${url}: HTTP ${res.status}`);
      return res.json() as Promise<Datensatz>;
    });

  const datum = (iso: string) => iso.split('-').reverse().join('.');

  function ladeDaten(): Promise<Datensatz | null> {
    laden ??= Promise.all([ladeJson(SCHNEE_URL), ladeJson(WIND_URL)])
      .then(([schnee, windDaten]) => {
        daten = schnee;
        wind = windDaten;
        standFeld.textContent = datum(schnee.stand);
        windStandFeld.textContent = datum(windDaten.stand);
        return schnee;
      })
      .catch((fehler) => {
        console.error('Schneelastzonen konnten nicht geladen werden', fehler);
        status.textContent = 'Die Zonendaten konnten nicht geladen werden. Bitte Seite neu laden.';
        laden = null;
        return null;
      });
    return laden;
  }

  /** Höhenrichtwerte je Gemeinde; fehlen sie, bleibt das Höhenfeld einfach leer. */
  function ladeHoehen(): Promise<HoehenDatensatz | null> {
    hoehenDaten ??= fetch(HOEHEN_URL)
      .then((res) => (res.ok ? (res.json() as Promise<HoehenDatensatz>) : null))
      .catch(() => null);
    return hoehenDaten;
  }

  function ladePlz(): Promise<PlzDatensatz | null> {
    plzDaten ??= fetch(PLZ_URL)
      .then((res) => {
        if (!res.ok) throw new Error(`${PLZ_URL}: HTTP ${res.status}`);
        return res.json() as Promise<PlzDatensatz>;
      })
      .catch((fehler) => {
        console.error('Postleitzahlen konnten nicht geladen werden', fehler);
        status.textContent = 'Die Postleitzahl-Daten konnten nicht geladen werden. Bitte Seite neu laden oder den Ort eingeben.';
        plzDaten = null;
        return null;
      });
    return plzDaten;
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, klasse?: string, text?: string): HTMLElementTagNameMap[K] {
    const e = document.createElement(tag);
    if (klasse) e.className = klasse;
    if (text !== undefined) e.textContent = text;
    return e;
  }

  const zahl = (n: number) => n.toFixed(2).replace('.', ',');
  const zoneText = (z: string) => `Zone ${z}`;

  function skText(zone: string, hoehe: number | null): string {
    if (zone === '>3' || zone === '>3a') return 'Sonderfall oberhalb Zone 3: s_k individuell beim Bauamt oder Statiker erfragen.';
    if (!istBerechenbar(zone)) return 'Sonderzone aus dem Bayerischen Forschungsprojekt: s_k beim Bauamt oder Statiker erfragen.';
    const sk = schneelastSk(zone, hoehe ?? 0);
    return hoehe === null
      ? `Mindestwert s_k = ${zahl(sk)} kN/m² (ca. ${Math.round(sk * 100)} kg/m²) – steigt mit der Geländehöhe.`
      : `Auf ${hoehe} m ü. NN: s_k = ${zahl(sk)} kN/m² (ca. ${Math.round(sk * 100)} kg/m²).`;
  }

  function neigungText(sk: number, neigung: number | null): string {
    const grundlage = `Grundlage ist der Bodenwert s_k = ${zahl(sk)} kN/m²`;
    if (neigung === null) return `${grundlage} mit dem Formbeiwert 0,8 für Dächer bis 30° Neigung; bei steileren Dächern sinkt der Wert. Trage oben deine Dachneigung ein, dann wird er genauer.`;
    const mu = schneeFormbeiwert(neigung);
    if (mu === 0) return `${grundlage}. Bei ${neigung}° Dachneigung rutscht der Schnee ab, die Norm setzt ohne Schneefanggitter keine Dachschneelast an (mit Schneefanggitter oder Aufbauten gilt das nicht).`;
    return `${grundlage} mit dem Formbeiwert ${mu.toFixed(2).replace('.', ',')} für ${neigung}° Dachneigung (bis 30° gilt 0,8).`;
  }

  /** Fazit: Last pro m², die das Dach am Ort aushalten muss (Schnee aus Zone und Höhe, Wind als Basiswert). */
  function aktualisiereFazit(box: HTMLElement, ort: string, zone: string | null, hoehe: number | null, windZone: string | null, geschaetzt: boolean, neigung: number | null): void {
    box.replaceChildren();
    const teile: HTMLElement[] = [];
    if (zone && istBerechenbar(zone)) {
      const sk = schneelastSk(zone, hoehe ?? 0);
      const dach = dachSchneelast(sk, neigung);
      const hoehenText = hoehe === null ? ' (Mindestwert; gib oben die Geländehöhe an, dann wird er genauer)' : geschaetzt ? ` (bei ca. ${hoehe} m ü. NN, Ortsmitte; passe die Höhe oben an dein Grundstück an)` : ` (auf ${hoehe} m ü. NN)`;
      const p = el('p');
      p.append(
        el('strong', undefined, 'Schnee: '),
        document.createTextNode(
          (dach > 0
            ? `Das Dach muss in ${ort} mindestens ca. ${Math.round(dach * 100)} kg/m² (${zahl(dach)} kN/m²) Schneelast tragen${hoehenText}. `
            : `Für ${ort} setzt die Norm bei dieser Neigung keine Schneelast auf dem Dach an${hoehenText}. `) +
          neigungText(sk, neigung),
        ),
      );
      teile.push(p);
      if (dach > 0) {
        const v = lastVergleich(dach);
        const saecke = String(v.zementSaecke).replace('.', ',');
        teile.push(
          el(
            'p',
            'slz-vergleich',
            `Zum Vorstellen: Das entspricht etwa ${v.neuschneeCm} cm Neuschnee, ${v.nassschneeCm} cm nassem, schwerem Schnee oder ${saecke} Säcken Zement (je 25 kg) auf jedem Quadratmeter. Grobe Schätzung mit Schneewichten von 1 bzw. 4 kN/m³ (DIN EN 1991-1-3); echter Schnee ist je nach Zustand leichter oder schwerer.`,
          ),
        );
      }
    } else if (zone) {
      teile.push(el('p', undefined, 'Schnee: Für diese Sonderzone muss die Schneelast beim Bauamt oder Statiker erfragt werden.'));
    }
    const werte = windZone ? WINDWERTE[windZone] : undefined;
    if (werte) {
      const p = el('p');
      p.append(
        el('strong', undefined, 'Wind: '),
        document.createTextNode(
          `Basis-Staudruck ca. ${Math.round(werte.q * 100)} kg/m² (${zahl(werte.q)} kN/m²). Am Dach wirken je nach Höhe, Dachform und Lage ` +
          'zusätzlich Druck- und vor allem Sogkräfte, die an Rand, Traufe und Ecken deutlich größer sind – Befestigung und Unterkonstruktion sind dafür auszulegen.',
        ),
      );
      teile.push(p);
    }
    if (teile.length === 0) return;
    box.append(el('h4', 'slz-fazit-titel', 'Fazit: Das muss dein Dach aushalten'), ...teile);
    box.append(el('p', 'slz-fazit-hinweis', 'Richtwerte zusätzlich zum Eigengewicht der Dachdeckung. Die verbindliche Bemessung (Lastkombinationen, Dachform, Geländekategorie) macht der Statiker.'));
  }

  type Verlauf = 'push' | 'replace' | 'keine';
  type Vorauswahl = { g: string; k: string; a: string };

  /** Suche und Auswahl stehen in der URL (?plz= bzw. ?ort=, dazu g/k/a für den gewählten Treffer), damit Links teilbar sind. */
  function schreibeUrl(suche: string, t: Treffer | null, verlauf: Verlauf): void {
    if (verlauf === 'keine') return;
    const q = new URLSearchParams();
    const text = suche.trim();
    if (text.length >= 2) {
      q.set(istPlz(text) ? 'plz' : 'ort', text);
      if (t) {
        q.set('g', t.name);
        q.set('k', t.kreis);
        q.set('a', t.art);
      }
    }
    const qs = q.toString();
    const ziel = `${location.pathname}${qs ? `?${qs}` : ''}`;
    if (ziel === `${location.pathname}${location.search}`) return;
    if (verlauf === 'push') history.pushState(null, '', ziel);
    else history.replaceState(null, '', ziel);
  }

  const DRUCK_STIL = `
    body { font: 11pt/1.45 system-ui, -apple-system, 'Segoe UI', sans-serif; color: #111; margin: 0; }
    h1 { font-size: 16pt; margin: 0 0 2pt; }
    .meta { color: #444; font-size: 9pt; margin: 0 0 14pt; word-break: break-all; }
    .slz-name { font-size: 14pt; margin: 0; }
    .slz-ort { margin: 2pt 0 10pt; color: #333; }
    .slz-zone { display: flex; align-items: baseline; gap: 10pt; margin: 8pt 0 0; }
    .slz-zone-label { font-size: 9pt; text-transform: uppercase; letter-spacing: .04em; color: #333; font-weight: 600; }
    .slz-zone-num { font-size: 22pt; font-weight: 800; line-height: 1; }
    .slz-wind { margin-top: 10pt; padding-top: 8pt; border-top: 1px solid #999; }
    .slz-sk, .angaben { margin: 8pt 0; }
    .slz-fazit { margin: 12pt 0; padding: 8pt 10pt; border: 1.5px solid #111; border-radius: 4pt; break-inside: avoid; }
    .slz-fazit-titel { margin: 0 0 4pt; font-size: 12pt; }
    .slz-fazit p { margin: 4pt 0; }
    .slz-fazit-hinweis, .slz-vergleich, .slz-hoehe-hinweis { font-size: 9pt; color: #333; }
    .slz-hinweise, .slz-hinweise-text { font-size: 10pt; }
    .statiker { margin-top: 14pt; padding: 8pt 10pt; background: #eee; font-size: 10pt; break-inside: avoid; }
    .slz-quelle { margin-top: 14pt; font-size: 8pt; color: #333; }
    @page { margin: 18mm; }
  `;

  /** Druckansicht in einem unsichtbaren iframe: eigene Hell-auf-Weiß-Gestaltung, ohne Navigation und Eingabefelder. */
  function druckeErgebnis(quelle: HTMLElement, hoehe: string, neigung: string, ort: string): void {
    const kopie = quelle.cloneNode(true) as HTMLElement;
    for (const weg of kopie.querySelectorAll('.slz-felder, .slz-hoehe-hinweis, .slz-weiter, .slz-gemeinden')) weg.remove();
    const angaben = el('p', 'angaben');
    const teile: string[] = [];
    if (hoehe.trim() !== '') teile.push(`Geländehöhe ${hoehe.trim()} m ü. NN`);
    if (neigung.trim() !== '') teile.push(`Dachneigung ${neigung.trim()}°`);
    angaben.textContent = teile.length > 0 ? `Angaben für die Berechnung: ${teile.join(', ')}.` : 'Keine Höhe und keine Dachneigung angegeben, es gelten Mindestwerte.';
    kopie.querySelector('.slz-sk')?.after(angaben);

    const zusatz = document.querySelector('.slz-quelle')?.cloneNode(true) as HTMLElement | undefined;
    const hinweis = el('p', 'statiker', 'Hinweis: Die Werte sind eine Vorbemessung zur Planung und keine Statik. Für Bauanträge, Solaranlagen, Gründächer, große Spannweiten und Altbauten ist ein Standsicherheitsnachweis durch einen Tragwerksplaner nötig. Verbindlich sind die Angaben der Bauaufsicht.');
    const meta = el('p', 'meta', `Stand ${new Date().toLocaleDateString('de-DE')} · ${location.origin}${location.pathname}${location.search}`);
    const titel = el('h1', undefined, 'Schnee- und Windlast für deinen Ort');

    const rahmen = document.createElement('iframe');
    rahmen.title = 'Druckansicht';
    rahmen.setAttribute('aria-hidden', 'true');
    rahmen.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;';
    const inhalt = document.createElement('div');
    inhalt.append(titel, meta, kopie, hinweis);
    if (zusatz) inhalt.append(zusatz);
    const kopfTitel = `Schneelastzone ${ort}`.replace(/[<>&]/g, '');
    rahmen.srcdoc = `<!doctype html><html lang="de"><head><meta charset="utf-8"><title>${kopfTitel}</title><style>${DRUCK_STIL}</style></head><body>${inhalt.innerHTML}</body></html>`;
    rahmen.addEventListener('load', () => {
      const fenster = rahmen.contentWindow;
      if (!fenster) return;
      fenster.addEventListener('afterprint', () => rahmen.remove());
      fenster.focus();
      fenster.print();
    });
    document.body.append(rahmen);
  }

  function zeigeDetail(t: Treffer, windVorgabe: string | null = null, verlauf: Verlauf = 'push'): void {
    schreibeUrl(eingabe.value, t, verlauf);
    detail.replaceChildren();
    detail.hidden = false;

    const kopf = el('div', 'slz-kopf');
    kopf.append(el('h3', 'slz-name', t.name));
    const ort = t.art === 'gemeinde' && t.kreis !== t.name ? `${t.kreis}, ` : '';
    kopf.append(el('p', 'slz-ort', `${ort}${BUNDESLAENDER[t.land]}`));
    detail.append(kopf);

    const zonenBlock = el('div', 'slz-zonen');
    const hauptZone = t.zone;
    if (hauptZone) {
      const feld = el('div', 'slz-zone');
      feld.append(el('span', 'slz-zone-label', t.art === 'kreis' ? 'Standardzone' : 'Schneelastzone'));
      feld.append(el('span', 'slz-zone-num', hauptZone));
      zonenBlock.append(feld);
    } else {
      const feld = el('div', 'slz-zone');
      feld.append(el('span', 'slz-zone-label', 'Je nach Gemeinde'));
      feld.append(el('span', 'slz-zone-num', t.zonen.join(' / ')));
      zonenBlock.append(feld);
    }
    detail.append(zonenBlock);

    const skZeile = el('p', 'slz-sk');
    detail.append(skZeile);
    const hoehenFeld = el('div', 'slz-hoehe');
    const hoehenLabel = el('label', undefined, 'Geländehöhe in m ü. NN (optional)');
    hoehenLabel.htmlFor = 'slz-hoehe';
    const hoehenEingabe = el('input');
    hoehenEingabe.id = 'slz-hoehe';
    hoehenEingabe.type = 'number';
    hoehenEingabe.min = '0';
    hoehenEingabe.max = '3000';
    hoehenEingabe.step = '10';
    hoehenEingabe.inputMode = 'numeric';
    hoehenEingabe.placeholder = 'z. B. 450';
    hoehenFeld.append(hoehenLabel, hoehenEingabe);
    const neigungFeld = el('div', 'slz-hoehe');
    const neigungLabel = el('label', undefined, 'Dachneigung in Grad (optional)');
    neigungLabel.htmlFor = 'slz-neigung';
    const neigungEingabe = el('input');
    neigungEingabe.id = 'slz-neigung';
    neigungEingabe.type = 'number';
    neigungEingabe.min = '0';
    neigungEingabe.max = '90';
    neigungEingabe.step = '1';
    neigungEingabe.inputMode = 'numeric';
    neigungEingabe.placeholder = 'z. B. 35';
    neigungFeld.append(neigungLabel, neigungEingabe);
    const felder = el('div', 'slz-felder');
    felder.append(hoehenFeld, neigungFeld);

    const fazit = el('div', 'slz-fazit');
    const weiter = el('p', 'slz-weiter');
    const link = el('a', undefined, 'Mit dieser Zone Sparren vorbemessen →');
    link.href = '/tools/sparren-rechner/';
    const aktualisiereLink = (h: number | null, neigung: number | null) => {
      const q = new URLSearchParams();
      if (hauptZone) q.set('zone', hauptZone);
      if (hauptZone && h !== null) q.set('hoehe', String(Math.round(h)));
      if (hauptZone && neigung !== null) q.set('neigung', String(neigung));
      if (hauptZone) q.set('ort', t.name);
      const qs = q.toString();
      link.href = `/tools/sparren-rechner/${qs ? `?${qs}` : ''}`;
    };
    let hoeheGeschaetzt = false;
    let windZoneFazit: string | null = null;
    const aktualisiere = () => {
      const roh = hoehenEingabe.value.trim();
      const h = roh === '' ? null : Math.min(3000, Math.max(0, Number(roh)));
      const nRoh = neigungEingabe.value.trim();
      const n = nRoh === '' ? null : Math.min(90, Math.max(0, Number(nRoh)));
      const neigung = n !== null && Number.isFinite(n) ? Math.round(n) : null;
      aktualisiereFazit(fazit, t.name, hauptZone, Number.isFinite(h) ? h : null, windZoneFazit, hoeheGeschaetzt, neigung);
      aktualisiereLink(Number.isFinite(h) ? h : null, neigung);
      skZeile.replaceChildren();
      if (hauptZone) {
        skZeile.append(el('strong', undefined, 'Schneelast am Boden: '), document.createTextNode(skText(hauptZone, Number.isFinite(h) ? h : null)));
        return;
      }
      skZeile.append(document.createTextNode('Die Schneelast hängt von der Zone der Gemeinde ab. Wähle unten deine Gemeinde.'));
    };
    const hoehenHinweis = el('p', 'slz-hoehe-hinweis');
    hoehenHinweis.hidden = true;
    hoehenEingabe.addEventListener('input', () => {
      hoeheGeschaetzt = false;
      hoehenHinweis.hidden = true;
      aktualisiere();
    });
    neigungEingabe.addEventListener('input', aktualisiere);
    if (hauptZone) detail.append(felder, hoehenHinweis);
    if (hauptZone && t.art === 'gemeinde') {
      void ladeHoehen().then((hoehen) => {
        const m = hoehen ? findeHoehe(hoehen, t.land, t.kreis, t.name) : null;
        if (m === null || hoehenEingabe.value !== '' || !detail.contains(hoehenEingabe)) return;
        hoehenEingabe.value = String(m);
        hoeheGeschaetzt = true;
        hoehenHinweis.textContent = `Vorbelegt mit der Höhe der Ortsmitte (ca. ${m} m ü. NN, Höhenmodell). Liegt dein Grundstück höher oder tiefer, trage die Höhe ein.`;
        hoehenHinweis.hidden = false;
        aktualisiere();
      });
    }
    aktualisiere();

    if (t.gemeinden.length > 0) {
      const gruppen = gruppiereNachZone(t.gemeinden);
      const box = el('details', 'slz-gemeinden');
      if (!hauptZone) box.open = true;
      box.append(el('summary', undefined, hauptZone ? 'Gemeinden mit abweichender Zone' : 'Gemeinden dieses Landkreises nach Zone'));
      for (const g of gruppen) {
        const p = el('p');
        p.append(el('strong', undefined, `${zoneText(g.zone)}: `), document.createTextNode(g.namen.join(', ')));
        box.append(p);
      }
      detail.append(box);
    }

    const gefunden = wind ? windzone(wind, t) : null;
    const w = windVorgabe && gefunden ? { ...gefunden, zone: windVorgabe, zonen: [windVorgabe] } : gefunden;
    if (w) {
      const block = el('div', 'slz-wind');
      const kopfZeile = el('div', 'slz-zone');
      kopfZeile.append(
        el('span', 'slz-zone-label', w.zone ? 'Windzone' : 'Windzone je nach Gemeinde'),
        el('span', 'slz-zone-num slz-zone-wind', w.zone ?? w.zonen.join(' / ')),
      );
      block.append(kopfZeile);
      const werte = w.zone ? WINDWERTE[w.zone] : undefined;
      if (werte) {
        block.append(
          el('p', 'slz-sk', `Basiswerte: v_b,0 = ${werte.v.toString().replace('.', ',')} m/s, q_b,0 = ${zahl(werte.q)} kN/m² (ca. ${Math.round(werte.q * 100)} kg/m²). Der Winddruck am Bauwerk hängt zusätzlich von Gebäudehöhe und Geländekategorie ab.`),
        );
      }
      if (w.hinweis) block.append(el('p', 'slz-hinweise-text', w.hinweis));
      detail.append(block);
    }

    windZoneFazit = w?.zone ?? null;
    detail.append(fazit);
    aktualisiere();

    if (t.hinweise.length > 0) {
      const ul = el('ul', 'slz-hinweise');
      for (const h of t.hinweise) ul.append(el('li', undefined, h));
      detail.append(ul);
    }

    weiter.append(link);
    if (hauptZone) {
      const druck = el('button', 'slz-druck-knopf', 'Ergebnis drucken');
      druck.type = 'button';
      druck.addEventListener('click', () => druckeErgebnis(detail, hoehenEingabe.value, neigungEingabe.value, t.name));
      weiter.append(druck);
    }
    detail.append(weiter);
    detail.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }

  function zeigeTreffer(treffer: Treffer[], suche: string, hinweis = '', vorauswahl: Vorauswahl | null = null): void {
    liste.replaceChildren();
    detail.hidden = true;
    if (suche.trim().length < 2) {
      status.textContent = '';
      return;
    }
    if (!vorauswahl) schreibeUrl(suche, null, 'replace');
    if (treffer.length === 0) {
      status.textContent = istPlz(suche)
        ? `Für die Postleitzahl ${suche.trim()} liegt keine Zuordnung vor${hinweis}. Probiere den Ort oder den Landkreis.`
        : `Kein Ort „${suche.trim()}“ gefunden. Probiere den Landkreis oder eine nahegelegene größere Gemeinde.`;
      return;
    }
    status.textContent = istPlz(suche)
      ? `Postleitzahl ${suche.trim()}: ${treffer.length === 1 ? 'eine Gemeinde' : `${treffer.length} Gemeinden – bitte deine auswählen`}${hinweis}`
      : `${treffer.length} Treffer${treffer.length === 20 ? ' (bitte Suche eingrenzen)' : ''}`;
    for (const t of treffer) {
      const li = el('li');
      const knopf = el('button', 'slz-knopf');
      knopf.type = 'button';
      const zonen = t.art === 'kreis' && t.zonen.length > 1 ? t.zonen.join('/') : (t.zone ?? t.zonen.join('/'));
      knopf.append(
        el('span', 'slz-knopf-name', t.art === 'kreis' ? `${t.name} (Landkreis)` : t.name),
        el('span', 'slz-knopf-ort', t.art === 'kreis' ? BUNDESLAENDER[t.land] : `${t.kreis !== t.name ? t.kreis + ', ' : ''}${BUNDESLAENDER[t.land]}`),
        el('span', 'slz-knopf-zone', `Zone ${zonen}`),
      );
      knopf.addEventListener('click', () => zeigeDetail(t, windVorgaben.get(t) ?? null, 'push'));
      li.append(knopf);
      liste.append(li);
    }
    const gewaehlt = vorauswahl && treffer.find((t) => t.name === vorauswahl.g && t.kreis === vorauswahl.k && t.art === vorauswahl.a);
    if (gewaehlt) zeigeDetail(gewaehlt, windVorgaben.get(gewaehlt) ?? null, 'keine');
    else if (treffer.length === 1) zeigeDetail(treffer[0], windVorgaben.get(treffer[0]) ?? null, vorauswahl ? 'keine' : 'replace');
  }

  // Klick auf die Landkreis-Karte (KreisKarte.astro) zeigt dieselbe Detailansicht wie ein Suchtreffer
  window.addEventListener('slz-karte', async (e) => {
    const { land, kreis, stadt, gemeinde, zs, zw } = (e as CustomEvent<{
      land: string; kreis: string; stadt: boolean; gemeinde?: string; zs?: string | null; zw?: string | null;
    }>).detail;
    const d = daten ?? (await ladeDaten());
    if (!d) return;
    const treffer = gemeinde ? gemeindeKartenTreffer(d, land, kreis, gemeinde, zs ?? null) : kartenTreffer(d, land, kreis, stadt);
    if (!treffer) {
      detail.hidden = true;
      liste.replaceChildren();
      status.textContent = gemeinde
        ? `Für ${gemeinde} enthält die DIBt-Tabelle keine Schneelastzone (Gemeinde vermutlich neu gebildet). Bitte beim Bauamt erfragen.`
        : `Für ${kreis} enthält die DIBt-Tabelle keine Schneelastzone.`;
      return;
    }
    liste.replaceChildren();
    status.textContent = '';
    eingabe.value = treffer.name;
    zeigeDetail(treffer, zw ?? null, 'push');
  });

  async function suchen(suche: string): Promise<{ treffer: Treffer[]; hinweis: string } | null> {
    const d = daten ?? (await ladeDaten());
    if (!d) return null;
    if (istPlz(suche)) {
      const p = await ladePlz();
      if (!p) return null;
      const { treffer, ohneZone } = sucheNachPlz(p, d, suche);
      for (const t of treffer) windVorgaben.set(t.treffer, t.windzone);
      return { treffer: treffer.map((t) => t.treffer), hinweis: ohneZone > 0 ? ` (${ohneZone} weitere ohne Zone in der DIBt-Tabelle)` : '' };
    }
    return { treffer: sucheOrt(d, suche), hinweis: '' };
  }

  let timer: number | undefined;
  eingabe.addEventListener('focus', () => void ladeDaten(), { once: true });
  eingabe.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(async () => {
      const suche = eingabe.value;
      const ergebnis = await suchen(suche);
      if (!ergebnis || eingabe.value !== suche) return;
      zeigeTreffer(ergebnis.treffer, suche, ergebnis.hinweis);
    }, 120);
  });

  /** Stellt Suche und Auswahl aus der URL wieder her (Seitenaufruf, Zurück-Button). */
  async function ausUrl(): Promise<void> {
    const q = new URLSearchParams(location.search);
    const suche = (q.get('plz') ?? q.get('ort') ?? '').trim().slice(0, 80);
    eingabe.value = suche;
    if (suche.length < 2) {
      liste.replaceChildren();
      detail.hidden = true;
      status.textContent = '';
      return;
    }
    const ergebnis = await suchen(suche);
    if (!ergebnis || eingabe.value !== suche) return;
    const g = q.get('g');
    const vorauswahl = g ? { g, k: q.get('k') ?? '', a: q.get('a') ?? '' } : null;
    zeigeTreffer(ergebnis.treffer, suche, ergebnis.hinweis, vorauswahl ?? { g: '', k: '', a: '' });
  }
  window.addEventListener('popstate', () => void ausUrl());
  if (location.search) void ausUrl();
</script>

