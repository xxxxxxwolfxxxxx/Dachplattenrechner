---
import CookieBanner from '../components/CookieBanner.astro';
import SchemaMarkup from '../components/SchemaMarkup.astro';
import type { Breadcrumb, FaqEntry } from '../components/SchemaMarkup.astro';
import '../styles/main.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  schemaType?: 'LocalBusiness' | 'WebApplication' | 'FAQPage';
  breadcrumbs?: Breadcrumb[];
  faq?: FaqEntry[];
  extraSchema?: Record<string, unknown>[];
  noindex?: boolean;
}
const {
  title,
  description = 'Kostenlose Berechnungstools für Trapezbleche, Dachplatten und Wärmeschutz.',
  keywords = 'Trapezblech, Trapezbleche, Dachplatten, Lichtplatten, Trapezblech Rechner, Dachblech berechnen, Schnittliste, Anrissplan, Lattung berechnen, Dachdeckung, Trapezprofil, Stahlblech Dach, Wellblech, Sandwichpaneel, Dachrechner, Baurechner',
  ogImage,
  schemaType = 'WebApplication',
  breadcrumbs,
  faq,
  extraSchema,
  noindex = false,
} = Astro.props;

const GA_ID = 'G-6NSYG8B1T9';
const fullTitle = title.includes('Dachplattenrechner') ? title : `${title} | Dachplattenrechner.de`;
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="keywords" content={keywords} />
  <meta name="google-adsense-account" content="ca-pub-8687929894744033" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="canonical" href={Astro.url.href} />
  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <!-- AdSense Kontext-Hint: Bau & Handwerk, kein Entertainment -->
  <script>
    window.googletag = window.googletag || { cmd: [] };
    (window.adsbygoogle = window.adsbygoogle || []).requestNonPersonalizedAds = 0;
  </script>
  <!-- Google Analytics (gtag geladen; Konfiguration erst nach Cookie-Consent) -->
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
  <script define:vars={{ GA_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    gtag('js', new Date());
    // gtag('config', GA_ID) wird erst nach Cookie-Consent aus cookie-consent.ts aufgerufen
  </script>
  <!-- Schema.org Markup -->
  <SchemaMarkup type={schemaType} title={title} description={description} url={Astro.url.href} breadcrumbs={breadcrumbs} faq={faq} extra={extraSchema} />
</head>
<body>
  <slot />
  <CookieBanner />
</body>
</html>
