---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AdUnit from '../components/AdUnit.astro';

import type { Breadcrumb, FaqEntry } from '../components/SchemaMarkup.astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  navTitle?: string;
  background?: string;   // CSS background-image, z.B. "url('/images/Lattung.png')"
  backHref?: string;
  backLabel?: string;
  breadcrumbs?: Breadcrumb[];
  faq?: FaqEntry[];
  extraSchema?: Record<string, unknown>[];
}
const { title, description, keywords, navTitle, background, backHref, backLabel, breadcrumbs, faq, extraSchema } = Astro.props;

// Ohne explizite Angabe: Startseite › Rechner › aktuelle Seite
const trail: Breadcrumb[] = breadcrumbs ?? [
  { name: 'Startseite', url: '/' },
  { name: 'Rechner', url: '/tools/dachformen/' },
  { name: navTitle ?? title, url: Astro.url.pathname },
];
---
<BaseLayout title={title} description={description} keywords={keywords} breadcrumbs={trail} faq={faq} extraSchema={extraSchema}>
  <Nav title={navTitle ?? title} backHref={backHref} backLabel={backLabel} />

  {background && (
    <div class="tool-bg" style={`background-image: ${background};`}></div>
  )}

  <main class="tool-main container">
    <slot />
  </main>

  <div class="container">
    <AdUnit position="bottom" adSlot="8291579285" adSlot2="5573713344" adSlot3="4283946313" />
  </div>

  <Footer />
</BaseLayout>

<style>
  .tool-bg {
    position: fixed;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    z-index: -1;
    opacity: 0.35;
    pointer-events: none;
  }
  .tool-main {
    padding: 40px 20px 60px;
    min-height: 65vh;
  }
  @media (max-width: 768px) {
    .tool-main { padding: 24px 16px 40px; }
  }
</style>
