import React, { useState, useEffect, useRef } from 'react';
import { Search, MapPin, AlertCircle } from 'lucide-react';

const LastzonenKarte = () => {
  const [map, setMap] = useState(null);
  const [marker, setMarker] = useState(null);
  const [plz, setPlz] = useState('');
  const [result, setResult] = useState(null);
  const [activeLayer, setActiveLayer] = useState('both'); // 'snow', 'wind', 'both'
  const mapRef = useRef(null);
  const L = useRef(null);
  const snowLayerRef = useRef(null);
  const windLayerRef = useRef(null);

  // Vereinfachte Zonendaten (PLZ-basiert) - müssen durch echte Daten ersetzt werden
  const zoneData = {
    // Schneelastzonen: Zone 1 (0,65 kN/m²), 1a (0,85 kN/m²), 2 (1,00 kN/m²), 2a (1,25 kN/m²), 3 (1,85 kN/m²)
    // Windlastzonen: Zone 1-4 (Windgeschwindigkeiten)
    snow: {
      '0': { zone: '1', value: '0,65 kN/m²', color: '#e8f5e9' },
      '1': { zone: '1', value: '0,65 kN/m²', color: '#e8f5e9' },
      '2': { zone: '1a', value: '0,85 kN/m²', color: '#c8e6c9' },
      '3': { zone: '2', value: '1,00 kN/m²', color: '#a5d6a7' },
      '4': { zone: '2', value: '1,00 kN/m²', color: '#a5d6a7' },
      '5': { zone: '2', value: '1,00 kN/m²', color: '#a5d6a7' },
      '6': { zone: '2', value: '1,00 kN/m²', color: '#a5d6a7' },
      '7': { zone: '2a', value: '1,25 kN/m²', color: '#81c784' },
      '8': { zone: '3', value: '1,85 kN/m²', color: '#66bb6a' },
      '9': { zone: '2', value: '1,00 kN/m²', color: '#a5d6a7' }
    },
    wind: {
      '0': { zone: '1', value: '22,5 m/s', color: '#e3f2fd' },
      '1': { zone: '1', value: '22,5 m/s', color: '#e3f2fd' },
      '2': { zone: '2', value: '25,0 m/s', color: '#bbdefb' },
      '3': { zone: '2', value: '25,0 m/s', color: '#bbdefb' },
      '4': { zone: '2', value: '25,0 m/s', color: '#bbdefb' },
      '5': { zone: '2', value: '25,0 m/s', color: '#bbdefb' },
      '6': { zone: '2', value: '25,0 m/s', color: '#bbdefb' },
      '7': { zone: '3', value: '27,5 m/s', color: '#90caf9' },
      '8': { zone: '3', value: '27,5 m/s', color: '#90caf9' },
      '9': { zone: '2', value: '25,0 m/s', color: '#bbdefb' }
    },
    authorities: {
      '0': 'Bauaufsichtsbehörde Berlin',
      '1': 'Bauaufsichtsbehörde Hamburg',
      '2': 'Bauaufsichtsbehörde Hannover',
      '3': 'Bauaufsichtsbehörde Düsseldorf',
      '4': 'Bauaufsichtsbehörde Dortmund',
      '5': 'Bauaufsichtsbehörde Frankfurt',
      '6': 'Bauaufsichtsbehörde Stuttgart',
      '7': 'Bauaufsichtsbehörde München',
      '8': 'Bauaufsichtsbehörde Nürnberg',
      '9': 'Bauaufsichtsbehörde Dresden'
    }
  };

  useEffect(() => {
    // Leaflet dynamisch laden
    if (typeof window !== 'undefined' && !L.current) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(link);

      const script = document.createElement('script');
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.onload = () => {
        L.current = window.L;
        initMap();
      };
      document.body.appendChild(script);
    }
  }, []);

  const initMap = () => {
    if (!L.current || map) return;

    const newMap = L.current.map(mapRef.current).setView([51.1657, 10.4515], 6);
    
    L.current.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors'
    }).addTo(newMap);

    // Click-Handler für Karte
    newMap.on('click', (e) => {
      handleMapClick(e.latlng);
    });

    setMap(newMap);
  };

  useEffect(() => {
    if (map && L.current) {
      updateLayers();
    }
  }, [map, activeLayer]);

  const updateLayers = () => {
    if (!map || !L.current) return;

    // Entferne alte Layer
    if (snowLayerRef.current) {
      map.removeLayer(snowLayerRef.current);
    }
    if (windLayerRef.current) {
      map.removeLayer(windLayerRef.current);
    }

    // Vereinfachte Zonendarstellung als Rechtecke
    const bounds = [
      [[47.27, 5.87], [55.06, 15.04]] // Deutschland ungefähr
    ];

    if (activeLayer === 'snow' || activeLayer === 'both') {
      const snowZones = createZonePolygons('snow');
      snowLayerRef.current = L.current.geoJSON(snowZones, {
        style: (feature) => ({
          fillColor: feature.properties.color,
          fillOpacity: 0.4,
          color: '#000',
          weight: 1
        })
      }).addTo(map);
    }

    if (activeLayer === 'wind' || activeLayer === 'both') {
      const windZones = createZonePolygons('wind');
      windLayerRef.current = L.current.geoJSON(windZones, {
        style: (feature) => ({
          fillColor: feature.properties.color,
          fillOpacity: activeLayer === 'both' ? 0.3 : 0.4,
          color: '#000',
          weight: 1,
          dashArray: '5, 5'
        })
      }).addTo(map);
    }
  };

  const createZonePolygons = (type) => {
    // Vereinfachte Zonen - in der Realität müssen echte GeoJSON-Daten verwendet werden
    return {
      type: 'FeatureCollection',
      features: [
        {
          type: 'Feature',
          properties: {
            zone: type === 'snow' ? '1' : '1',
            value: type === 'snow' ? '0,65 kN/m²' : '22,5 m/s',
            color: type === 'snow' ? '#e8f5e9' : '#e3f2fd'
          },
          geometry: {
            type: 'Polygon',
            coordinates: [[[5.87, 47.27], [15.04, 47.27], [15.04, 50.5], [5.87, 50.5], [5.87, 47.27]]]
          }
        },
        {
          type: 'Feature',
          properties: {
            zone: type === 'snow' ? '2' : '2',
            value: type === 'snow' ? '1,00 kN/m²' : '25,0 m/s',
            color: type === 'snow' ? '#a5d6a7' : '#bbdefb'
          },
          geometry: {
            type: 'Polygon',
            coordinates: [[[5.87, 50.5], [15.04, 50.5], [15.04, 52.5], [5.87, 52.5], [5.87, 50.5]]]
          }
        },
        {
          type: 'Feature',
          properties: {
            zone: type === 'snow' ? '3' : '3',
            value: type === 'snow' ? '1,85 kN/m²' : '27,5 m/s',
            color: type === 'snow' ? '#66bb6a' : '#90caf9'
          },
          geometry: {
            type: 'Polygon',
            coordinates: [[[5.87, 52.5], [15.04, 52.5], [15.04, 55.06], [5.87, 55.06], [5.87, 52.5]]]
          }
        }
      ]
    };
  };

  const handleMapClick = (latlng) => {
    if (!map || !L.current) return;

    // Entferne alten Marker
    if (marker) {
      map.removeLayer(marker);
    }

    // Setze neuen Marker
    const newMarker = L.current.marker([latlng.lat, latlng.lng]).addTo(map);
    setMarker(newMarker);

    // Simuliere Ergebnis basierend auf Position
    const simulatedPLZ = Math.floor(Math.random() * 10).toString();
    const snowData = zoneData.snow[simulatedPLZ];
    const windData = zoneData.wind[simulatedPLZ];
    const authority = zoneData.authorities[simulatedPLZ];

    setResult({
      plz: `${simulatedPLZ}XXXX`,
      schneelast: `Zone ${snowData.zone}: ${snowData.value}`,
      windlast: `Zone ${windData.zone}: ${windData.value}`,
      amt: authority
    });
  };

  const handlePLZSearch = async () => {
    if (!plz || plz.length < 5) {
      alert('Bitte eine gültige 5-stellige PLZ eingeben');
      return;
    }

    // PLZ Geocoding via Nominatim
    try {
      const response = await fetch(
        `https://nominatim.openstreetmap.org/search?postalcode=${plz}&country=Germany&format=json&limit=1`
      );
      const data = await response.json();

      if (data && data.length > 0) {
        const { lat, lon } = data[0];
        map.setView([parseFloat(lat), parseFloat(lon)], 10);
        handleMapClick({ lat: parseFloat(lat), lng: parseFloat(lon) });
      } else {
        alert('PLZ nicht gefunden');
      }
    } catch (error) {
      alert('Fehler bei der PLZ-Suche');
    }
  };

  return (
    <div className="flex h-screen bg-gray-50">
      {/* Karte */}
      <div className="flex-1 relative">
        <div ref={mapRef} className="w-full h-full" />
        
        {/* PLZ-Suche Overlay */}
        <div className="absolute top-4 left-4 bg-white rounded-lg shadow-lg p-4 z-[1000]">
          <div className="flex gap-2">
            <input
              type="text"
              placeholder="PLZ eingeben"
              value={plz}
              onChange={(e) => setPlz(e.target.value)}
              onKeyPress={(e) => e.key === 'Enter' && handlePLZSearch()}
              className="px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
              maxLength="5"
            />
            <button
              onClick={handlePLZSearch}
              className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 flex items-center gap-2"
            >
              <Search size={18} />
              Suchen
            </button>
          </div>
          <p className="text-xs text-gray-500 mt-2">
            <MapPin size={12} className="inline" /> Oder klicken Sie in die Karte
          </p>
        </div>

        {/* Layer-Umschaltung */}
        <div className="absolute top-4 right-80 bg-white rounded-lg shadow-lg p-4 z-[1000]">
          <div className="text-sm font-semibold mb-2">Ansicht</div>
          <div className="flex flex-col gap-2">
            <label className="flex items-center gap-2 cursor-pointer">
              <input
                type="radio"
                name="layer"
                value="snow"
                checked={activeLayer === 'snow'}
                onChange={(e) => setActiveLayer(e.target.value)}
                className="cursor-pointer"
              />
              <span className="text-sm">Schneelast</span>
            </label>
            <label className="flex items-center gap-2 cursor-pointer">
              <input
                type="radio"
                name="layer"
                value="wind"
                checked={activeLayer === 'wind'}
                onChange={(e) => setActiveLayer(e.target.value)}
                className="cursor-pointer"
              />
              <span className="text-sm">Windlast</span>
            </label>
            <label className="flex items-center gap-2 cursor-pointer">
              <input
                type="radio"
                name="layer"
                value="both"
                checked={activeLayer === 'both'}
                onChange={(e) => setActiveLayer(e.target.value)}
                className="cursor-pointer"
              />
              <span className="text-sm">Beide</span>
            </label>
          </div>

          {/* Legende */}
          <div className="mt-4 pt-4 border-t">
            <div className="text-xs font-semibold mb-2">Legende</div>
            {activeLayer !== 'wind' && (
              <div className="mb-2">
                <div className="text-xs font-medium mb-1">Schneelast:</div>
                <div className="flex items-center gap-2 text-xs">
                  <div className="w-4 h-4" style={{backgroundColor: '#e8f5e9'}}></div>
                  <span>Zone 1 (0,65)</span>
                </div>
                <div className="flex items-center gap-2 text-xs">
                  <div className="w-4 h-4" style={{backgroundColor: '#a5d6a7'}}></div>
                  <span>Zone 2 (1,00)</span>
                </div>
                <div className="flex items-center gap-2 text-xs">
                  <div className="w-4 h-4" style={{backgroundColor: '#66bb6a'}}></div>
                  <span>Zone 3 (1,85)</span>
                </div>
              </div>
            )}
            {activeLayer !== 'snow' && (
              <div>
                <div className="text-xs font-medium mb-1">Windlast:</div>
                <div className="flex items-center gap-2 text-xs">
                  <div className="w-4 h-4" style={{backgroundColor: '#e3f2fd', border: '1px dashed #000'}}></div>
                  <span>Zone 1 (22,5 m/s)</span>
                </div>
                <div className="flex items-center gap-2 text-xs">
                  <div className="w-4 h-4" style={{backgroundColor: '#bbdefb', border: '1px dashed #000'}}></div>
                  <span>Zone 2 (25,0 m/s)</span>
                </div>
                <div className="flex items-center gap-2 text-xs">
                  <div className="w-4 h-4" style={{backgroundColor: '#90caf9', border: '1px dashed #000'}}></div>
                  <span>Zone 3 (27,5 m/s)</span>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>

      {/* Sidebar mit Ergebnissen */}
      <div className="w-80 bg-white shadow-lg p-6 overflow-y-auto">
        <h1 className="text-2xl font-bold mb-4 text-gray-800">
          Schnee- & Windlast
        </h1>

        {result ? (
          <div className="space-y-4">
            <div className="bg-blue-50 p-4 rounded-lg">
              <div className="text-sm text-gray-600 mb-1">Standort</div>
              <div className="font-semibold">PLZ: {result.plz}</div>
            </div>

            <div className="bg-green-50 p-4 rounded-lg">
              <div className="text-sm text-gray-600 mb-1">Schneelast</div>
              <div className="font-semibold">{result.schneelast}</div>
              <div className="text-xs text-gray-500 mt-1">
                nach DIN EN 1991-1-3
              </div>
            </div>

            <div className="bg-sky-50 p-4 rounded-lg">
              <div className="text-sm text-gray-600 mb-1">Windlast</div>
              <div className="font-semibold">{result.windlast}</div>
              <div className="text-xs text-gray-500 mt-1">
                nach DIN EN 1991-1-4
              </div>
            </div>

            <div className="bg-amber-50 p-4 rounded-lg">
              <div className="text-sm text-gray-600 mb-1">Zuständige Behörde</div>
              <div className="font-semibold text-sm">{result.amt}</div>
            </div>
          </div>
        ) : (
          <div className="text-center py-12 text-gray-500">
            <MapPin size={48} className="mx-auto mb-4 opacity-50" />
            <p>Geben Sie eine PLZ ein oder klicken Sie in die Karte</p>
          </div>
        )}

        {/* Haftungsausschluss */}
        <div className="mt-8 p-4 bg-red-50 border border-red-200 rounded-lg">
          <div className="flex gap-2 items-start">
            <AlertCircle className="text-red-600 flex-shrink-0 mt-0.5" size={20} />
            <div>
              <div className="font-semibold text-red-800 text-sm mb-1">
                Haftungsausschluss
              </div>
              <p className="text-xs text-red-700 leading-relaxed">
                Alle Angaben sind ohne Gewähr und dienen nur zur groben Orientierung. 
                Für verbindliche Auskünfte wenden Sie sich bitte an die zuständige 
                Bauaufsichtsbehörde. Die tatsächlichen Werte können je nach genauer 
                Lage und örtlichen Gegebenheiten abweichen.
              </p>
            </div>
          </div>
        </div>

        <div className="mt-6 text-xs text-gray-500 space-y-1">
          <p>• Schneelastzonen nach DIN EN 1991-1-3/NA</p>
          <p>• Windlastzonen nach DIN EN 1991-1-4/NA</p>
          <p>• Daten vereinfacht dargestellt</p>
        </div>
      </div>
    </div>
  );
};

export default LastzonenKarte;
