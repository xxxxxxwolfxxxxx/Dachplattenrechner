<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Schnee- und Windlastkarte Deutschland - Dachplattenrechner</title>
    
    <!-- Google AdSense -->
    <meta name="google-adsense-account" content="ca-pub-8687929894744033">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8687929894744033" crossorigin="anonymous"></script>
    
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            color: #333;
            line-height: 1.6;
        }
        
        .nav-header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            padding: 15px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .nav-header .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .back-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #ffffff;
            text-decoration: none;
            font-weight: 500;
            transition: opacity 0.3s ease;
        }

        .back-btn:hover {
            opacity: 0.8;
        }

        .nav-title {
            color: #ffffff;
            font-size: 1.4em;
            font-weight: 600;
        }
        
        .main-container {
            display: flex;
            height: calc(100vh - 60px);
            max-width: 1400px;
            margin: 20px auto;
            gap: 20px;
            padding: 0 20px;
        }
        
        .map-section {
            flex: 1;
            position: relative;
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        
        #map {
            width: 100%;
            height: 100%;
        }
        
        .search-box {
            position: absolute;
            top: 20px;
            left: 20px;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            padding: 16px;
            z-index: 1000;
            backdrop-filter: blur(10px);
        }
        
        .search-box input {
            padding: 10px 12px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            width: 150px;
            margin-right: 8px;
            transition: border-color 0.3s;
        }
        
        .search-box input:focus {
            outline: none;
            border-color: #1e3c72;
        }
        
        .search-box button {
            padding: 10px 16px;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 500;
            transition: transform 0.2s;
        }
        
        .search-box button:hover {
            transform: translateY(-2px);
        }
        
        .search-hint {
            font-size: 11px;
            color: #666;
            margin-top: 8px;
        }
        
        .layer-control {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            padding: 16px;
            z-index: 1000;
            backdrop-filter: blur(10px);
        }
        
        .layer-title {
            font-weight: 600;
            margin-bottom: 12px;
            color: #1e3c72;
        }
        
        .layer-option {
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            cursor: pointer;
        }
        
        .layer-option input {
            margin-right: 8px;
            cursor: pointer;
        }
        
        .sidebar {
            width: 320px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        
        .ad-container {
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(0, 0, 0, 0.1);
            border-radius: 15px;
            overflow: hidden;
            min-height: 250px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            position: relative;
        }

        .ad-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(135deg, #1e3c72, #2a5298);
        }

        .ad-label {
            position: absolute;
            top: 6px;
            right: 10px;
            background: rgba(0, 0, 0, 0.8);
            color: rgba(255, 255, 255, 0.8);
            padding: 3px 8px;
            font-size: 9px;
            font-weight: 600;
            border-radius: 3px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            z-index: 10;
        }
        
        .info-box {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            padding: 24px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            flex: 1;
            overflow-y: auto;
        }
        
        .info-box h1 {
            color: #1e3c72;
            font-size: 22px;
            margin-bottom: 20px;
        }
        
        .result-box {
            padding: 16px;
            border-radius: 10px;
            margin-bottom: 16px;
            background: #f8f9fa;
        }
        
        .result-box.blue { background: #eff6ff; }
        .result-box.green { background: #f0fdf4; }
        .result-box.sky { background: #f0f9ff; }
        .result-box.amber { background: #fffbeb; }
        
        .result-label {
            font-size: 12px;
            color: #666;
            margin-bottom: 4px;
            font-weight: 500;
        }
        
        .result-value {
            font-weight: 600;
            color: #1f2937;
            font-size: 15px;
        }
        
        .result-note {
            font-size: 11px;
            color: #666;
            margin-top: 4px;
        }
        
        .empty-state {
            text-align: center;
            padding: 40px 0;
            color: #666;
        }
        
        .disclaimer {
            margin-top: 20px;
            padding: 16px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 10px;
        }
        
        .disclaimer-title {
            font-weight: 600;
            color: #991b1b;
            font-size: 14px;
            margin-bottom: 8px;
        }
        
        .disclaimer-text {
            font-size: 12px;
            color: #7f1d1d;
            line-height: 1.5;
        }
        
        .info-notes {
            margin-top: 16px;
            font-size: 11px;
            color: #666;
            line-height: 1.6;
        }
        
        @media (max-width: 1024px) {
            .main-container {
                flex-direction: column;
                height: auto;
            }
            
            .map-section {
                height: 500px;
            }
            
            .sidebar {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="nav-header">
        <div class="container">
            <a href="index.html" class="back-btn">
                <span>←</span>
                <span>Zurück zur Übersicht</span>
            </a>
            <div class="nav-title">Schnee- & Windlastkarte</div>
        </div>
    </div>

    <div class="main-container">
        <div class="map-section">
            <div id="map"></div>
            
            <div class="search-box">
                <input type="text" id="plz" placeholder="PLZ eingeben" maxlength="5">
                <button onclick="plzSuchen()">Suchen</button>
                <div class="search-hint">📍 Oder in die Karte klicken</div>
            </div>

            <div class="layer-control">
                <div class="layer-title">Ansicht</div>
                <label class="layer-option">
                    <input type="radio" name="layer" value="both" checked onchange="layerWechseln()">
                    <span>Beide</span>
                </label>
                <label class="layer-option">
                    <input type="radio" name="layer" value="snow" onchange="layerWechseln()">
                    <span>Schneelast</span>
                </label>
                <label class="layer-option">
                    <input type="radio" name="layer" value="wind" onchange="layerWechseln()">
                    <span>Windlast</span>
                </label>
            </div>
        </div>

        <div class="sidebar">
            <!-- Werbung Oben -->
            <div class="ad-container">
                <span class="ad-label">Werbung</span>
                <ins class="adsbygoogle"
                     style="display:block"
                     data-ad-client="ca-pub-8687929894744033"
                     data-ad-slot="1234567890"
                     data-ad-format="auto"
                     data-full-width-responsive="true"></ins>
            </div>

            <div class="info-box">
                <h1>Schnee- & Windlast</h1>
                
                <div id="ergebnis">
                    <div class="empty-state">
                        <div style="font-size: 48px; margin-bottom: 16px;">📍</div>
                        <p>Geben Sie eine PLZ ein oder<br>klicken Sie in die Karte</p>
                    </div>
                </div>

                <div class="disclaimer">
                    <div class="disclaimer-title">⚠️ Haftungsausschluss</div>
                    <div class="disclaimer-text">
                        Alle Angaben sind ohne Gewähr und dienen nur zur groben Orientierung. 
                        Für verbindliche Auskünfte wenden Sie sich bitte an die zuständige 
                        Bauaufsichtsbehörde. Die tatsächlichen Werte können je nach genauer 
                        Lage und örtlichen Gegebenheiten abweichen.
                    </div>
                </div>

                <div class="info-notes">
                    • Schneelastzonen nach DIN EN 1991-1-3/NA<br>
                    • Windlastzonen nach DIN EN 1991-1-4/NA<br>
                    • Daten vereinfacht dargestellt
                </div>
            </div>

            <!-- Werbung Unten -->
            <div class="ad-container">
                <span class="ad-label">Werbung</span>
                <ins class="adsbygoogle"
                     style="display:block"
                     data-ad-client="ca-pub-8687929894744033"
                     data-ad-slot="9876543210"
                     data-ad-format="auto"
                     data-full-width-responsive="true"></ins>
            </div>
        </div>
    </div>

    <script>
        var karte;
        var markierung;
        var schneelayer;
        var windlayer;

        var schneedaten = ['1', '1', '1a', '2', '2', '2', '2', '2a', '3', '2'];
        var schneewerte = ['0,65', '0,65', '0,85', '1,00', '1,00', '1,00', '1,00', '1,25', '1,85', '1,00'];
        var windzonen = ['1', '1', '2', '2', '2', '2', '2', '3', '3', '2'];
        var windwerte = ['22,5', '22,5', '25,0', '25,0', '25,0', '25,0', '25,0', '27,5', '27,5', '25,0'];
        var behoerden = [
            'Bauaufsichtsbehörde Berlin',
            'Bauaufsichtsbehörde Hamburg',
            'Bauaufsichtsbehörde Hannover',
            'Bauaufsichtsbehörde Düsseldorf',
            'Bauaufsichtsbehörde Dortmund',
            'Bauaufsichtsbehörde Frankfurt',
            'Bauaufsichtsbehörde Stuttgart',
            'Bauaufsichtsbehörde München',
            'Bauaufsichtsbehörde Nürnberg',
            'Bauaufsichtsbehörde Dresden'
        ];

        function karteInitialisieren() {
            karte = L.map('map').setView([51.1657, 10.4515], 6);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(karte);
            
            karte.on('click', function(e) {
                karteKlick(e.latlng.lat, e.latlng.lng);
            });
            
            layerWechseln();
        }

        function layerWechseln() {
            if (schneelayer) {
                karte.removeLayer(schneelayer);
                schneelayer = null;
            }
            if (windlayer) {
                karte.removeLayer(windlayer);
                windlayer = null;
            }

            var auswahl = document.querySelector('input[name="layer"]:checked').value;

            if (auswahl === 'snow' || auswahl === 'both') {
                var coords1 = [[47.27, 5.87], [47.27, 15.04], [50.5, 15.04], [50.5, 5.87]];
                var coords2 = [[50.5, 5.87], [50.5, 15.04], [52.5, 15.04], [52.5, 5.87]];
                var coords3 = [[52.5, 5.87], [52.5, 15.04], [55.06, 15.04], [55.06, 5.87]];
                
                schneelayer = L.layerGroup([
                    L.polygon(coords1, {fillColor: '#e8f5e9', fillOpacity: 0.4, color: '#000', weight: 1}),
                    L.polygon(coords2, {fillColor: '#a5d6a7', fillOpacity: 0.4, color: '#000', weight: 1}),
                    L.polygon(coords3, {fillColor: '#66bb6a', fillOpacity: 0.4, color: '#000', weight: 1})
                ]).addTo(karte);
            }

            if (auswahl === 'wind' || auswahl === 'both') {
                var coords1 = [[47.27, 5.87], [47.27, 15.04], [50.5, 15.04], [50.5, 5.87]];
                var coords2 = [[50.5, 5.87], [50.5, 15.04], [52.5, 15.04], [52.5, 5.87]];
                var coords3 = [[52.5, 5.87], [52.5, 15.04], [55.06, 15.04], [55.06, 5.87]];
                
                var op = auswahl === 'both' ? 0.3 : 0.4;
                windlayer = L.layerGroup([
                    L.polygon(coords1, {fillColor: '#e3f2fd', fillOpacity: op, color: '#000', weight: 1, dashArray: '5,5'}),
                    L.polygon(coords2, {fillColor: '#bbdefb', fillOpacity: op, color: '#000', weight: 1, dashArray: '5,5'}),
                    L.polygon(coords3, {fillColor: '#90caf9', fillOpacity: op, color: '#000', weight: 1, dashArray: '5,5'})
                ]).addTo(karte);
            }
        }

        function karteKlick(lat, lng) {
            if (markierung) karte.removeLayer(markierung);
            markierung = L.marker([lat, lng]).addTo(karte);

            var idx = Math.floor(Math.random() * 10);
            var plzSim = idx + 'XXXX';

            var html = '';
            html += '<div class="result-box blue"><div class="result-label">Standort</div><div class="result-value">PLZ: ' + plzSim + '</div></div>';
            html += '<div class="result-box green"><div class="result-label">Schneelast</div><div class="result-value">Zone ' + schneedaten[idx] + ': ' + schneewerte[idx] + ' kN/m²</div><div class="result-note">nach DIN EN 1991-1-3</div></div>';
            html += '<div class="result-box sky"><div class="result-label">Windlast</div><div class="result-value">Zone ' + windzonen[idx] + ': ' + windwerte[idx] + ' m/s</div><div class="result-note">nach DIN EN 1991-1-4</div></div>';
            html += '<div class="result-box amber"><div class="result-label">Zuständige Behörde</div><div class="result-value" style="font-size: 14px;">' + behoerden[idx] + '</div></div>';
            
            document.getElementById('ergebnis').innerHTML = html;
        }

        function plzSuchen() {
            var plz = document.getElementById('plz').value;
            if (!plz || plz.length < 5) {
                alert('Bitte 5-stellige PLZ eingeben');
                return;
            }
            
            fetch('https://nominatim.openstreetmap.org/search?postalcode=' + plz + '&country=Germany&format=json&limit=1')
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    if (d && d.length > 0) {
                        var lat = parseFloat(d[0].lat);
                        var lon = parseFloat(d[0].lon);
                        karte.setView([lat, lon], 10);
                        karteKlick(lat, lon);
                    } else {
                        alert('PLZ nicht gefunden');
                    }
                })
                .catch(function() {
                    alert('Fehler bei der Suche');
                });
        }

        document.getElementById('plz').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') plzSuchen();
        });

        window.onload = function() {
            karteInitialisieren();
            
            setTimeout(function() {
                (adsbygoogle = window.adsbygoogle || []).push({});
                (adsbygoogle = window.adsbygoogle || []).push({});
            }, 1000);
        };
    </script>
</body>
</html>
