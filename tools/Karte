<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Schnee- und Windlastkarte Deutschland</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        const LastzonenKarte = () => {
            const [map, setMap] = useState(null);
            const [marker, setMarker] = useState(null);
            const [plz, setPlz] = useState('');
            const [result, setResult] = useState(null);
            const [activeLayer, setActiveLayer] = useState('both');
            const mapRef = useRef(null);
            const snowLayerRef = useRef(null);
            const windLayerRef = useRef(null);

            const zoneData = {
                snow: {
                    '0': { zone: '1', value: '0,65 kN/m²', color: '#e8f5e9' },
                    '1': { zone: '1', value: '0,65 kN/m²', color: '#e8f5e9' },
                    '2': { zone: '1a', value: '0,85 kN/m²', color: '#c8e6c9' },
                    '3': { zone: '2', value: '1,00 kN/m²', color: '#a5d6a7' },
                    '4': { zone: '2', value: '1,00 kN/m²', color: '#a5d6a7' },
                    '5': { zone: '2', value: '1,00 kN/m²', color: '#a5d6a7' },
                    '6': { zone: '2', value: '1,00 kN/m²', color: '#a5d6a7' },
                    '7': { zone: '2a', value: '1,25 kN/m²', color: '#81c784' },
                    '8': { zone: '3', value: '1,85 kN/m²', color: '#66bb6a' },
                    '9': { zone: '2', value: '1,00 kN/m²', color: '#a5d6a7' }
                },
                wind: {
                    '0': { zone: '1', value: '22,5 m/s', color: '#e3f2fd' },
                    '1': { zone: '1', value: '22,5 m/s', color: '#e3f2fd' },
                    '2': { zone: '2', value: '25,0 m/s', color: '#bbdefb' },
                    '3': { zone: '2', value: '25,0 m/s', color: '#bbdefb' },
                    '4': { zone: '2', value: '25,0 m/s', color: '#bbdefb' },
                    '5': { zone: '2', value: '25,0 m/s', color: '#bbdefb' },
                    '6': { zone: '2', value: '25,0 m/s', color: '#bbdefb' },
                    '7': { zone: '3', value: '27,5 m/s', color: '#90caf9' },
                    '8': { zone: '3', value: '27,5 m/s', color: '#90caf9' },
                    '9': { zone: '2', value: '25,0 m/s', color: '#bbdefb' }
                },
                authorities: {
                    '0': 'Bauaufsichtsbehörde Berlin',
                    '1': 'Bauaufsichtsbehörde Hamburg',
                    '2': 'Bauaufsichtsbehörde Hannover',
                    '3': 'Bauaufsichtsbehörde Düsseldorf',
                    '4': 'Bauaufsichtsbehörde Dortmund',
                    '5': 'Bauaufsichtsbehörde Frankfurt',
                    '6': 'Bauaufsichtsbehörde Stuttgart',
                    '7': 'Bauaufsichtsbehörde München',
                    '8': 'Bauaufsichtsbehörde Nürnberg',
                    '9': 'Bauaufsichtsbehörde Dresden'
                }
            };

            useEffect(() => {
                if (!map && mapRef.current) {
                    const newMap = L.map(mapRef.current).setView([51.1657, 10.4515], 6);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '© OpenStreetMap contributors'
                    }).addTo(newMap);
                    newMap.on('click', (e) => handleMapClick(e.latlng));
                    setMap(newMap);
                }
            }, []);

            useEffect(() => {
                if (map) updateLayers();
            }, [map, activeLayer]);

            const updateLayers = () => {
                if (!map) return;
                if (snowLayerRef.current) map.removeLayer(snowLayerRef.current);
                if (windLayerRef.current) map.removeLayer(windLayerRef.current);

                if (activeLayer === 'snow' || activeLayer === 'both') {
                    snowLayerRef.current = L.geoJSON(createZonePolygons('snow'), {
                        style: (feature) => ({
                            fillColor: feature.properties.color,
                            fillOpacity: 0.4,
                            color: '#000',
                            weight: 1
                        })
                    }).addTo(map);
                }

                if (activeLayer === 'wind' || activeLayer === 'both') {
                    windLayerRef.current = L.geoJSON(createZonePolygons('wind'), {
                        style: (feature) => ({
                            fillColor: feature.properties.color,
                            fillOpacity: activeLayer === 'both' ? 0.3 : 0.4,
                            color: '#000',
                            weight: 1,
                            dashArray: '5, 5'
                        })
                    }).addTo(map);
                }
            };

            const createZonePolygons = (type) => ({
                type: 'FeatureCollection',
                features: [
                    { type: 'Feature', properties: { color: type === 'snow' ? '#e8f5e9' : '#e3f2fd' },
                      geometry: { type: 'Polygon', coordinates: [[[5.87, 47.27], [15.04, 47.27], [15.04, 50.5], [5.87, 50.5], [5.87, 47.27]]] }},
                    { type: 'Feature', properties: { color: type === 'snow' ? '#a5d6a7' : '#bbdefb' },
                      geometry: { type: 'Polygon', coordinates: [[[5.87, 50.5], [15.04, 50.5], [15.04, 52.5], [5.87, 52.5], [5.87, 50.5]]] }},
                    { type: 'Feature', properties: { color: type === 'snow' ? '#66bb6a' : '#90caf9' },
                      geometry: { type: 'Polygon', coordinates: [[[5.87, 52.5], [15.04, 52.5], [15.04, 55.06], [5.87, 55.06], [5.87, 52.5]]] }}
                ]
            });

            const handleMapClick = (latlng) => {
                if (marker) map.removeLayer(marker);
                const newMarker = L.marker([latlng.lat, latlng.lng]).addTo(map);
                setMarker(newMarker);

                const simulatedPLZ = Math.floor(Math.random() * 10).toString();
                setResult({
                    plz: simulatedPLZ + 'XXXX',
                    schneelast: `Zone ${zoneData.snow[simulatedPLZ].zone}: ${zoneData.snow[simulatedPLZ].value}`,
                    windlast: `Zone ${zoneData.wind[simulatedPLZ].zone}: ${zoneData.wind[simulatedPLZ].value}`,
                    amt: zoneData.authorities[simulatedPLZ]
                });
            };

            const searchPLZ = async () => {
                if (!plz || plz.length < 5) {
                    alert('Bitte eine gültige 5-stellige PLZ eingeben');
                    return;
                }
                try {
                    const response = await fetch(`https://nominatim.openstreetmap.org/search?postalcode=${plz}&country=Germany&format=json&limit=1`);
                    const data = await response.json();
                    if (data && data.length > 0) {
                        const lat = parseFloat(data[0].lat);
                        const lon = parseFloat(data[0].lon);
                        map.setView([lat, lon], 10);
                        handleMapClick({ lat, lng: lon });
                    } else {
                        alert('PLZ nicht gefunden');
                    }
                } catch {
                    alert('Fehler bei der PLZ-Suche');
                }
            };

            return (
                <div style={{display: 'flex', height: '100vh'}}>
                    <div style={{flex: 1, position: 'relative'}}>
                        <div ref={mapRef} style={{width: '100%', height: '100%'}} />
                        <div style={{position: 'absolute', top: 20, left: 20, background: 'white', borderRadius: 8, boxShadow: '0 4px 6px rgba(0,0,0,0.1)', padding: 16, zIndex: 1000}}>
                            <input type="text" placeholder="PLZ eingeben" value={plz} onChange={(e) => setPlz(e.target.value)} onKeyPress={(e) => e.key === 'Enter' && searchPLZ()} style={{padding: '10px 12px', border: '1px solid #d1d5db', borderRadius: 6, fontSize: 14, marginRight: 8}} maxLength="5" />
                            <button onClick={searchPLZ} style={{padding: '10px 16px', background: '#2563eb', color: 'white', border: 'none', borderRadius: 6, cursor: 'pointer', fontSize: 14}}>Suchen</button>
                            <p style={{fontSize: 12, color: '#6b7280', marginTop: 8}}>📍 Oder klicken Sie in die Karte</p>
                        </div>
                        <div style={{position: 'absolute', top: 20, right: 340, background: 'white', borderRadius: 8, boxShadow: '0 4px 6px rgba(0,0,0,0.1)', padding: 16, zIndex: 1000}}>
                            <div style={{fontSize: 14, fontWeight: 600, marginBottom: 12}}>Ansicht</div>
                            <label style={{display: 'flex', alignItems: 'center', marginBottom: 8, cursor: 'pointer'}}>
                                <input type="radio" name="layer" checked={activeLayer === 'snow'} onChange={() => setActiveLayer('snow')} style={{marginRight: 8}} />
                                <span style={{fontSize: 14}}>Schneelast</span>
                            </label>
                            <label style={{display: 'flex', alignItems: 'center', marginBottom: 8, cursor: 'pointer'}}>
                                <input type="radio" name="layer" checked={activeLayer === 'wind'} onChange={() => setActiveLayer('wind')} style={{marginRight: 8}} />
                                <span style={{fontSize: 14}}>Windlast</span>
                            </label>
                            <label style={{display: 'flex', alignItems: 'center', marginBottom: 8, cursor: 'pointer'}}>
                                <input type="radio" name="layer" checked={activeLayer === 'both'} onChange={() => setActiveLayer('both')} style={{marginRight: 8}} />
                                <span style={{fontSize: 14}}>Beide</span>
                            </label>
                        </div>
                    </div>
                    <div style={{width: 320, background: 'white', boxShadow: '-4px 0 6px rgba(0,0,0,0.1)', padding: 24, overflowY: 'auto'}}>
                        <h1 style={{fontSize: 24, fontWeight: 700, marginBottom: 24, color: '#1f2937'}}>Schnee- & Windlast</h1>
                        {result ? (
                            <div>
                                <div style={{background: '#eff6ff', padding: 16, borderRadius: 8, marginBottom: 16}}>
                                    <div style={{fontSize: 12, color: '#6b7280', marginBottom: 4}}>Standort</div>
                                    <div style={{fontWeight: 600}}>PLZ: {result.plz}</div>
                                </div>
                                <div style={{background: '#f0fdf4', padding: 16, borderRadius: 8, marginBottom: 16}}>
                                    <div style={{fontSize: 12, color: '#6b7280', marginBottom: 4}}>Schneelast</div>
                                    <div style={{fontWeight: 600}}>{result.schneelast}</div>
                                    <div style={{fontSize: 11, color: '#6b7280', marginTop: 4}}>nach DIN EN 1991-1-3</div>
                                </div>
                                <div style={{background: '#f0f9ff', padding: 16, borderRadius: 8, marginBottom: 16}}>
                                    <div style={{fontSize: 12, color: '#6b7280', marginBottom: 4}}>Windlast</div>
                                    <div style={{fontWeight: 600}}>{result.windlast}</div>
                                    <div style={{fontSize: 11, color: '#6b7280', marginTop: 4}}>nach DIN EN 1991-1-4</div>
                                </div>
                                <div style={{background: '#fffbeb', padding: 16, borderRadius: 8, marginBottom: 16}}>
                                    <div style={{fontSize: 12, color: '#6b7280', marginBottom: 4}}>Zuständige Behörde</div>
                                    <div style={{fontWeight: 600, fontSize: 14}}>{result.amt}</div>
                                </div>
                            </div>
                        ) : (
                            <div style={{textAlign: 'center', padding: '48px 0', color: '#6b7280'}}>
                                <div style={{fontSize: 48, marginBottom: 16}}>📍</div>
                                <p>Geben Sie eine PLZ ein oder klicken Sie in die Karte</p>
                            </div>
                        )}
                        <div style={{marginTop: 32, padding: 16, background: '#fef2f2', border: '1px solid #fecaca', borderRadius: 8}}>
                            <div style={{fontWeight: 600, color: '#991b1b', fontSize: 14, marginBottom: 8}}>⚠️ Haftungsausschluss</div>
                            <div style={{fontSize: 12, color: '#7f1d1d', lineHeight: 1.5}}>
                                Alle Angaben sind ohne Gewähr und dienen nur zur groben Orientierung. 
                                Für verbindliche Auskünfte wenden Sie sich bitte an die zuständige 
                                Bauaufsichtsbehörde. Die tatsächlichen Werte können je nach genauer 
                                Lage und örtlichen Gegebenheiten abweichen.
                            </div>
                        </div>
                        <div style={{marginTop: 24, fontSize: 11, color: '#6b7280', lineHeight: 1.6}}>
                            • Schneelastzonen nach DIN EN 1991-1-3/NA<br/>
                            • Windlastzonen nach DIN EN 1991-1-4/NA<br/>
                            • Daten vereinfacht dargestellt
                        </div>
                    </div>
                </div>
            );
        };

        ReactDOM.render(<LastzonenKarte />, document.getElementById('root'));
    </script>
</body>
</html>
